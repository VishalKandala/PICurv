#!/usr/bin/env bash
# Select a commit-scoped certification gate before updating main from this
# checkout. Runtime-relevant changes always run the complete PETSc/MPI gate;
# documentation-only changes can use a recent full-certificate ancestor plus
# a fresh structural certification for the pushed commit.

set -euo pipefail

zero_oid='0000000000000000000000000000000000000000'
main_update=false
main_oid=''
main_remote_oid=''
max_full_age_days="${PICURV_FULL_CERT_MAX_AGE_DAYS:-3}"

# Git provides one line per ref update on standard input:
# <local ref> <local oid> <remote ref> <remote oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = 'refs/heads/main' ] && [ "$local_oid" != "$zero_oid" ]; then
    main_update=true
    main_oid="$local_oid"
    main_remote_oid="$remote_oid"
  fi
done

if [ "$main_update" = false ]; then
  exit 0
fi

head_oid="$(git rev-parse HEAD)"
if [ "$main_oid" != "$head_oid" ]; then
  echo "Refusing to push to main without validating its exact commit." >&2
  echo "Check out ${main_oid} and run 'make certify-docs', then push again." >&2
  exit 1
fi

# A push is one of two things: an ordinary commit (VERSION unchanged - main moves
# freely between releases), or a declared release (VERSION changed - a deliberate act
# that also gets a `vX.Y.Z` tag, separately, once this push lands). Each has its own,
# different changelog obligation; neither requires the other's.
release_version="$(git show "${main_oid}:VERSION" 2>/dev/null || true)"
release_version="${release_version//$'\n'/}"
if ! [[ "$release_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
  echo "Refusing to push main: VERSION must contain one semantic version." >&2
  exit 1
fi

remote_release_version=''
if [ "$main_remote_oid" != "$zero_oid" ]; then
  remote_release_version="$(git show "${main_remote_oid}:VERSION" 2>/dev/null || true)"
  remote_release_version="${remote_release_version//$'\n'/}"
fi

if [ "$release_version" != "$remote_release_version" ]; then
  # Release cut: docs/CHANGELOG.md must carry this exact version's own dated section,
  # and every pending fragment must have been folded into it - a leftover fragment
  # here means its line silently never made it into the release it describes.
  if ! git show "${main_oid}:docs/CHANGELOG.md" | \
       awk -v version="$release_version" \
         '$1 == "##" && ($2 == version || $2 == "v" version) { found = 1 } END { exit !found }'; then
    echo "Refusing to push main: docs/CHANGELOG.md has no '## ${release_version}' entry." >&2
    echo "VERSION changed, so this push declares a release; give it its own dated section." >&2
    exit 1
  fi
  leftover_fragments="$(git ls-tree -r --name-only "${main_oid}" -- docs/changelog.d \
    | grep -v '/README\.md$' || true)"
  if [ -n "$leftover_fragments" ]; then
    echo "Refusing to push main: docs/changelog.d/ still has fragments this release didn't fold in:" >&2
    echo "$leftover_fragments" | sed 's/^/  /' >&2
    echo "Fold each into the ${release_version} section of docs/CHANGELOG.md, then delete it." >&2
    exit 1
  fi
else
  # Ordinary push: at least one new fragment. There is no exemption for a "trivial"
  # commit judged so by the pusher - if it is genuinely not user-visible, the fragment
  # says that in one line; the alternative is a silent, undocumented judgment call
  # repeated at every push.
  if [ "$main_remote_oid" = "$zero_oid" ]; then
    added_fragments="$(git ls-tree -r --name-only "$main_oid" -- docs/changelog.d \
      | grep -v '/README\.md$' || true)"
  else
    added_fragments="$(git diff --diff-filter=A --name-only "$main_remote_oid" "$main_oid" \
      -- docs/changelog.d | grep -v '/README\.md$' || true)"
  fi
  if [ -z "$added_fragments" ]; then
    echo "Refusing to push main: no new fragment under docs/changelog.d/." >&2
    echo "Add one describing this push's change, per docs/changelog.d/README.md." >&2
    exit 1
  fi
fi

if ! [[ "$max_full_age_days" =~ ^[0-9]+$ ]]; then
  echo "PICURV_FULL_CERT_MAX_AGE_DAYS must be a non-negative integer." >&2
  exit 1
fi

requires_full_certification=false
if [ "$main_remote_oid" = "$zero_oid" ]; then
  requires_full_certification=true
else
  while IFS= read -r -d '' changed_path; do
    # These paths cannot alter the solver/runtime contract. Everything else,
    # including code, headers, configs, examples, tests, and build tooling,
    # requires a new full PETSc/MPI certificate.
    case "$changed_path" in
      *.md|docs/*|.github/guide.md|.github/workflows/*|.githooks/*) ;;
      *) requires_full_certification=true ;;
    esac
  done < <(git diff --name-only -z "$main_remote_oid" "$main_oid")
fi

latest_full_certificate=''
latest_full_certificate_epoch=0
for certificate in logs/documentation-certificate-*.md; do
  [ -f "$certificate" ] || continue
  if ! grep -Fq -- '- PETSc/MPI runtime validation: `make check-full`' "$certificate"; then
    continue
  fi
  certificate_oid="${certificate##*-}"
  certificate_oid="${certificate_oid%.md}"
  if ! git cat-file -e "${certificate_oid}^{commit}" 2>/dev/null; then
    continue
  fi
  if ! git merge-base --is-ancestor "$certificate_oid" "$main_oid"; then
    continue
  fi
  certificate_epoch="$(stat -c %Y "$certificate")"
  if [ "$certificate_epoch" -gt "$latest_full_certificate_epoch" ]; then
    latest_full_certificate="$certificate"
    latest_full_certificate_epoch="$certificate_epoch"
  fi
done

now_epoch="$(date +%s)"
max_full_age_seconds=$((max_full_age_days * 24 * 60 * 60))
if [ -z "$latest_full_certificate" ] || \
   [ $((now_epoch - latest_full_certificate_epoch)) -gt "$max_full_age_seconds" ]; then
  requires_full_certification=true
fi

if [ "$requires_full_certification" = true ]; then
  echo "==> Pre-push: running full documentation and PETSc/MPI certification for ${head_oid}"
  make --no-print-directory certify-docs
else
  echo "==> Pre-push: runtime-relevant files are unchanged; running structural certification for ${head_oid}"
  echo "    Reusing recent full runtime certificate: ${latest_full_certificate}"
  make --no-print-directory certify-docs-fast
fi
