#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""!
@file ic.gen
@brief Generate expression-defined PICurv initial-condition PETSc vectors.
"""

import argparse
import ast
import configparser
import copy
import io
import json
import math
import os
import re
import struct
import sys
import tokenize

import numpy as np


PETSC_VEC_CLASS_ID = 1211214
ALLOWED_FUNCTIONS = {
    "abs": np.abs,
    "cos": np.cos,
    "exp": np.exp,
    "maximum": np.maximum,
    "minimum": np.minimum,
    "sin": np.sin,
    "sqrt": np.sqrt,
    "tan": np.tan,
    "where": np.where,
}
#: Arguments each function takes; the runtime evaluator (`src/ParticleInitialConditions.c`)
#: accepts exactly the same calls.
FUNCTION_ARITY = {"abs": 1, "cos": 1, "exp": 1, "sin": 1, "sqrt": 1, "tan": 1,
                  "maximum": 2, "minimum": 2, "where": 3}
#: Per-particle random draws: evaluated only by the runtime, from a hash of the particle's
#: identity; an optional non-negative integer literal names a stream shared across fields.
RANDOM_FUNCTIONS = ("uniform", "normal")
#: Variables an Eulerian expression may use.
EULERIAN_EXPRESSION_NAMES = frozenset({"x", "y", "z", "xi", "eta", "zeta", "i", "j", "k"})
#: Variables a particle initial-value expression may use: physical coordinates, domain-
#: normalized coordinates, particle identity, and physical time.
PARTICLE_EXPRESSION_NAMES = frozenset({"x", "y", "z", "xn", "yn", "zn", "pid", "t"})
ALLOWED_NAMES = set(ALLOWED_FUNCTIONS) | EULERIAN_EXPRESSION_NAMES | {"pi"}
_DECIMAL_LITERAL = re.compile(r"^(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$")
ALLOWED_AST_NODES = (
    ast.Expression,
    ast.BinOp,
    ast.UnaryOp,
    ast.Call,
    ast.Name,
    ast.Load,
    ast.Constant,
    ast.Add,
    ast.Sub,
    ast.Mult,
    ast.Div,
    ast.Pow,
    ast.Mod,
    ast.Compare,
    ast.Eq,
    ast.NotEq,
    ast.Lt,
    ast.LtE,
    ast.Gt,
    ast.GtE,
    ast.USub,
    ast.UAdd,
    ast.BoolOp,
    ast.And,
    ast.Or,
    ast.Not,
)


def read_picgrid(path: str):
    """!
    @brief Read one canonical PICGRID block.
    @param[in] path PICGRID input path.
    @return Tuple of node dimensions and coordinates shaped `(KM, JM, IM, 3)`.
    """
    with open(path, "r", encoding="utf-8") as fin:
        lines = [line.strip() for line in fin if line.strip() and not line.lstrip().startswith("#")]
    if len(lines) < 3 or lines[0] != "PICGRID":
        raise ValueError("grid must begin with the canonical PICGRID header.")
    if int(lines[1]) != 1:
        raise ValueError("ic.gen currently supports single-block PICGRID files only.")
    dims = tuple(int(value) for value in lines[2].split())
    if len(dims) != 3 or min(dims) < 2:
        raise ValueError(f"invalid PICGRID dimensions {dims}.")
    im, jm, km = dims
    expected = im * jm * km
    if len(lines[3:]) != expected:
        raise ValueError(f"PICGRID coordinate count mismatch: expected {expected}, found {len(lines[3:])}.")
    coords = np.asarray([[float(value) for value in line.split()] for line in lines[3:]], dtype=float)
    if coords.shape != (expected, 3) or not np.all(np.isfinite(coords)):
        raise ValueError("PICGRID coordinates must be finite three-component rows.")
    return dims, coords.reshape((km, jm, im, 3))


def read_config(path: str) -> dict:
    """!
    @brief Read and validate an expression-generator configuration.
    @param[in] path INI configuration path.
    @return Normalized configuration dictionary.
    """
    parser = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=("#", ";"))
    if not parser.read(path):
        raise ValueError(f"configuration file not found: {path}")
    if not parser.sections() or parser.sections()[0].lower() != "expression":
        raise ValueError("the first configuration section must be [expression].")
    section = parser[parser.sections()[0]]
    return {
        "expressions": dict(section.items()),
        "scale": section.getfloat("scale", fallback=1.0),
        "zero_tolerance": section.getfloat("zero_tolerance", fallback=0.0),
        "max_magnitude": section.getfloat("max_magnitude", fallback=None),
    }


def _average_corners(nodes, offsets):
    """!
    @brief Average selected node-corner arrays.
    @param[in] nodes Coordinate array.
    @param[in] offsets List of `(k, j, i)` slice offsets.
    @return Averaged coordinate array.
    """
    km, jm, im, _ = nodes.shape
    result = np.zeros((km - 1, jm - 1, im - 1, 3), dtype=float)
    for dk, dj, di in offsets:
        result += nodes[dk:dk + km - 1, dj:dj + jm - 1, di:di + im - 1, :]
    return result / float(len(offsets))


def compute_full_cell_centers(nodes):
    """!
    @brief Compute physical and linearly extrapolated dummy cell centers.
    @param[in] nodes PICGRID node coordinates.
    @return Full DMDA-shaped cell-center coordinates.
    """
    km, jm, im, _ = nodes.shape
    full = np.zeros((km + 1, jm + 1, im + 1, 3), dtype=float)
    physical = _average_corners(
        nodes,
        [(dk, dj, di) for dk in (0, 1) for dj in (0, 1) for di in (0, 1)],
    )
    full[1:km, 1:jm, 1:im, :] = physical
    for axis, last in ((2, im), (1, jm), (0, km)):
        low = [slice(None)] * 4
        first = [slice(None)] * 4
        second = [slice(None)] * 4
        high = [slice(None)] * 4
        penultimate = [slice(None)] * 4
        antepenultimate = [slice(None)] * 4
        low[axis], first[axis], second[axis] = 0, 1, min(2, last - 1)
        high[axis], penultimate[axis], antepenultimate[axis] = last, last - 1, max(last - 2, 1)
        full[tuple(low)] = 2.0 * full[tuple(first)] - full[tuple(second)]
        full[tuple(high)] = 2.0 * full[tuple(penultimate)] - full[tuple(antepenultimate)]
    return full


def compute_face_centers(nodes):
    """!
    @brief Compute geometrically valid Xi-, Eta-, and Zeta-face centers.
    @param[in] nodes PICGRID node coordinates.
    @return Tuple of face-center arrays in their active storage shapes.
    """
    xi = 0.25 * (
        nodes[:-1, :-1, :, :] + nodes[1:, :-1, :, :]
        + nodes[:-1, 1:, :, :] + nodes[1:, 1:, :, :]
    )
    eta = 0.25 * (
        nodes[:-1, :, :-1, :] + nodes[1:, :, :-1, :]
        + nodes[:-1, :, 1:, :] + nodes[1:, :, 1:, :]
    )
    zeta = 0.25 * (
        nodes[:, :-1, :-1, :] + nodes[:, 1:, :-1, :]
        + nodes[:, :-1, 1:, :] + nodes[:, 1:, 1:, :]
    )
    return xi, eta, zeta


def validate_expression(expression: str, names=EULERIAN_EXPRESSION_NAMES, random=False) -> None:
    """!
    @brief Reject anything outside the expression language the runtime also evaluates.
    @details Python expression syntax restricted to decimal numbers, the given names, `pi`,
             arithmetic, comparisons (chains included), `and`/`or`/`not`, and the
             documented functions at their fixed arities. `uniform(n)`/`normal(n)` are
             accepted only when @p random is true, with an optional stream `n` that must be
             a non-negative integer literal.
    @param[in] expression User expression.
    @param[in] names Variables in scope, besides `pi`.
    @param[in] random Whether per-particle random draws may be called.
    @throws ValueError naming the first construct outside the language.
    """
    if not isinstance(expression, str) or not expression.strip():
        raise ValueError("an expression must be a non-empty string.")
    if "\n" in expression or "\r" in expression:
        raise ValueError("an expression must fit on one line.")
    try:
        tree = ast.parse(expression, mode="eval")
        tokens = list(tokenize.generate_tokens(io.StringIO(expression).readline))
    except (SyntaxError, tokenize.TokenError) as exc:
        raise ValueError(f"expression '{expression}' is not valid syntax: {exc}.") from exc
    for token in tokens:
        if token.type == tokenize.NUMBER and not _DECIMAL_LITERAL.match(token.string):
            raise ValueError(f"'{token.string}' is not a decimal number; write numbers like 1, 0.5, or 2e-3.")
    callees = {id(node.func) for node in ast.walk(tree) if isinstance(node, ast.Call)}
    for node in ast.walk(tree):
        if not isinstance(node, ALLOWED_AST_NODES):
            raise ValueError(f"unsupported expression syntax: {type(node).__name__}.")
        if isinstance(node, ast.Constant) and type(node.value) not in (int, float):
            raise ValueError(f"only numbers may appear as constants, not {node.value!r}.")
        if isinstance(node, ast.Name) and id(node) not in callees and node.id not in set(names) | {"pi"}:
            raise ValueError(f"unsupported expression name '{node.id}'.")
        if isinstance(node, ast.Call):
            name = node.func.id if isinstance(node.func, ast.Name) else None
            if node.keywords:
                raise ValueError("functions take positional arguments only.")
            if name in RANDOM_FUNCTIONS and random:
                if len(node.args) > 1:
                    raise ValueError(f"{name}() takes at most one stream argument.")
                if node.args:
                    stream = node.args[0]
                    if (not isinstance(stream, ast.Constant) or type(stream.value) not in (int, float)
                            or stream.value < 0 or stream.value != int(stream.value)):
                        raise ValueError(f"the stream of {name}() must be a non-negative integer literal.")
                continue
            if name not in FUNCTION_ARITY:
                raise ValueError(f"'{name}' is not an available function.")
            if len(node.args) != FUNCTION_ARITY[name]:
                raise ValueError(f"{name}() takes {FUNCTION_ARITY[name]} argument(s).")


def _validate_expression(expression: str) -> None:
    """!
    @brief Reject Eulerian expression syntax outside the supported language.
    @param[in] expression User expression.
    """
    validate_expression(expression, EULERIAN_EXPRESSION_NAMES, random=False)


class _LogicalRewriter(ast.NodeTransformer):
    """!
    @brief Rewrite logical operators and chained comparisons into array operations.
    @details `and`, `or`, `not` and a chain `a < b < c` have no elementwise meaning for
             arrays, so they become `logical_and`, `logical_or`, `logical_not` calls, the
             same 1-or-0 semantics the runtime evaluator gives them.
    """

    @staticmethod
    def _call(name, args):
        """!
        @brief Build a call to one of the evaluation-only logical helpers.
        @param[in] name Helper name.
        @param[in] args Argument nodes.
        @return Call node.
        """
        return ast.Call(func=ast.Name(id=name, ctx=ast.Load()), args=list(args), keywords=[])

    def visit_BoolOp(self, node):
        """!
        @brief Fold `a and b and c` into nested logical calls.
        @param[in] node BoolOp node.
        @return Rewritten node.
        """
        self.generic_visit(node)
        name = "logical_and" if isinstance(node.op, ast.And) else "logical_or"
        result = node.values[0]
        for value in node.values[1:]:
            result = self._call(name, [result, value])
        return result

    def visit_UnaryOp(self, node):
        """!
        @brief Rewrite `not a` as `logical_not(a)`.
        @param[in] node UnaryOp node.
        @return Rewritten node.
        """
        self.generic_visit(node)
        if isinstance(node.op, ast.Not):
            return self._call("logical_not", [node.operand])
        return node

    def visit_Compare(self, node):
        """!
        @brief Rewrite `a < b < c` as `logical_and(a < b, b < c)`.
        @param[in] node Compare node.
        @return Rewritten node.
        """
        self.generic_visit(node)
        if len(node.ops) == 1:
            return node
        operands = [node.left] + node.comparators
        pairs = [ast.Compare(left=copy.deepcopy(operands[i]), ops=[op], comparators=[copy.deepcopy(operands[i + 1])])
                 for i, op in enumerate(node.ops)]
        result = pairs[0]
        for pair in pairs[1:]:
            result = self._call("logical_and", [result, pair])
        return result


def evaluate_values(expression: str, values: dict):
    """!
    @brief Evaluate an already validated expression over named arrays or scalars.
    @param[in] expression Expression text.
    @param[in] values Mapping of variable name to value or array.
    @return Result as a float array, not yet checked for finiteness.
    """
    tree = ast.fix_missing_locations(_LogicalRewriter().visit(ast.parse(expression, mode="eval")))
    env = dict(ALLOWED_FUNCTIONS)
    env.update({"logical_and": np.logical_and, "logical_or": np.logical_or,
                "logical_not": np.logical_not, "pi": math.pi})
    env.update(values)
    with np.errstate(all="ignore"):
        value = eval(compile(tree, "<ic-expression>", "eval"), {"__builtins__": {}}, env)
    return np.asarray(value, dtype=float)


#: Region shapes a structured field value may paint, later regions over earlier ones.
REGION_SHAPES = ("half_space", "slab", "box", "ball", "cylinder")
#: Profiles of a smoothed region edge, each rising from 0 outside to 1 inside across `width`.
EDGE_PROFILES = {
    "linear": "({s})",
    "smoothstep": "({s})*({s})*(3 - 2*({s}))",
    "cosine": "0.5*(1 - cos(pi*({s})))",
}
_REGION_KEYS = {
    "half_space": {"axis", "at", "side"},
    "slab": {"axis", "from", "to"},
    "box": {"min", "max"},
    "ball": {"center", "radius"},
    "cylinder": {"axis", "center", "radius"},
}
_AXES = ("x", "y", "z")


def _number_text(value, params: dict, where: str) -> str:
    """!
    @brief Render one numeric region parameter, which may name a declared parameter.
    @param[in] value Number, or the name of a parameter.
    @param[in] params Declared parameters.
    @param[in] where Configuration path, for diagnostics.
    @return Parenthesized numeric text.
    """
    if isinstance(value, str) and value in params:
        return repr(float(params[value]))
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
        raise ValueError(f"{where} must be a finite number or a declared parameter name.")
    return repr(float(value))


def _region_distance(region: dict, params: dict, where: str) -> str:
    """!
    @brief Signed distance to a region's boundary, negative inside, as expression text.
    @param[in] region Region mapping.
    @param[in] params Declared parameters.
    @param[in] where Configuration path, for diagnostics.
    @return Expression text for the signed distance.
    """
    shape = region.get("shape")
    if shape not in REGION_SHAPES:
        raise ValueError(f"{where}.shape must be one of {', '.join(REGION_SHAPES)}.")
    extra = set(region) - _REGION_KEYS[shape] - {"shape", "value", "edge"}
    missing = _REGION_KEYS[shape] - set(region) - ({"side"} if shape == "half_space" else set())
    if extra or missing:
        raise ValueError(f"{where} ({shape}) takes {sorted(_REGION_KEYS[shape])}, plus value and edge.")

    def num(key, value=None):
        """!
        @brief Render a region number (a literal or a `params` name) as expression text.
        @param[in] key Region key, for diagnostics and as the default source of the number.
        @param[in] value Number to render in place of `region[key]`, if given.
        @return Expression text of the number.
        """
        return _number_text(region[key] if value is None else value, params, f"{where}.{key}")

    def axis_of(key="axis"):
        """!
        @brief Return the region's axis name, refusing anything but x, y, z.
        @param[in] key Region key holding the axis.
        @return Axis name.
        """
        axis = region.get(key)
        if axis not in _AXES:
            raise ValueError(f"{where}.{key} must be x, y, or z.")
        return axis

    def triple(key):
        """!
        @brief Render a three-coordinate region entry as a list of expression texts.
        @param[in] key Region key holding the three coordinates.
        @return List of three expression texts.
        """
        values = region.get(key)
        if not isinstance(values, list) or len(values) != 3:
            raise ValueError(f"{where}.{key} must be a list of three coordinates.")
        return [num(key, v) for v in values]

    if shape == "half_space":
        axis, side = axis_of(), region.get("side", "above")
        if side not in ("above", "below"):
            raise ValueError(f"{where}.side must be above or below.")
        return f"({num('at')} - {axis})" if side == "above" else f"({axis} - {num('at')})"
    if shape == "slab":
        axis = axis_of()
        return f"maximum({num('from')} - {axis}, {axis} - {num('to')})"
    if shape == "box":
        lower, upper = triple("min"), triple("max")
        terms = [f"maximum({lo} - {a}, {a} - {hi})" for a, lo, hi in zip(_AXES, lower, upper)]
        return f"maximum(maximum({terms[0]}, {terms[1]}), {terms[2]})"
    if shape == "ball":
        center = triple("center")
        return (f"sqrt(({_AXES[0]} - {center[0]})**2 + ({_AXES[1]} - {center[1]})**2 + "
                f"({_AXES[2]} - {center[2]})**2) - {num('radius')}")
    axis = axis_of()
    others = [a for a in _AXES if a != axis]
    center = region.get("center")
    if not isinstance(center, list) or len(center) != 2:
        raise ValueError(f"{where}.center must list the two coordinates across the axis ({', '.join(others)}).")
    c0, c1 = (num("center", v) for v in center)
    return f"sqrt(({others[0]} - {c0})**2 + ({others[1]} - {c1})**2) - {num('radius')}"


def _substitute_params(expression: str, params: dict) -> str:
    """!
    @brief Replace declared parameter names in an expression by their values.
    @param[in] expression Expression text.
    @param[in] params Declared parameters.
    @return Expression text with parameters inlined.
    """
    pieces, cursor = [], 0
    for token in tokenize.generate_tokens(io.StringIO(expression).readline):
        if token.type == tokenize.NAME and token.string in params:
            start, end = token.start[1], token.end[1]
            pieces.append(expression[cursor:start])
            pieces.append(f"({float(params[token.string])!r})")
            cursor = end
    pieces.append(expression[cursor:])
    return "".join(pieces)


def _validate_at(expression: str, names, random: bool, where: str):
    """!
    @brief Validate an expression written in a configuration value, naming where it is.
    @param[in] expression Expression text.
    @param[in] names Variables the expression may use.
    @param[in] random Whether random draws are allowed.
    @param[in] where Configuration path of the value.
    @throws ValueError naming `where` if the expression is outside the language.
    """
    try:
        validate_expression(expression, names, random)
    except ValueError as e:
        raise ValueError(f"{where}: {e}") from None


def lower_value(spec, names=PARTICLE_EXPRESSION_NAMES, random=True, where="value") -> str:
    """!
    @brief Turn a field value - number, expression, or structured regions - into one expression.
    @details A mapping may declare `params` (named numbers usable in its expressions and
             region parameters) and gives either `value` or `background` with `regions`.
             Regions paint in order, a later region over an earlier one: a sharp region by
             `where(d <= 0, v, before)`, a smoothed one by `before*(1 - s) + v*s`, with `d`
             the signed distance to the region and `s` its edge profile over `edge.width`.
             The result is validated like any expression.
    @param[in] spec Number, expression string, or mapping.
    @param[in] names Variables in scope.
    @param[in] random Whether random draws may be called.
    @param[in] where Configuration path, for diagnostics.
    @return Validated expression text.
    """
    params = {}
    if isinstance(spec, bool):
        raise ValueError(f"{where} must be a number, an expression, or a mapping.")
    if isinstance(spec, (int, float)):
        if not math.isfinite(spec):
            raise ValueError(f"{where} must be finite.")
        return repr(float(spec))
    if isinstance(spec, str):
        _validate_at(spec, names, random, where)
        return spec
    if not isinstance(spec, dict):
        raise ValueError(f"{where} must be a number, an expression, or a mapping.")
    unknown = set(spec) - {"params", "value", "background", "regions"}
    if unknown:
        raise ValueError(f"{where} does not take {sorted(unknown)}; it takes params, value, background, regions.")
    params = spec.get("params") or {}
    if not isinstance(params, dict):
        raise ValueError(f"{where}.params must be a mapping of names to numbers.")
    for name, number in params.items():
        reserved = set(names) | {"pi"} | set(FUNCTION_ARITY) | set(RANDOM_FUNCTIONS) | {"and", "or", "not"}
        if not isinstance(name, str) or not name.isidentifier() or name in reserved:
            raise ValueError(f"{where}.params name '{name}' is not a free identifier.")
        _number_text(number, {}, f"{where}.params.{name}")
    scope = set(names) | set(params)

    def expression_of(value, path):
        """!
        @brief Lower one value (number, `params` name, or expression) with parameters inlined.
        @param[in] value Configured value.
        @param[in] path Configuration path, for diagnostics.
        @return Expression text.
        """
        if isinstance(value, str) and value not in params:
            _validate_at(value, scope, random, path)
            return f"({_substitute_params(value, params)})"
        return _number_text(value, params, path)

    if "value" in spec:
        if "background" in spec or "regions" in spec:
            raise ValueError(f"{where} gives either value, or background with regions.")
        lowered = expression_of(spec["value"], f"{where}.value")
    else:
        regions = spec.get("regions")
        if not isinstance(regions, list) or not regions:
            raise ValueError(f"{where}.regions must be a non-empty list.")
        lowered = expression_of(spec.get("background", 0.0), f"{where}.background")
        for index, region in enumerate(regions):
            path = f"{where}.regions[{index}]"
            if not isinstance(region, dict) or "value" not in region:
                raise ValueError(f"{path} must be a mapping with a shape and a value.")
            distance = _region_distance(region, params, path)
            value = expression_of(region["value"], f"{path}.value")
            edge = region.get("edge")
            if edge is None:
                lowered = f"where({distance} <= 0, {value}, {lowered})"
                continue
            if not isinstance(edge, dict) or set(edge) != {"profile", "width"} or edge["profile"] not in EDGE_PROFILES:
                raise ValueError(f"{path}.edge must give profile ({', '.join(EDGE_PROFILES)}) and width.")
            width = _number_text(edge["width"], params, f"{path}.edge.width")
            if float(width) <= 0.0:
                raise ValueError(f"{path}.edge.width must be positive.")
            ramp = f"maximum(0, minimum(1, 0.5 - ({distance})/{width}))"
            blend = EDGE_PROFILES[edge["profile"]].format(s=ramp)
            lowered = f"({lowered})*(1 - {blend}) + {value}*{blend}"
    validate_expression(lowered, names, random)
    return lowered


def evaluate_expression(expression: str, coords, indices, logical):
    """!
    @brief Evaluate one restricted numerical expression over coordinates.
    @param[in] expression Configured expression.
    @param[in] coords Physical-coordinate array.
    @param[in] indices Storage-index arrays.
    @param[in] logical Logical-coordinate arrays.
    @return Finite array matching the coordinate shape.
    """
    _validate_expression(expression)
    value = evaluate_values(expression, {
        "x": coords[..., 0], "y": coords[..., 1], "z": coords[..., 2],
        "i": indices[2], "j": indices[1], "k": indices[0],
        "xi": logical[2], "eta": logical[1], "zeta": logical[0],
    })
    result = np.broadcast_to(value, coords.shape[:-1]).copy()
    if not np.all(np.isfinite(result)):
        raise ValueError(f"expression produced non-finite values: {expression}")
    return result


def _coordinate_context(coords, offsets, logical_shifts, node_dims):
    """!
    @brief Build storage-index and stagger-aware normalized-logical arrays.
    @param[in] coords Physical-coordinate array.
    @param[in] offsets Storage-index offsets in `(k, j, i)` order.
    @param[in] logical_shifts Logical-index shifts in `(k, j, i)` order.
    @param[in] node_dims PICGRID node dimensions `(IM, JM, KM)`.
    @return Tuple `(indices, logical)`.
    """
    grids = np.indices(coords.shape[:-1], dtype=float)
    for axis, offset in enumerate(offsets):
        grids[axis] += offset
    im, jm, km = node_dims
    logical = (
        (grids[0] - logical_shifts[0]) / max(km - 1, 1),
        (grids[1] - logical_shifts[1]) / max(jm - 1, 1),
        (grids[2] - logical_shifts[2]) / max(im - 1, 1),
    )
    return tuple(grids), logical


def _apply_controls(field, config):
    """!
    @brief Apply shared scaling and validation controls.
    @param[in,out] field Generated field.
    @param[in] config Normalized configuration.
    @return Controlled field.
    """
    field *= float(config["scale"])
    tolerance = float(config["zero_tolerance"])
    if tolerance < 0.0:
        raise ValueError("zero_tolerance must be non-negative.")
    field[np.abs(field) < tolerance] = 0.0
    if config["max_magnitude"] is not None:
        limit = float(config["max_magnitude"])
        if limit <= 0.0:
            raise ValueError("max_magnitude must be positive.")
        if float(np.max(np.abs(field))) > limit:
            raise ValueError(f"generated field exceeds max_magnitude={limit}.")
    return field


def generate_ucat(nodes, config):
    """!
    @brief Generate a full Cartesian cell-centered velocity field.
    @param[in] nodes PICGRID coordinates.
    @param[in] config Normalized configuration.
    @return Full DMDA-shaped Ucat array.
    """
    required = ("u", "v", "w")
    missing = [key for key in required if key not in config["expressions"]]
    if missing:
        raise ValueError(f"Ucat expression config is missing {missing}.")
    coords = compute_full_cell_centers(nodes)
    km, jm, im, _ = nodes.shape
    context = _coordinate_context(coords, (0, 0, 0), (0.5, 0.5, 0.5), (im, jm, km))
    field = np.zeros_like(coords)
    for component, key in enumerate(required):
        field[..., component] = evaluate_expression(config["expressions"][key], coords, *context)
    return _apply_controls(field, config)


def generate_ucont(nodes, config):
    """!
    @brief Generate a full staggered contravariant-flux field.
    @param[in] nodes PICGRID coordinates.
    @param[in] config Normalized configuration.
    @return Full DMDA-shaped Ucont array.
    """
    required = ("u_xi", "u_eta", "u_zeta")
    missing = [key for key in required if key not in config["expressions"]]
    if missing:
        raise ValueError(f"Ucont expression config is missing {missing}.")
    km, jm, im, _ = nodes.shape
    field = np.zeros((km + 1, jm + 1, im + 1, 3), dtype=float)
    faces = compute_face_centers(nodes)
    slices = (
        (slice(1, km), slice(1, jm), slice(0, im)),
        (slice(1, km), slice(0, jm), slice(1, im)),
        (slice(0, km), slice(1, jm), slice(1, im)),
    )
    logical_shifts = ((0.5, 0.5, 0.0), (0.5, 0.0, 0.5), (0.0, 0.5, 0.5))
    for component, (key, coords, target, shifts) in enumerate(zip(required, faces, slices, logical_shifts)):
        indices, logical = _coordinate_context(
            coords,
            (target[0].start, target[1].start, target[2].start),
            shifts,
            (im, jm, km),
        )
        field[target + (component,)] = evaluate_expression(
            config["expressions"][key], coords, indices, logical
        )
    return _apply_controls(field, config)


def write_petsc_vec_binary(path: str, field) -> None:
    """!
    @brief Write a big-endian real64 PETSc Vec binary.
    @param[in] path Output path.
    @param[in] field Full field array.
    """
    values = np.asarray(field, dtype=">f8").reshape(-1)
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "wb") as fout:
        fout.write(struct.pack(">ii", PETSC_VEC_CLASS_ID, values.size))
        fout.write(values.tobytes())


def _finite_number(value, path, *, positive=False, nonnegative=False):
    """!
    @brief Parse one finite numerical configuration value.
    @param[in] value Raw value.
    @param[in] path Configuration path for errors.
    @param[in] positive Whether zero and negative values are invalid.
    @param[in] nonnegative Whether negative values are invalid.
    @return Parsed float.
    """
    if isinstance(value, bool):
        raise ValueError(f"{path} must be numeric, not boolean.")
    parsed = float(value)
    valid = np.isfinite(parsed)
    valid = valid and (not positive or parsed > 0.0)
    valid = valid and (not nonnegative or parsed >= 0.0)
    if not valid:
        raise ValueError(f"{path} has an invalid numerical value.")
    return parsed


def validate_spectral_random_velocity_params(raw):
    """!
    @brief Validate the composable spectral random-velocity schema.
    @param[in] raw Raw parameter mapping.
    @return Normalized parameter mapping.
    """
    if not isinstance(raw, dict):
        raise ValueError("spectral_random_velocity params must be a mapping.")
    allowed = {"field", "seed", "random", "spectrum", "projection", "normalization", "remove_mean"}
    unknown = sorted(set(raw) - allowed)
    if unknown:
        raise ValueError(f"spectral_random_velocity has unsupported parameter(s): {unknown}.")
    if str(raw.get("field", "Ucat")).lower() != "ucat":
        raise ValueError("spectral_random_velocity supports only params.field: Ucat.")
    seed = raw.get("seed", 12345)
    if isinstance(seed, bool) or not isinstance(seed, (int, np.integer)):
        raise ValueError("spectral_random_velocity params.seed must be an integer.")

    random_cfg = raw.get("random", {})
    if not isinstance(random_cfg, dict) or set(random_cfg) - {"distribution", "mean"}:
        raise ValueError("params.random supports only distribution and mean.")
    distribution = str(random_cfg.get("distribution", "gaussian")).lower()
    if distribution != "gaussian":
        raise ValueError("params.random.distribution currently supports only 'gaussian'.")
    mean = random_cfg.get("mean", [0.0, 0.0, 0.0])
    if not isinstance(mean, list) or len(mean) != 3:
        raise ValueError("params.random.mean must be a three-component list.")
    mean = [_finite_number(value, f"params.random.mean[{index}]") for index, value in enumerate(mean)]

    spectrum = raw.get("spectrum", {})
    if not isinstance(spectrum, dict):
        raise ValueError("params.spectrum must be a mapping.")
    spectrum_type = str(spectrum.get("type", "white")).lower()
    if spectrum_type == "white":
        if set(spectrum) - {"type"}:
            raise ValueError("white spectrum supports only type.")
        normalized_spectrum = {"type": "white"}
    elif spectrum_type == "k4_exponential":
        if set(spectrum) - {"type", "k0", "k_cut"} or "k0" not in spectrum or "k_cut" not in spectrum:
            raise ValueError("k4_exponential spectrum requires only type, k0, and k_cut.")
        normalized_spectrum = {
            "type": "k4_exponential",
            "k0": _finite_number(spectrum["k0"], "params.spectrum.k0", positive=True),
            "k_cut": _finite_number(spectrum["k_cut"], "params.spectrum.k_cut", positive=True),
        }
    else:
        raise ValueError("params.spectrum.type must be 'white' or 'k4_exponential'.")

    projection = raw.get("projection", {"type": "none"})
    if not isinstance(projection, dict) or set(projection) - {"type", "operator"}:
        raise ValueError("params.projection supports only type and operator.")
    projection_type = str(projection.get("type", "none")).lower()
    if projection_type == "none":
        if "operator" in projection:
            raise ValueError("projection.operator is invalid when projection.type is 'none'.")
        normalized_projection = {"type": "none"}
    elif projection_type == "solenoidal":
        operator = str(projection.get("operator", "")).lower()
        if operator not in {"continuum", "picurv_discrete"}:
            raise ValueError("solenoidal projection.operator must be 'continuum' or 'picurv_discrete'.")
        normalized_projection = {"type": "solenoidal", "operator": operator}
    else:
        raise ValueError("params.projection.type must be 'none' or 'solenoidal'.")

    normalization = raw.get("normalization", {"type": "none"})
    if not isinstance(normalization, dict) or set(normalization) - {"type", "target"}:
        raise ValueError("params.normalization supports only type and target.")
    normalization_type = str(normalization.get("type", "none")).lower()
    if normalization_type == "none":
        if "target" in normalization:
            raise ValueError("normalization.target is invalid when normalization.type is 'none'.")
        normalized_normalization = {"type": "none"}
    elif normalization_type == "component_rms":
        if "target" not in normalization:
            raise ValueError("component_rms normalization requires target.")
        normalized_normalization = {"type": "component_rms",
                                    "target": _finite_number(normalization["target"], "params.normalization.target", positive=True)}
    else:
        raise ValueError("params.normalization.type must be 'none' or 'component_rms'.")
    remove_mean = raw.get("remove_mean", True)
    if not isinstance(remove_mean, bool):
        raise ValueError("params.remove_mean must be boolean.")
    return {"field": "Ucat", "seed": int(seed), "random": {"distribution": distribution, "mean": mean},
            "spectrum": normalized_spectrum, "projection": normalized_projection,
            "normalization": normalized_normalization, "remove_mean": remove_mean}


def validate_spectral_grid(nodes, periodic_axes=(0, 1, 2)):
    """!
    @brief Validate the uniform Cartesian grid required by FFT generation.
    @param[in] nodes PICGRID node-coordinate array.
    @param[in] periodic_axes Cartesian axes that must be uniformly spaced.
    @return Cell counts in storage order and physical lengths in Cartesian order.
    """
    km, jm, im, _ = nodes.shape
    cells = (km - 1, jm - 1, im - 1)
    if min(cells) < 4:
        raise ValueError(f"spectral_random_velocity requires at least four cells per axis; found {cells}.")
    axes = (nodes[0, 0, :, 0], nodes[0, :, 0, 1], nodes[:, 0, 0, 2])
    for axis, (physical_axis, values) in enumerate(zip("xyz", axes)):
        delta = np.diff(values)
        if not np.all(np.isfinite(delta)) or not np.all(delta > 0) or (axis in periodic_axes and not np.allclose(delta, delta[0], rtol=1e-10, atol=1e-12)):
            raise ValueError(f"spectral_random_velocity requires uniform positive {physical_axis} spacing.")
    if not (np.allclose(nodes[..., 0], axes[0][None, None, :]) and
            np.allclose(nodes[..., 1], axes[1][None, :, None]) and
            np.allclose(nodes[..., 2], axes[2][:, None, None])):
        raise ValueError("spectral_random_velocity requires an axis-aligned Cartesian grid (x->i, y->j, z->k).")
    return cells, tuple(float(values[-1] - values[0]) for values in axes)


def spectral_symbols(cells_kji, lengths_xyz):
    """!
    @brief Build continuum and centered-discrete Fourier symbols.
    @param[in] cells_kji Cell counts in storage order.
    @param[in] lengths_xyz Physical box lengths in Cartesian order.
    @return Continuum symbols, centered-discrete symbols, and Cartesian spacings.
    """
    nk, nj, ni = cells_kji
    lx, ly, lz = lengths_xyz
    dx, dy, dz = lx / ni, ly / nj, lz / nk
    kz = 2*np.pi*np.fft.fftfreq(nk, d=dz)[:, None, None]
    ky = 2*np.pi*np.fft.fftfreq(nj, d=dy)[None, :, None]
    kx = 2*np.pi*np.fft.fftfreq(ni, d=dx)[None, None, :]
    return (kx, ky, kz), (np.sin(kx*dx)/dx, np.sin(ky*dy)/dy, np.sin(kz*dz)/dz), (dx, dy, dz)


def project_coefficients(coeff, symbols):
    """!
    @brief Apply one rank-two Fourier-space solenoidal projector.
    @param[in] coeff Vector-valued Fourier coefficients.
    @param[in] symbols Selected divergence-operator symbols.
    @return Projected Fourier coefficients.
    """
    magnitude2 = sum(symbol*symbol for symbol in symbols)
    dot = sum(symbols[c]*coeff[..., c] for c in range(3))
    projected = coeff.copy()
    denominator = np.where(magnitude2 > 0.0, magnitude2, 1.0)
    for component, symbol in enumerate(symbols):
        projected[..., component] -= symbol*dot/denominator
    projected[magnitude2 == 0.0, :] = 0.0
    return projected


def spectral_envelope(kmag, spectrum, fundamental):
    """!
    @brief Compute a modal envelope from the requested finite-grid shell energy.
    @param[in] kmag Physical wavevector magnitudes.
    @param[in] spectrum Normalized spectrum selector.
    @param[in] fundamental Shell width in physical wavenumber units.
    @return Modal amplitude envelope.
    """
    if spectrum["type"] == "white":
        return np.ones_like(kmag)
    shell = np.floor(kmag/fundamental + 0.5).astype(int)
    active = (kmag > 0.0) & (kmag <= spectrum["k_cut"])
    mode_count = np.bincount(shell[active].reshape(-1), minlength=int(shell.max()) + 1)
    shell_k = np.arange(mode_count.size, dtype=float)*fundamental
    target_energy = shell_k**4*np.exp(-2.0*(shell_k/spectrum["k0"])**2)
    shell_amplitude = np.zeros_like(target_energy)
    populated = mode_count > 0
    shell_amplitude[populated] = np.sqrt(target_energy[populated]/mode_count[populated])
    return np.where(active, shell_amplitude[shell], 0.0)


def compute_spectral_random_velocity_diagnostics(field, params, lengths_xyz, kinematic_viscosity):
    """!
    @brief Compute operator-aware, case-independent velocity diagnostics.
    @param[in] field Physical-cell velocity field.
    @param[in] params Normalized generator parameters.
    @param[in] lengths_xyz Physical box lengths in Cartesian order.
    @param[in] kinematic_viscosity Nondimensional kinematic viscosity.
    @return Diagnostic summary mapping.
    """
    cells = field.shape[:3]
    continuum, discrete, spacing = spectral_symbols(cells, lengths_xyz)
    coeff = np.fft.fftn(field, axes=(0, 1, 2))
    divergence = {}
    for label, symbols in (("continuum", continuum), ("picurv_discrete", discrete)):
        spectral_divergence = sum(symbols[c]*coeff[..., c] for c in range(3))
        symbol_magnitude2 = sum(symbol*symbol for symbol in symbols)
        velocity_magnitude2 = np.sum(np.abs(coeff)**2, axis=-1)
        denominator = math.sqrt(float(np.sum(symbol_magnitude2*velocity_magnitude2)))
        real_divergence = np.fft.ifftn(1j*spectral_divergence, axes=(0, 1, 2)).real
        divergence[f"{label}_divergence_max"] = float(np.max(np.abs(real_divergence)))
        divergence[f"{label}_divergence_rms"] = float(np.sqrt(np.mean(real_divergence**2)))
        divergence[f"{label}_divergence_normalized"] = (
            math.sqrt(float(np.sum(np.abs(spectral_divergence)**2)))/denominator if denominator else 0.0
        )
    means = field.mean(axis=(0, 1, 2))
    fluctuations = field - means
    fluctuation_rms = math.sqrt(float(np.mean(np.sum(fluctuations*fluctuations, axis=-1)))/3.0)
    # Uniform-grid Ucat -> Cart2Contra -> Contra2Cart reconstruction applies
    # cos^2(k_alpha*dx_alpha/2) to component alpha. Normalization remains
    # defined on the staged Ucat field; report the reconstructed state too.
    reconstructed_coeff = coeff.copy()
    for component in range(3):
        reconstructed_coeff[..., component] *= np.cos(
            0.5*continuum[component]*spacing[component]
        )**2
    reconstructed = np.fft.ifftn(reconstructed_coeff, axes=(0, 1, 2)).real
    gradient2 = sum(float(np.mean(np.fft.ifftn(1j*w*coeff[..., c], axes=(0,1,2)).real**2))
                    for c in range(3) for w in continuum)
    epsilon = kinematic_viscosity*gradient2
    taylor = math.sqrt(15*kinematic_viscosity*fluctuation_rms**2/epsilon) if epsilon > 0 else math.inf
    re_lambda = fluctuation_rms*taylor/kinematic_viscosity if kinematic_viscosity > 0 else math.inf
    # Shell binning is not performed here. `spectra.gen` owns the spectrum, and the
    # conductor runs it against the staged field, so a measured spectrum has exactly
    # one implementation. What remains below are generation audits, which need the
    # requested parameters and therefore belong with the generator.
    kmag = np.sqrt(sum(symbol*symbol for symbol in continuum))
    energy = 0.5*np.sum(np.abs(coeff/np.prod(cells))**2, axis=-1)
    zero_mode_energy = float(energy[(0, 0, 0)])
    cutoff = params["spectrum"].get("k_cut")
    energy_above_cutoff = float(np.sum(energy[kmag > cutoff])) if cutoff is not None else 0.0
    result = {"generator": "spectral_random_velocity", "field": "Ucat", "seed": params["seed"],
              "random": params["random"], "spectrum": params["spectrum"], "projection": params["projection"],
              "normalization": params["normalization"], "remove_mean": params["remove_mean"],
              "component_means": [float(x) for x in means],
              "component_rms": [float(x) for x in np.sqrt(np.mean(field*field, axis=(0,1,2)))],
              "fluctuation_component_rms": fluctuation_rms,
              "resolved_kinetic_energy": 0.5*float(np.mean(np.sum(field*field, axis=-1))),
              "picurv_reconstructed_component_rms": [
                  float(x) for x in np.sqrt(np.mean(reconstructed*reconstructed, axis=(0,1,2)))
              ],
              "picurv_reconstructed_kinetic_energy": 0.5*float(
                  np.mean(np.sum(reconstructed*reconstructed, axis=-1))
              ),
              "kinematic_viscosity": kinematic_viscosity, "dissipation": epsilon,
              "taylor_microscale": taylor, "re_lambda": re_lambda,
              "zero_mode_energy": zero_mode_energy, "energy_above_cutoff": energy_above_cutoff}
    if params["normalization"]["type"] == "component_rms":
        result["target_u_rms"] = params["normalization"]["target"]
    result.update(divergence)
    return result


def generate_spectral_random_velocity(nodes, raw_params, context=None):
    """!
    @brief Generate a configurable spectral random Ucat field and diagnostics.
    @param[in] nodes PICGRID node-coordinate array.
    @param[in] raw_params Raw structured provider parameters.
    @param[in] context Conductor-derived diagnostic context.
    @return Full periodic-dummy field and diagnostic summary.
    """
    params = validate_spectral_random_velocity_params(raw_params)
    cells, lengths_xyz = validate_spectral_grid(nodes)
    continuum, discrete, spacing = spectral_symbols(cells, lengths_xyz)
    kmag = np.sqrt(sum(symbol*symbol for symbol in continuum))
    cutoff = params["spectrum"].get("k_cut")
    limit = (2.0/3.0)*min(math.pi/value for value in spacing)
    if cutoff is not None and cutoff > limit*(1.0+1.0e-12):
        raise ValueError(f"params.spectrum.k_cut={cutoff} exceeds the two-thirds-resolution limit {limit:.12g}.")
    coeff = np.fft.fftn(np.random.default_rng(params["seed"]).standard_normal((*cells, 3)), axes=(0,1,2))
    fundamental = min(2*np.pi/length for length in lengths_xyz)
    envelope = spectral_envelope(kmag, params["spectrum"], fundamental)
    coeff *= envelope[..., None]
    if params["projection"]["type"] == "solenoidal":
        # Self-conjugate Nyquist planes do not have a distinct negative partner;
        # removing them keeps a single-symbol projection exactly Hermitian.
        nyquist = np.zeros(cells, dtype=bool)
        for axis, count in enumerate(cells):
            if count % 2 == 0:
                shape = [1, 1, 1]
                shape[axis] = count
                nyquist |= (np.arange(count).reshape(shape) == count//2)
        coeff[nyquist, :] = 0.0
        symbols = continuum if params["projection"]["operator"] == "continuum" else discrete
        coeff = project_coefficients(coeff, symbols)
    physical = np.fft.ifftn(coeff, axes=(0,1,2)).real
    if params["remove_mean"]:
        physical -= physical.mean(axis=(0,1,2), keepdims=True)
    if params["normalization"]["type"] == "component_rms":
        rms = math.sqrt(float(np.mean(np.sum(physical*physical, axis=-1)))/3.0)
        if rms == 0.0:
            raise ValueError("the selected spectrum and projection contain no active modes on this grid.")
        physical *= params["normalization"]["target"]/rms
    physical += np.asarray(params["random"]["mean"])[None, None, None, :]
    wrapped = tuple((np.arange(count + 2)-1) % count for count in cells)
    full = physical[np.ix_(*wrapped)]
    kinematic_viscosity = _finite_number((context or {}).get("kinematic_viscosity", 0.0),
                                          "context.kinematic_viscosity", nonnegative=True)
    summary = compute_spectral_random_velocity_diagnostics(physical, params, lengths_xyz, kinematic_viscosity)
    summary.update({"grid_cells_storage_kji": list(cells), "box_lengths_xyz": list(lengths_xyz),
                    "vector_shape": list(full.shape), "scalar_count": int(full.size),
                    "petsc_shape": list(full.shape), "petsc_scalar_count": int(full.size)})
    return full, summary


#: Parameters the channel and duct seeds accept.
WALL_SPECTRAL_PARAMS = frozenset({"field", "seed", "streamwise_axis", "wall_axes", "bulk_velocity",
                                  "perturbation_rms", "wall_modes", "spectrum", "initial_spectra"})


def validate_wall_spectral_params(raw, generator):
    """!
    @brief Validate a channel/duct seed; axes use Cartesian i/j/k order, velocities solver units.
    @param[in] raw Raw channel or duct parameter mapping.
    @param[in] generator Channel or duct provider identifier.
    @return Normalized wall-seed parameters.
    """
    if not isinstance(raw, dict) or set(raw) - WALL_SPECTRAL_PARAMS:
        raise ValueError("wall spectral IC has unsupported parameters.")
    if raw.get("field", "Ucat") != "Ucat":
        raise ValueError("wall spectral IC requires field: Ucat.")
    walls = raw.get("wall_axes", ["j"] if generator == "channel_spectral_velocity" else ["i", "j"])
    count = 1 if generator == "channel_spectral_velocity" else 2
    stream = raw.get("streamwise_axis", "k")
    if (not isinstance(walls, list) or len(walls) != count or any(a not in ("i", "j", "k") for a in walls)
            or len(set(walls)) != count
            or stream not in ("i", "j", "k") or stream in walls):
        raise ValueError("wall_axes must name the channel's one or duct's two axes; streamwise_axis must be periodic.")
    # Reuse DIT's spectral/seed validation; the envelope shapes the vector potential,
    # not a promised isotropic velocity spectrum after the curl and wall envelope.
    common = validate_spectral_random_velocity_params({
        "seed": raw.get("seed", 12345), "spectrum": raw.get("spectrum", {"type": "white"})})
    if common["seed"] < 0:
        raise ValueError("seed must be non-negative.")
    modes = raw.get("wall_modes", 3)
    if isinstance(modes, bool) or not isinstance(modes, int) or modes < 1:
        raise ValueError("wall_modes must be a positive integer.")
    return {"field": "Ucat", "seed": common["seed"], "spectrum": common["spectrum"],
            "wall_axes": walls, "streamwise_axis": stream, "wall_modes": modes,
            "bulk_velocity": _finite_number(raw.get("bulk_velocity", 1.0), "bulk_velocity", positive=True),
            "perturbation_rms": _finite_number(raw.get("perturbation_rms", 0.1), "perturbation_rms", positive=True),
            **({"initial_spectra": raw["initial_spectra"]} if "initial_spectra" in raw else {})}


def cartesian_flux_derivative(values, widths, axis, periodic):
    """!
    @brief Cell divergence of arithmetic face averages, with zero wall-face flux.
    @param[in] values Cell-centered Cartesian scalar samples.
    @param[in] widths Physical cell widths on the derivative axis.
    @param[in] axis Cartesian axis number, x=0 through z=2.
    @param[in] periodic Whether boundary faces wrap rather than carry zero flux.
    @return Cell-centered finite-volume derivative in storage order.

    This offline operator mirrors Cart2Contra followed by finite-volume divergence
    on a separable Cartesian grid. Tensor-product operators commute, so their curl
    is in this divergence's nullspace even on stretched wall axes.
    """
    storage_axis = 2 - axis
    moved = np.moveaxis(values, storage_axis, 0)
    faces = 0.5 * (moved[:-1] + moved[1:])
    boundary = 0.5 * (moved[-1:] + moved[:1]) if periodic else np.zeros_like(moved[:1])
    flux = np.concatenate((boundary, faces, boundary), axis=0)
    derivative = np.diff(flux, axis=0) / widths.reshape((-1,) + (1,)*(moved.ndim-1))
    return np.moveaxis(derivative, 0, storage_axis)


def generate_wall_spectral_velocity(nodes, raw_params, generator):
    """!
    @brief Generate a seeded discrete-curl perturbation and flux-normalized startup mean.
    @param[in] nodes PICGRID node coordinates in k/j/i/component order.
    @param[in] raw_params Raw wall-seed parameters.
    @param[in] generator Channel or duct provider identifier.
    @return Full Ucat array with dummies and diagnostic summary.

    Single-block Cartesian Ucat, stored k/j/i/component with one dummy layer.
    No MPI state is generated: runtime owns scatter, wall repair and reconstruction.
    Periodic axes are uniform; wall axes may stretch. The curl reads one neighbor.
    """
    params = validate_wall_spectral_params(raw_params, generator)
    walls = ["ijk".index(a) for a in params["wall_axes"]]
    periodic = [a for a in range(3) if a not in walls]
    cells, lengths = validate_spectral_grid(nodes, periodic)
    axes = (nodes[0, 0, :, 0], nodes[0, :, 0, 1], nodes[:, 0, 0, 2])
    widths = [np.diff(a) for a in axes]
    centers = [0.5*(a[:-1]+a[1:]) for a in axes]
    shape = list(cells)
    for a in walls:
        # sin(pi t) raises the highest sine index of sin(n pi t) by one.
        if params["wall_modes"] + 1 > cells[2-a] // 2:
            raise ValueError("wall_modes plus the wall envelope are unresolved on this grid.")
        shape[2-a] = params["wall_modes"]
    potential = np.random.default_rng(params["seed"]).standard_normal((*shape, 3))
    fft_axes = tuple(2-a for a in periodic)
    coeff = np.fft.fftn(potential, axes=fft_axes)
    kmag2 = np.zeros(shape)
    active = np.ones(shape, dtype=bool)
    for a in periodic:
        n = cells[2-a]
        k = 2*np.pi*np.fft.fftfreq(n, d=widths[a][0])
        sh = [1, 1, 1]; sh[2-a] = n
        kmag2 += k.reshape(sh)**2
        active &= (np.abs(np.fft.fftfreq(n)*n) < n/3).reshape(sh)
    kmag = np.sqrt(kmag2)
    cutoff = params["spectrum"].get("k_cut")
    limit = min(2*np.pi/(3*widths[a][0]) for a in periodic)
    if cutoff is not None and cutoff > limit*(1+1e-12):
        raise ValueError("spectrum.k_cut exceeds the periodic two-thirds-resolution limit.")
    coeff *= (spectral_envelope(kmag, params["spectrum"], min(2*np.pi/lengths[a] for a in periodic))
              * active * (kmag > 0))[..., None]
    potential = np.fft.ifftn(coeff, axes=fft_axes).real
    mean = np.ones(cells)
    for a in walls:
        t = (centers[a]-axes[a][0])/lengths[a]
        # One power of the envelope is the least that keeps the potential and its
        # wall-normal derivative zero at the wall, so the curl satisfies no-slip with
        # the physical asymptotics: wall-parallel u' ~ y, wall-normal v' ~ y^2. A
        # higher power would starve the buffer layer (sin^4 left u' ~ y^4, 1e-3 of a
        # developed flow's at y+ ~ 13 on the Re_tau = 180 channel).
        basis = np.sin(np.pi*t[:, None]*np.arange(1, params["wall_modes"]+1)) * np.sin(np.pi*t[:, None])
        potential = np.moveaxis(np.tensordot(basis, potential, axes=(1, 2-a)), 0, 2-a)
        sh = [1, 1, 1]; sh[2-a] = len(t)
        mean *= (4*t*(1-t)).reshape(sh)
    def derivative(v, a):
        """!
        @brief Apply the wall-seed divergence operator to one component.
        @param[in] v Scalar component of the potential or velocity.
        @param[in] a Cartesian derivative axis.
        @return Derivative using the grid widths and boundary topology.
        """
        return cartesian_flux_derivative(v, widths[a], a, a in periodic)
    velocity = np.stack([derivative(potential[..., (a+2)%3], (a+1)%3)
                         - derivative(potential[..., (a+1)%3], (a+2)%3) for a in range(3)], axis=-1)
    volume = widths[2][:, None, None]*widths[1][None, :, None]*widths[0][None, None, :]
    rms = np.sqrt(np.sum(volume*np.sum(velocity**2, axis=-1))/(3*np.sum(volume)))
    if not np.isfinite(rms) or rms <= 0:
        raise ValueError("selected spectrum contains no active perturbation modes.")
    velocity *= params["perturbation_rms"]/rms
    divergence = sum(derivative(velocity[..., a], a) for a in range(3))
    perturbation_means = np.sum(velocity*volume[..., None], axis=(0,1,2))/np.sum(volume)
    component_rms = [float(np.sqrt(np.sum(volume*velocity[..., a]**2)/np.sum(volume))) for a in range(3)]
    mean *= params["bulk_velocity"]*np.sum(volume)/np.sum(mean*volume)
    stream = "ijk".index(params["streamwise_axis"])
    velocity[..., stream] += mean
    # Periodic dummies wrap. Wall dummies reflect oddly about the no-slip face.
    full = velocity
    for a in range(3):
        sa = 2-a
        if a in periodic:
            full = np.concatenate((np.take(full, [-1], axis=sa), full, np.take(full, [0], axis=sa)), axis=sa)
        else:
            full = np.concatenate((-np.take(full, [0], axis=sa), full, -np.take(full, [-1], axis=sa)), axis=sa)
    return full, {"generator": generator, "field": "Ucat", "params": params,
        "vector_shape": list(full.shape), "scalar_count": int(full.size),
        "perturbation_component_rms": component_rms,
        "perturbation_rms": float(np.sqrt(np.mean(np.square(component_rms)))),
        "perturbation_component_means": perturbation_means.tolist(),
        "picurv_discrete_divergence_max": float(np.max(np.abs(divergence))),
        "bulk_velocity": float(np.sum(volume*velocity[..., stream])/np.sum(volume)),
        "mean_profile": "flux_normalized_product_parabola_startup",
        "spectrum_applies_to": "vector_potential_periodic_modes",
        "measurement_state": "generated_Ucat_before_runtime_reconstruction"}


def build_parser():
    """!
    @brief Build the command-line parser.
    @return Configured parser.
    """
    parser = argparse.ArgumentParser(description="Generate a PICurv initial-condition PETSc vector.")
    parser.add_argument("--generator", choices=("expression", "spectral_random_velocity", "channel_spectral_velocity", "duct_spectral_velocity"),
                        default="expression", help="Maintained IC generator implementation.")
    parser.add_argument("-c", "--config", help="Expression-generator INI configuration.")
    parser.add_argument("--params-json", help="JSON parameters for a built-in generator.")
    parser.add_argument("--context-json", help="Conductor-derived diagnostic context.")
    parser.add_argument("--field", choices=("Ucat", "Ucont"), help="Field representation to generate.")
    parser.add_argument("--output", required=True, help="Output PETSc binary vector.")
    parser.add_argument("--grid", help="Canonical nondimensional PICGRID; defaults to grid.run beside output.")
    parser.add_argument("--summary-json", help="Optional summary JSON path.")
    parser.add_argument("--length-ref", type=float, default=1.0,
                        help="Reference length: expressions see physical coordinates, grid * length_ref.")
    parser.add_argument("--velocity-ref", type=float, default=1.0,
                        help="Reference velocity: expression values are physical and are written in solver units.")
    return parser


#: Reference scale of each expression field's values, as (length, velocity) exponents:
#: Ucat is a velocity, and each Ucont component is a volume flux through its face.
EXPRESSION_FIELD_DIMENSIONS = {"Ucat": (0, 1), "Ucont": (2, 1)}


def generate_expression_field(nodes, config, field_name, length_ref=1.0, velocity_ref=1.0):
    """!
    @brief Evaluate a physical expression field and return it in solver units.
    @details The staged grid is nondimensional, so it is scaled back to physical
             coordinates before evaluation; the expressions, and the configured controls,
             then act on physical values, which one division returns to solver units.
    @param[in] nodes Nondimensional PICGRID coordinates.
    @param[in] config Normalized expression configuration.
    @param[in] field_name `Ucat` or `Ucont`.
    @param[in] length_ref Reference length of the case.
    @param[in] velocity_ref Reference velocity of the case.
    @return Field in solver units.
    """
    if length_ref <= 0.0 or velocity_ref <= 0.0:
        raise ValueError("length_ref and velocity_ref must be positive.")
    physical_nodes = nodes * length_ref
    field = generate_ucat(physical_nodes, config) if field_name == "Ucat" else generate_ucont(physical_nodes, config)
    length_power, velocity_power = EXPRESSION_FIELD_DIMENSIONS[field_name]
    return field / (length_ref ** length_power * velocity_ref ** velocity_power)


def main(argv=None) -> int:
    """!
    @brief Generate the requested initial-condition PETSc vector from configuration and PICGRID inputs.
    @param[in] argv Optional argument override.
    @return Process exit code.
    """
    args = build_parser().parse_args(argv)
    try:
        grid_path = args.grid or os.path.join(os.path.dirname(os.path.abspath(args.output)), "grid.run")
        dims, nodes = read_picgrid(grid_path)
        if args.generator == "spectral_random_velocity":
            if not args.params_json:
                raise ValueError("spectral_random_velocity generation requires --params-json.")
            field, summary = generate_spectral_random_velocity(
                nodes, json.loads(args.params_json), json.loads(args.context_json or "{}")
            )
        elif args.generator in ("channel_spectral_velocity", "duct_spectral_velocity"):
            field, summary = generate_wall_spectral_velocity(nodes, json.loads(args.params_json or "{}"), args.generator)
        else:
            if not args.config or not args.field:
                raise ValueError("expression generation requires --config and --field.")
            config = read_config(args.config)
            field = generate_expression_field(nodes, config, args.field, args.length_ref, args.velocity_ref)
            summary = {
                "field": args.field, "generator": "expression", "grid": os.path.abspath(grid_path),
                "units": "solver", "length_ref": args.length_ref, "velocity_ref": args.velocity_ref,
                "output": os.path.abspath(args.output), "grid_dims": list(dims),
                "vector_shape": list(field.shape), "scalar_count": int(field.size),
                "min_components": [float(np.min(field[..., component])) for component in range(3)],
                "max_components": [float(np.max(field[..., component])) for component in range(3)],
            }
        write_petsc_vec_binary(args.output, field)
        summary.update({"grid": os.path.abspath(grid_path), "output": os.path.abspath(args.output),
                        "grid_dims": list(dims)})
        if args.summary_json:
            os.makedirs(os.path.dirname(os.path.abspath(args.summary_json)), exist_ok=True)
            with open(args.summary_json, "w", encoding="utf-8") as fout:
                json.dump(summary, fout, indent=2, sort_keys=True)
                fout.write("\n")
        print(json.dumps(summary, sort_keys=True))
        return 0
    except Exception as exc:
        print(f"[ERROR] ic.gen failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
