#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""!
@file ic.gen
@brief Generate PICurv initial velocity fields as PETSc vectors.
"""

import argparse
import json
import math
import os
import sys

import numpy as np


def read_picgrid(path: str):
    """!
    @brief Read one canonical PICGRID block.
    @param[in] path PICGRID input path.
    @return Tuple of node dimensions and coordinates shaped `(KM, JM, IM, 3)`.
    """
    with open(path, "r", encoding="utf-8") as fin:
        lines = [line.strip() for line in fin if line.strip() and not line.lstrip().startswith("#")]
    if len(lines) < 3 or lines[0] != "PICGRID":
        raise ValueError("grid must begin with the canonical PICGRID header.")
    if int(lines[1]) != 1:
        raise ValueError("ic.gen supports single-block PICGRID files only.")
    dims = tuple(int(value) for value in lines[2].split())
    if len(dims) != 3 or min(dims) < 2:
        raise ValueError(f"invalid PICGRID dimensions {dims}.")
    im, jm, km = dims
    expected = im * jm * km
    if len(lines[3:]) != expected:
        raise ValueError(f"PICGRID coordinate count mismatch: expected {expected}, found {len(lines[3:])}.")
    coords = np.asarray([[float(value) for value in line.split()] for line in lines[3:]], dtype=float)
    if coords.shape != (expected, 3) or not np.all(np.isfinite(coords)):
        raise ValueError("PICGRID coordinates must be finite three-component rows.")
    return dims, coords.reshape((km, jm, im, 3))


#: Bytes of a PetscInt in the PETSc that will read the output; set from `--petsc-index-bytes`.
PETSC_INDEX_BYTES = 4


def write_petsc_vec_binary(path: str, field) -> None:
    """!
    @brief Write a field as a PETSc Vec binary whose sizes are PetscInt of PETSC_INDEX_BYTES.
    @param[in] path Output path; its directory is created.
    @param[in] field Full field array.
    """
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    _shared("petsc_binary").write_petsc_vec_binary(
        path, np.asarray(field, dtype=">f8").reshape(-1).tobytes(), PETSC_INDEX_BYTES)


def _finite_number(value, path, *, positive=False, nonnegative=False):
    """!
    @brief Parse one finite numerical configuration value.
    @param[in] value Raw value.
    @param[in] path Configuration path for errors.
    @param[in] positive Whether zero and negative values are invalid.
    @param[in] nonnegative Whether negative values are invalid.
    @return Parsed float.
    """
    if isinstance(value, bool):
        raise ValueError(f"{path} must be numeric, not boolean.")
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        raise ValueError(f"{path} must be numeric (got {value!r}).") from None
    valid = np.isfinite(parsed)
    valid = valid and (not positive or parsed > 0.0)
    valid = valid and (not nonnegative or parsed >= 0.0)
    if not valid:
        raise ValueError(f"{path} has an invalid numerical value.")
    return parsed


def _validate_seed_spectrum(seed, spectrum, where="params"):
    """!
    @brief Validate the seed and the spectrum every spectral perturbation takes.
    @param[in] seed Raw seed.
    @param[in] spectrum Raw spectrum mapping.
    @param[in] where Configuration path holding both, for errors.
    @return `(seed, normalized spectrum)`.
    """
    if isinstance(seed, bool) or not isinstance(seed, (int, np.integer)):
        raise ValueError(f"{where}.seed must be an integer.")
    if not isinstance(spectrum, dict):
        raise ValueError(f"{where}.spectrum must be a mapping.")
    spectrum_type = str(spectrum.get("type", "white")).lower()
    if spectrum_type == "white":
        if set(spectrum) - {"type"}:
            raise ValueError("white spectrum supports only type.")
        return int(seed), {"type": "white"}
    if spectrum_type == "k4_exponential":
        if set(spectrum) - {"type", "k0", "k_cut"} or "k0" not in spectrum or "k_cut" not in spectrum:
            raise ValueError("k4_exponential spectrum requires only type, k0, and k_cut.")
        return int(seed), {
            "type": "k4_exponential",
            "k0": _finite_number(spectrum["k0"], f"{where}.spectrum.k0", positive=True),
            "k_cut": _finite_number(spectrum["k_cut"], f"{where}.spectrum.k_cut", positive=True),
        }
    raise ValueError(f"{where}.spectrum.type must be 'white' or 'k4_exponential'.")


def validate_periodic_spectral_params(raw):
    """!
    @brief Validate `spectral_velocity` in a periodic box: no `wall_axes`.
    @param[in] raw Raw parameter mapping, without `wall_axes`.
    @return Normalized parameter mapping.
    """
    if not isinstance(raw, dict):
        raise ValueError("spectral_velocity params must be a mapping.")
    allowed = {"field", "seed", "random", "spectrum", "projection", "normalization", "remove_mean"}
    unknown = sorted(set(raw) - allowed)
    if unknown:
        raise ValueError(f"spectral_velocity has unsupported parameter(s): {unknown}.")
    if str(raw.get("field", "Ucat")).lower() != "ucat":
        raise ValueError("spectral_velocity supports only params.field: Ucat.")
    seed, normalized_spectrum = _validate_seed_spectrum(raw.get("seed", 12345), raw.get("spectrum", {}))

    random_cfg = raw.get("random", {})
    if not isinstance(random_cfg, dict) or set(random_cfg) - {"distribution", "mean"}:
        raise ValueError("params.random supports only distribution and mean.")
    distribution = str(random_cfg.get("distribution", "gaussian")).lower()
    if distribution != "gaussian":
        raise ValueError("params.random.distribution supports only 'gaussian'.")
    mean = random_cfg.get("mean", [0.0, 0.0, 0.0])
    if not isinstance(mean, list) or len(mean) != 3:
        raise ValueError("params.random.mean must be a three-component list.")
    mean = [_finite_number(value, f"params.random.mean[{index}]") for index, value in enumerate(mean)]

    projection = raw.get("projection", {"type": "none"})
    if not isinstance(projection, dict) or set(projection) - {"type", "operator"}:
        raise ValueError("params.projection supports only type and operator.")
    projection_type = str(projection.get("type", "none")).lower()
    if projection_type == "none":
        if "operator" in projection:
            raise ValueError("projection.operator is invalid when projection.type is 'none'.")
        normalized_projection = {"type": "none"}
    elif projection_type == "solenoidal":
        operator = str(projection.get("operator", "")).lower()
        if operator not in {"continuum", "picurv_discrete"}:
            raise ValueError("solenoidal projection.operator must be 'continuum' or 'picurv_discrete'.")
        normalized_projection = {"type": "solenoidal", "operator": operator}
    else:
        raise ValueError("params.projection.type must be 'none' or 'solenoidal'.")

    normalization = raw.get("normalization", {"type": "none"})
    if not isinstance(normalization, dict) or set(normalization) - {"type", "target"}:
        raise ValueError("params.normalization supports only type and target.")
    normalization_type = str(normalization.get("type", "none")).lower()
    if normalization_type == "none":
        if "target" in normalization:
            raise ValueError("normalization.target is invalid when normalization.type is 'none'.")
        normalized_normalization = {"type": "none"}
    elif normalization_type == "component_rms":
        if "target" not in normalization:
            raise ValueError("component_rms normalization requires target.")
        normalized_normalization = {"type": "component_rms",
                                    "target": _finite_number(normalization["target"], "params.normalization.target", positive=True)}
    else:
        raise ValueError("params.normalization.type must be 'none' or 'component_rms'.")
    remove_mean = raw.get("remove_mean", True)
    if not isinstance(remove_mean, bool):
        raise ValueError("params.remove_mean must be boolean.")
    return {"field": "Ucat", "seed": seed, "random": {"distribution": distribution, "mean": mean},
            "spectrum": normalized_spectrum, "projection": normalized_projection,
            "normalization": normalized_normalization, "remove_mean": remove_mean}


def _shared(name: str):
    """!
    @brief Load one of the CLI's shared modules: `periodic_spectral`, `source_expressions` or `petsc_binary`.
    @details Imported when a provider or the writer needs it rather than when this file loads.
    @param[in] name Module name under `picurv_cli/`.
    @return The module.
    """
    shared = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "picurv_cli")
    if shared not in sys.path:
        sys.path.insert(0, shared)
    return __import__(name)


def project_coefficients(coeff, symbols):
    """!
    @brief Apply one rank-two Fourier-space solenoidal projector.
    @param[in] coeff Vector-valued Fourier coefficients.
    @param[in] symbols Selected divergence-operator symbols.
    @return Projected Fourier coefficients.
    """
    magnitude2 = sum(symbol*symbol for symbol in symbols)
    dot = sum(symbols[c]*coeff[..., c] for c in range(3))
    projected = coeff.copy()
    denominator = np.where(magnitude2 > 0.0, magnitude2, 1.0)
    for component, symbol in enumerate(symbols):
        projected[..., component] -= symbol*dot/denominator
    projected[magnitude2 == 0.0, :] = 0.0
    return projected


def spectral_envelope(kmag, spectrum, fundamental):
    """!
    @brief Compute a modal envelope from the requested finite-grid shell energy.
    @param[in] kmag Physical wavevector magnitudes.
    @param[in] spectrum Normalized spectrum selector.
    @param[in] fundamental Shell width in physical wavenumber units.
    @return Modal amplitude envelope.
    """
    if spectrum["type"] == "white":
        return np.ones_like(kmag)
    shell = np.floor(kmag/fundamental + 0.5).astype(int)
    active = (kmag > 0.0) & (kmag <= spectrum["k_cut"])
    mode_count = np.bincount(shell[active].reshape(-1), minlength=int(shell.max()) + 1)
    shell_k = np.arange(mode_count.size, dtype=float)*fundamental
    target_energy = shell_k**4*np.exp(-2.0*(shell_k/spectrum["k0"])**2)
    shell_amplitude = np.zeros_like(target_energy)
    populated = mode_count > 0
    shell_amplitude[populated] = np.sqrt(target_energy[populated]/mode_count[populated])
    return np.where(active, shell_amplitude[shell], 0.0)


def compute_periodic_velocity_diagnostics(field, lengths_xyz, kinematic_viscosity):
    """!
    @brief Compute operator-aware, case-independent diagnostics of a triply periodic velocity.
    @details Shared by every provider that stages a periodic-box field, so their summaries
             report divergence, energy, and Reynolds number the same way.
    @param[in] field Physical-cell velocity field `[k, j, i, component]`.
    @param[in] lengths_xyz Physical box lengths in Cartesian order.
    @param[in] kinematic_viscosity Nondimensional kinematic viscosity.
    @return Diagnostic mapping; also the coefficients and wavenumber magnitude, under
            private keys, for callers that add provider-specific audits.
    """
    cells = field.shape[:3]
    continuum, discrete, spacing = _shared("periodic_spectral").spectral_symbols(cells, lengths_xyz)
    coeff = np.fft.fftn(field, axes=(0, 1, 2))
    divergence = {}
    for label, symbols in (("continuum", continuum), ("picurv_discrete", discrete)):
        spectral_divergence = sum(symbols[c]*coeff[..., c] for c in range(3))
        symbol_magnitude2 = sum(symbol*symbol for symbol in symbols)
        velocity_magnitude2 = np.sum(np.abs(coeff)**2, axis=-1)
        denominator = math.sqrt(float(np.sum(symbol_magnitude2*velocity_magnitude2)))
        real_divergence = np.fft.ifftn(1j*spectral_divergence, axes=(0, 1, 2)).real
        divergence[f"{label}_divergence_max"] = float(np.max(np.abs(real_divergence)))
        divergence[f"{label}_divergence_rms"] = float(np.sqrt(np.mean(real_divergence**2)))
        divergence[f"{label}_divergence_normalized"] = (
            math.sqrt(float(np.sum(np.abs(spectral_divergence)**2)))/denominator if denominator else 0.0
        )
    means = field.mean(axis=(0, 1, 2))
    fluctuations = field - means
    fluctuation_rms = math.sqrt(float(np.mean(np.sum(fluctuations*fluctuations, axis=-1)))/3.0)
    # Uniform-grid Ucat -> Cart2Contra -> Contra2Cart reconstruction applies
    # cos^2(k_alpha*dx_alpha/2) to component alpha. Normalization remains
    # defined on the staged Ucat field; report the reconstructed state too.
    reconstructed_coeff = coeff.copy()
    for component in range(3):
        reconstructed_coeff[..., component] *= np.cos(
            0.5*continuum[component]*spacing[component]
        )**2
    reconstructed = np.fft.ifftn(reconstructed_coeff, axes=(0, 1, 2)).real
    gradient2 = sum(float(np.mean(np.fft.ifftn(1j*w*coeff[..., c], axes=(0,1,2)).real**2))
                    for c in range(3) for w in continuum)
    epsilon = kinematic_viscosity*gradient2
    taylor = math.sqrt(15*kinematic_viscosity*fluctuation_rms**2/epsilon) if epsilon > 0 else math.inf
    re_lambda = fluctuation_rms*taylor/kinematic_viscosity if kinematic_viscosity > 0 else math.inf
    # Shell binning is not performed here. `spectra.gen` owns the spectrum, and the
    # conductor runs it against the staged field, so a measured spectrum has exactly
    # one implementation.
    kmag = np.sqrt(sum(symbol*symbol for symbol in continuum))
    energy = 0.5*np.sum(np.abs(coeff/np.prod(cells))**2, axis=-1)
    zero_mode_energy = float(energy[(0, 0, 0)])
    result = {"component_means": [float(x) for x in means],
              "component_rms": [float(x) for x in np.sqrt(np.mean(field*field, axis=(0,1,2)))],
              "fluctuation_component_rms": fluctuation_rms,
              "resolved_kinetic_energy": 0.5*float(np.mean(np.sum(field*field, axis=-1))),
              "picurv_reconstructed_component_rms": [
                  float(x) for x in np.sqrt(np.mean(reconstructed*reconstructed, axis=(0,1,2)))
              ],
              "picurv_reconstructed_kinetic_energy": 0.5*float(
                  np.mean(np.sum(reconstructed*reconstructed, axis=-1))
              ),
              "kinematic_viscosity": kinematic_viscosity, "dissipation": epsilon,
              "taylor_microscale": taylor, "re_lambda": re_lambda,
              "zero_mode_energy": zero_mode_energy}
    result.update(divergence)
    result["_mode_energy"] = energy
    result["_kmag"] = kmag
    return result


def _public_diagnostics(result):
    """!
    @brief Drop the private arrays `compute_periodic_velocity_diagnostics()` hands back.
    @param[in] result Diagnostic mapping.
    @return The JSON-serializable part.
    """
    return {key: value for key, value in result.items() if not key.startswith("_")}


def compute_periodic_spectral_diagnostics(field, params, lengths_xyz, kinematic_viscosity):
    """!
    @brief Compute a periodic box's diagnostics: the shared ones plus generation audits.
    @param[in] field Physical-cell velocity field.
    @param[in] params Normalized generator parameters.
    @param[in] lengths_xyz Physical box lengths in Cartesian order.
    @param[in] kinematic_viscosity Nondimensional kinematic viscosity.
    @return Diagnostic summary mapping.
    """
    shared = compute_periodic_velocity_diagnostics(field, lengths_xyz, kinematic_viscosity)
    # Generation audits need the requested parameters, so they belong with the generator.
    cutoff = params["spectrum"].get("k_cut")
    energy_above_cutoff = (float(np.sum(shared["_mode_energy"][shared["_kmag"] > cutoff]))
                           if cutoff is not None else 0.0)
    result = {"generator": "spectral_velocity", "field": "Ucat", "seed": params["seed"],
              "random": params["random"], "spectrum": params["spectrum"], "projection": params["projection"],
              "normalization": params["normalization"], "remove_mean": params["remove_mean"],
              "energy_above_cutoff": energy_above_cutoff}
    result.update(_public_diagnostics(shared))
    if params["normalization"]["type"] == "component_rms":
        result["target_u_rms"] = params["normalization"]["target"]
    return result


def generate_periodic_spectral_velocity(nodes, params, context=None):
    """!
    @brief Generate a periodic box's spectral random Ucat field and diagnostics.
    @param[in] nodes PICGRID node-coordinate array.
    @param[in] params Parameters normalized by validate_periodic_spectral_params().
    @param[in] context Conductor-derived diagnostic context.
    @return Full periodic-dummy field and diagnostic summary.
    """
    spectral = _shared("periodic_spectral")
    cells, lengths_xyz = spectral.validate_spectral_grid(nodes, subject="spectral_velocity without walls requires")
    continuum, discrete, spacing = spectral.spectral_symbols(cells, lengths_xyz)
    kmag = np.sqrt(sum(symbol*symbol for symbol in continuum))
    cutoff = params["spectrum"].get("k_cut")
    limit = (2.0/3.0)*min(math.pi/value for value in spacing)
    if cutoff is not None and cutoff > limit*(1.0+1.0e-12):
        raise ValueError(f"params.spectrum.k_cut={cutoff} exceeds the two-thirds-resolution limit {limit:.12g}.")
    coeff = np.fft.fftn(np.random.default_rng(params["seed"]).standard_normal((*cells, 3)), axes=(0,1,2))
    fundamental = min(2*np.pi/length for length in lengths_xyz)
    envelope = spectral_envelope(kmag, params["spectrum"], fundamental)
    coeff *= envelope[..., None]
    if params["projection"]["type"] == "solenoidal":
        # Self-conjugate Nyquist planes do not have a distinct negative partner;
        # removing them keeps a single-symbol projection exactly Hermitian.
        nyquist = np.zeros(cells, dtype=bool)
        for axis, count in enumerate(cells):
            if count % 2 == 0:
                shape = [1, 1, 1]
                shape[axis] = count
                nyquist |= (np.arange(count).reshape(shape) == count//2)
        coeff[nyquist, :] = 0.0
        symbols = continuum if params["projection"]["operator"] == "continuum" else discrete
        coeff = project_coefficients(coeff, symbols)
    physical = np.fft.ifftn(coeff, axes=(0,1,2)).real
    if params["remove_mean"]:
        physical -= physical.mean(axis=(0,1,2), keepdims=True)
    if params["normalization"]["type"] == "component_rms":
        rms = math.sqrt(float(np.mean(np.sum(physical*physical, axis=-1)))/3.0)
        if rms == 0.0:
            raise ValueError("the selected spectrum and projection contain no active modes on this grid.")
        physical *= params["normalization"]["target"]/rms
    physical += np.asarray(params["random"]["mean"])[None, None, None, :]
    wrapped = tuple((np.arange(count + 2)-1) % count for count in cells)
    full = physical[np.ix_(*wrapped)]
    kinematic_viscosity = _finite_number((context or {}).get("kinematic_viscosity", 0.0),
                                          "context.kinematic_viscosity", nonnegative=True)
    summary = compute_periodic_spectral_diagnostics(physical, params, lengths_xyz, kinematic_viscosity)
    summary.update({"grid_cells_storage_kji": list(cells), "box_lengths_xyz": list(lengths_xyz),
                    "vector_shape": list(full.shape), "scalar_count": int(full.size),
                    "petsc_shape": list(full.shape), "petsc_scalar_count": int(full.size)})
    return full, summary


#: File containers `resampled_velocity` reads. Each holds the same declared layout.
RESAMPLED_VELOCITY_FORMATS = ("raw", "npy", "npz", "hdf5")


def _orient_source_array(array, layout):
    """!
    @brief Bring a source array to PICurv storage order `[k, j, i, component]`.
    @param[in] array Array exactly as read: components on the last axis when interleaved,
                     on the first when separate; spatial axes slowest-first.
    @param[in] layout Normalized layout mapping.
    @return Float64 array `[k, j, i, 3]`.
    """
    if layout["components"] == "separate":
        array = np.moveaxis(array, 0, -1)
    if array.ndim != 4 or array.shape[-1] != 3:
        raise ValueError(f"source velocity must hold three components on three axes; read shape {array.shape}.")
    if layout["fastest_axis"] == "z":
        # Spatial axes are (x, y, z) slowest-first; storage order wants (z, y, x).
        array = np.transpose(array, (2, 1, 0, 3))
    return np.ascontiguousarray(array, dtype=np.float64)


def read_source_velocity(params):
    """!
    @brief Read the external velocity field `resampled_velocity` resamples.
    @param[in] params Normalized provider parameters, `source_file` absolute.
    @return Physical-unit samples `[k, j, i, 3]` as stored in the source.
    """
    layout = params["layout"]
    path = params["source_file"]
    fmt = params["format"]
    cells = params.get("cells")
    spatial = None if cells is None else (cells[2], cells[1], cells[0]) if layout["fastest_axis"] == "x" \
        else (cells[0], cells[1], cells[2])
    if fmt == "raw":
        dtype = np.dtype(layout["dtype"]).newbyteorder({"little": "<", "big": ">", "native": "="}[layout["byte_order"]])
        count = int(np.prod(cells)) * 3
        expected = layout["header_bytes"] + count * dtype.itemsize
        size = os.path.getsize(path)
        if size != expected:
            raise ValueError(f"raw source {path} holds {size} bytes; the declared layout needs exactly "
                             f"{expected} ({layout['header_bytes']} header + {count} {layout['dtype']} values).")
        values = np.fromfile(path, dtype=dtype, count=count, offset=layout["header_bytes"])
        shape = (*spatial, 3) if layout["components"] == "interleaved" else (3, *spatial)
        array = values.reshape(shape)
    elif fmt in ("npy", "npz", "hdf5"):
        names = layout.get("datasets")
        if fmt == "npy":
            array = np.load(path, allow_pickle=False)
        else:
            if fmt == "npz":
                store = np.load(path, allow_pickle=False)
                fetch = lambda name: np.asarray(store[name])
            else:
                try:
                    import h5py
                except ImportError as exc:
                    raise ValueError("format: hdf5 needs h5py, which is not installed; install it with "
                                     "'<picurv python> -m pip install h5py' or convert the file to npz.") from exc
                store = h5py.File(path, "r")
                fetch = lambda name: np.asarray(store[name])
            if not names:
                raise ValueError(f"format: {fmt} needs layout.datasets: one array name, or three for u, v, w.")
            if len(names) == 3:
                array = np.stack([fetch(name) for name in names], axis=-1)
                if layout["components"] == "separate":
                    raise ValueError("layout.components must be interleaved when three datasets are named; "
                                     "each dataset is one component already.")
            else:
                array = fetch(names[0])
        if spatial is not None:
            found = array.shape[:-1] if layout["components"] == "interleaved" or (names and len(names) == 3) \
                else array.shape[1:]
            if tuple(found) != tuple(spatial):
                raise ValueError(f"source array has spatial shape {tuple(found)}; params.cells declares {tuple(spatial)}.")
    else:
        raise ValueError(f"format must be one of {RESAMPLED_VELOCITY_FORMATS}.")
    return _orient_source_array(np.asarray(array), layout)


def _staggered_fluxes(coeff, cells, lengths_xyz):
    """!
    @brief Sample cell-centre Fourier coefficients at face centres as PICurv volume fluxes.
    @details Component `a` of cell `s` is evaluated on the cell's lower `a`-face, half a
             spacing below its centre, and multiplied by the face area: the staggered
             representation PICurv evolves.
    @param[in] coeff Unnormalized `fftn` coefficients of the cell-centre field `[k, j, i, 3]`.
    @param[in] cells Cell counts in storage order.
    @param[in] lengths_xyz Box periods in Cartesian order.
    @return Fluxes `[k, j, i, 3]`; entry `[.., s, a]` is the flux through the lower face of cell `s`.
    """
    continuum, _discrete, spacing = _shared("periodic_spectral").spectral_symbols(cells, lengths_xyz)
    fluxes = np.empty(coeff.shape, dtype=float)
    for a in range(3):
        area = spacing[(a + 1) % 3] * spacing[(a + 2) % 3]
        shifted = coeff[..., a] * np.exp(-0.5j * continuum[a] * spacing[a])
        fluxes[..., a] = np.fft.ifftn(shifted, axes=(0, 1, 2)).real * area
    return fluxes


def _flux_storage(fluxes, cells):
    """!
    @brief Place periodic face fluxes into PICurv's `Ucont` vector layout.
    @details Matches `generate_ucont()`: the xi component of node plane `i` sits at
             `[1:km, 1:jm, i]`, and likewise for eta and zeta. The periodic closing plane
             repeats the first; dummy layers stay zero for the runtime to fill.
    @param[in] fluxes Fluxes from `_staggered_fluxes()`.
    @param[in] cells Cell counts in storage order.
    @return Full `Ucont` array `[KM+1, JM+1, IM+1, 3]`.
    """
    nk, nj, ni = cells
    full = np.zeros((nk + 2, nj + 2, ni + 2, 3), dtype=float)
    full[1:nk + 1, 1:nj + 1, 0:ni, 0] = fluxes[..., 0]
    full[1:nk + 1, 1:nj + 1, ni, 0] = fluxes[:, :, 0, 0]
    full[1:nk + 1, 0:nj, 1:ni + 1, 1] = fluxes[..., 1]
    full[1:nk + 1, nj, 1:ni + 1, 1] = fluxes[:, 0, :, 1]
    full[0:nk, 1:nj + 1, 1:ni + 1, 2] = fluxes[..., 2]
    full[nk, 1:nj + 1, 1:ni + 1, 2] = fluxes[0, :, :, 2]
    return full


def _runtime_ucat_from_fluxes(fluxes, cells, lengths_xyz):
    """!
    @brief The cell-centre velocity PICurv reconstructs from staged face fluxes.
    @param[in] fluxes Fluxes from `_staggered_fluxes()`.
    @param[in] cells Cell counts in storage order.
    @param[in] lengths_xyz Box periods in Cartesian order.
    @return Reconstructed `Ucat` `[k, j, i, 3]`: the mean of each cell's two face fluxes over the face area.
    """
    _continuum, _discrete, spacing = _shared("periodic_spectral").spectral_symbols(cells, lengths_xyz)
    ucat = np.empty(fluxes.shape, dtype=float)
    for a in range(3):
        area = spacing[(a + 1) % 3] * spacing[(a + 2) % 3]
        upper = np.roll(fluxes[..., a], -1, axis=2 - a)
        ucat[..., a] = 0.5 * (fluxes[..., a] + upper) / area
    return ucat


def generate_resampled_velocity(nodes, params, context=None):
    """!
    @brief Bring an external periodic velocity field onto the staged grid.
    @details Reads the source, resamples it in Fourier space to the target grid (truncating or
             zero-padding, then filtering), projects it to be divergence-free under PICurv's
             discrete operator for the staged field, optionally removes the mean, and writes
             solver units. `field: Ucont` samples the face centres and projects with the
             face-difference symbol 2 sin(k dx/2)/dx, the staggered representation PICurv
             evolves; `field: Ucat` samples the cell centres and projects with the centred
             symbol sin(k dx)/dx. The source box must equal the target box: resampling changes
             resolution, never the domain.
    @param[in] nodes PICGRID node-coordinate array.
    @param[in] params Parameters normalized and converted by the conductor; `source_file`
                      absolute, lengths in solver units, `velocity_divisor` the case's
                      reference velocity.
    @param[in] context Conductor-derived diagnostic context; `runtime_ucat_output` names a
                       file to receive the reconstructed velocity of a `Ucont` result.
    @return Full field in the staged layout and diagnostic summary.
    """
    spectral = _shared("periodic_spectral")
    cells, lengths_xyz = spectral.validate_spectral_grid(nodes, subject="resampled_velocity requires")
    box = params["box_length"]
    for axis, (source_length, target_length) in enumerate(zip(box, lengths_xyz)):
        if abs(source_length - target_length) > 1e-9 * max(abs(target_length), 1.0):
            raise ValueError(f"params.box_length[{axis}] is {source_length:.12g} in solver units, but the grid's "
                             f"{'xyz'[axis]} period is {target_length:.12g}; resampling changes resolution, "
                             "not the domain.")
    field_name = params.get("field", "Ucat")
    source = read_source_velocity(params)
    source_cells_kji = source.shape[:3]
    source_energy = 0.5*float(np.mean(np.sum(source*source, axis=-1)))
    offsets = params["sample_offset"]
    source_first = [offsets[a] * lengths_xyz[a] / source_cells_kji[2 - a] for a in range(3)]
    target_first = [0.5 * lengths_xyz[a] / cells[2 - a] for a in range(3)]
    resampled = spectral.fourier_resample(source, cells, lengths_xyz, source_first, target_first, params["filter"])
    resampled_energy = 0.5*float(np.mean(np.sum(resampled*resampled, axis=-1)))
    continuum, discrete, spacing = spectral.spectral_symbols(cells, lengths_xyz)
    face_difference = tuple(2.0*np.sin(0.5*k*h)/h for k, h in zip(continuum, spacing))
    staged_symbols = face_difference if field_name == "Ucont" else discrete
    before = compute_periodic_velocity_diagnostics(resampled, lengths_xyz, 0.0)
    coeff = np.fft.fftn(resampled, axes=(0, 1, 2))
    removed_mean = resampled.mean(axis=(0, 1, 2))
    if params["remove_mean"]:
        coeff[0, 0, 0, :] = 0.0
    operator = params["projection"]
    if operator != "none":
        mean_mode = coeff[0, 0, 0, :].copy()
        coeff = project_coefficients(coeff, staged_symbols if operator == "picurv_discrete" else continuum)
        # The projector has no direction for the mean; keep it unless remove_mean took it.
        coeff[0, 0, 0, :] = mean_mode
    projected = np.fft.ifftn(coeff, axes=(0, 1, 2)).real
    projected_energy = 0.5*float(np.mean(np.sum(projected*projected, axis=-1)))
    divisor = params["velocity_divisor"]
    kinematic_viscosity = _finite_number((context or {}).get("kinematic_viscosity", 0.0),
                                         "context.kinematic_viscosity", nonnegative=True)
    summary = {"generator": "resampled_velocity", "field": field_name,
               "source_file": params["source_file"], "format": params["format"],
               "source_cells_xyz": [int(source_cells_kji[2]), int(source_cells_kji[1]), int(source_cells_kji[0])],
               "target_cells_xyz": [int(cells[2]), int(cells[1]), int(cells[0])],
               "sample_offset": offsets, "filter": params["filter"], "projection": operator,
               "remove_mean": params["remove_mean"], "velocity_divisor": divisor,
               "source_kinetic_energy_physical": source_energy,
               "resampled_kinetic_energy_physical": resampled_energy,
               "projected_kinetic_energy_physical": projected_energy,
               "projection_removed_energy_fraction": (resampled_energy - projected_energy) / resampled_energy
               if resampled_energy > 0 else 0.0,
               "source_mean_physical": [float(x) for x in removed_mean],
               "pre_projection_picurv_discrete_divergence_normalized": before["picurv_discrete_divergence_normalized"],
               "pre_projection_continuum_divergence_normalized": before["continuum_divergence_normalized"]}
    if field_name == "Ucont":
        fluxes = _staggered_fluxes(coeff, cells, lengths_xyz) / divisor
        full = _flux_storage(fluxes, cells)
        divergence = sum(np.roll(fluxes[..., a], -1, axis=2 - a) - fluxes[..., a] for a in range(3))
        runtime_ucat = _runtime_ucat_from_fluxes(fluxes, cells, lengths_xyz)
        shared = _public_diagnostics(compute_periodic_velocity_diagnostics(runtime_ucat, lengths_xyz,
                                                                            kinematic_viscosity))
        for key in [key for key in shared if key.startswith("picurv_reconstructed")]:
            shared.pop(key)
        summary.update(shared)
        cell_volume = spacing[0] * spacing[1] * spacing[2]
        summary.update({"measurement_state": "runtime_reconstructed_ucat_from_staged_fluxes",
                        "flux_divergence_max_per_volume": float(np.max(np.abs(divergence))) / cell_volume})
        target = (context or {}).get("runtime_ucat_output")
        if target:
            wrapped = tuple((np.arange(count + 2) - 1) % count for count in cells)
            write_petsc_vec_binary(target, runtime_ucat[np.ix_(*wrapped)])
    else:
        physical = projected / divisor
        wrapped = tuple((np.arange(count + 2) - 1) % count for count in cells)
        full = physical[np.ix_(*wrapped)]
        summary.update(_public_diagnostics(compute_periodic_velocity_diagnostics(physical, lengths_xyz,
                                                                                 kinematic_viscosity)))
        summary["measurement_state"] = "staged_ucat"
    summary.update({"grid_cells_storage_kji": list(cells), "box_lengths_xyz": list(lengths_xyz),
                    "vector_shape": list(full.shape), "scalar_count": int(full.size),
                    "petsc_shape": list(full.shape), "petsc_scalar_count": int(full.size)})
    return full, summary


#: Parameters the channel and duct seeds accept.
#: Parameters `spectral_velocity` accepts with walls, and those it accepts only in a periodic box.
WALL_SPECTRAL_PARAMS = frozenset({"field", "seed", "streamwise_axis", "wall_axes",
                                  "normalization", "wall_modes", "spectrum", "initial_spectra"})
PERIODIC_SPECTRAL_ONLY_PARAMS = frozenset({"random", "projection", "remove_mean"})


def validate_spectral_velocity_params(raw):
    """!
    @brief Validate `spectral_velocity`: a periodic box with no `wall_axes`, a channel with one, a duct with two.
    @param[in] raw Raw parameter mapping; velocities in solver units.
    @return Normalized parameters, `wall_axes` always present.
    """
    if not isinstance(raw, dict):
        raise ValueError("spectral_velocity params must be a mapping.")
    if "perturbation_rms" in raw:
        raise ValueError("spectral_velocity params.perturbation_rms is retired: give normalization: "
                         "{type: component_rms, target: ...}, the same volume-weighted rms.")
    walls = raw.get("wall_axes", [])
    if walls:
        periodic_only = sorted(set(raw) & PERIODIC_SPECTRAL_ONLY_PARAMS)
        if periodic_only:
            raise ValueError(f"spectral_velocity params {periodic_only} apply only to a periodic box (no wall_axes).")
        return validate_wall_spectral_params(raw)
    wall_only = sorted(set(raw) & (WALL_SPECTRAL_PARAMS - {"field", "seed", "spectrum", "normalization", "wall_axes"}))
    if wall_only:
        raise ValueError(f"spectral_velocity params {wall_only} need wall_axes.")
    return dict(validate_periodic_spectral_params({k: v for k, v in raw.items() if k != "wall_axes"}),
                wall_axes=[])


def validate_wall_spectral_params(raw):
    """!
    @brief Validate a channel or duct seed; axes use Cartesian i/j/k order, velocities solver units.
    @param[in] raw Raw parameter mapping with one or two `wall_axes`.
    @return Normalized wall-seed parameters.
    """
    if isinstance(raw, dict) and "bulk_velocity" in raw:
        raise ValueError("spectral_velocity generates fluctuations only: remove bulk_velocity and add a mean with "
                         "source: {sum: [mean, generator]} and constraints: {bulk_velocity: ...}.")
    if not isinstance(raw, dict) or set(raw) - WALL_SPECTRAL_PARAMS:
        raise ValueError("spectral_velocity with walls has unsupported parameters.")
    if raw.get("field", "Ucat") != "Ucat":
        raise ValueError("spectral_velocity requires field: Ucat.")
    walls = raw.get("wall_axes")
    stream = raw.get("streamwise_axis", "k")
    if (not isinstance(walls, list) or len(walls) not in (1, 2) or any(a not in ("i", "j", "k") for a in walls)
            or len(set(walls)) != len(walls)
            or stream not in ("i", "j", "k") or stream in walls):
        raise ValueError("wall_axes must name a channel's one or a duct's two axes; streamwise_axis another.")
    # The envelope shapes the vector potential, not a promised isotropic velocity spectrum
    # after the curl and wall envelope.
    seed, spectrum = _validate_seed_spectrum(raw.get("seed", 12345), raw.get("spectrum", {"type": "white"}))
    if seed < 0:
        raise ValueError("seed must be non-negative.")
    modes = raw.get("wall_modes", 3)
    if isinstance(modes, bool) or not isinstance(modes, int) or modes < 1:
        raise ValueError("wall_modes must be a positive integer.")
    normalization = raw.get("normalization", {"type": "component_rms", "target": 0.1})
    if (not isinstance(normalization, dict) or set(normalization) != {"type", "target"}
            or normalization["type"] != "component_rms"):
        raise ValueError("spectral_velocity with walls needs normalization: {type: component_rms, target: ...}: "
                         "the curl of the vector potential has no amplitude of its own.")
    target = _finite_number(normalization["target"], "normalization.target", positive=True)
    return {"field": "Ucat", "seed": seed, "spectrum": spectrum,
            "wall_axes": walls, "streamwise_axis": stream, "wall_modes": modes,
            "normalization": {"type": "component_rms", "target": target},
            **({"initial_spectra": raw["initial_spectra"]} if "initial_spectra" in raw else {})}


def cartesian_flux_derivative(values, widths, axis, periodic):
    """!
    @brief Cell divergence of arithmetic face averages, with zero wall-face flux.
    @param[in] values Cell-centered Cartesian scalar samples.
    @param[in] widths Physical cell widths on the derivative axis.
    @param[in] axis Cartesian axis number, x=0 through z=2.
    @param[in] periodic Whether boundary faces wrap rather than carry zero flux.
    @return Cell-centered finite-volume derivative in storage order.

    This offline operator mirrors Cart2Contra followed by finite-volume divergence
    on a separable Cartesian grid. Tensor-product operators commute, so their curl
    is in this divergence's nullspace even on stretched wall axes.
    """
    storage_axis = 2 - axis
    moved = np.moveaxis(values, storage_axis, 0)
    faces = 0.5 * (moved[:-1] + moved[1:])
    boundary = 0.5 * (moved[-1:] + moved[:1]) if periodic else np.zeros_like(moved[:1])
    flux = np.concatenate((boundary, faces, boundary), axis=0)
    derivative = np.diff(flux, axis=0) / widths.reshape((-1,) + (1,)*(moved.ndim-1))
    return np.moveaxis(derivative, 0, storage_axis)


def discrete_curl(potential, widths, periodic):
    """!
    @brief Cell-centred curl of a vector potential, its derivatives cartesian_flux_derivative()'s.
    @details Tensor-product derivatives commute, so the result is in the nullspace of
             discrete_divergence() on the same grid.
    @param[in] potential Cell-centred vector potential in k/j/i/component order.
    @param[in] widths Physical cell widths per Cartesian axis.
    @param[in] periodic Cartesian axes whose boundary faces wrap.
    @return Cell-centred velocity in k/j/i/component order.
    """
    def derivative(values, axis):
        """!
        @brief One derivative under the grid's widths and boundary topology.
        @param[in] values Scalar component.
        @param[in] axis Cartesian derivative axis.
        @return Cell-centred derivative.
        """
        return cartesian_flux_derivative(values, widths[axis], axis, axis in periodic)
    return np.stack([derivative(potential[..., (a+2) % 3], (a+1) % 3)
                     - derivative(potential[..., (a+1) % 3], (a+2) % 3) for a in range(3)], axis=-1)


def discrete_divergence(velocity, widths, periodic):
    """!
    @brief Cell divergence of a cell-centred velocity, under cartesian_flux_derivative().
    @param[in] velocity Cell-centred velocity in k/j/i/component order.
    @param[in] widths Physical cell widths per Cartesian axis.
    @param[in] periodic Cartesian axes whose boundary faces wrap.
    @return Cell-centred divergence.
    """
    return sum(cartesian_flux_derivative(velocity[..., a], widths[a], a, a in periodic) for a in range(3))


def cell_volumes(widths):
    """!
    @brief Cell volumes of a separable grid.
    @param[in] widths Physical cell widths per Cartesian axis.
    @return Volumes in storage (k, j, i) order.
    """
    return widths[2][:, None, None]*widths[1][None, :, None]*widths[0][None, None, :]


def volume_weighted_rms(field, volume):
    """!
    @brief Component rms of a cell-centred vector field, each cell weighted by its volume.
    @param[in] field Cell-centred vector field in k/j/i/component order.
    @param[in] volume Cell volumes from cell_volumes().
    @return sqrt(sum V |u|^2 / (3 sum V)).
    """
    return np.sqrt(np.sum(volume*np.sum(field**2, axis=-1))/(3*np.sum(volume)))


def with_dummy_layers(field, periodic):
    """!
    @brief Add PICurv's one-cell dummy layer to a cell-centred Ucat field.
    @param[in] field Cell-centred Cartesian velocity in k/j/i/component order.
    @param[in] periodic Cartesian axes (x=0 through z=2) whose dummies wrap.
    @return Field with dummies: periodic dummies wrap, the others reflect oddly about the
            face, so the face average is zero (a no-slip wall the runtime then repairs).
    """
    full = field
    for a in range(3):
        sa = 2-a
        if a in periodic:
            full = np.concatenate((np.take(full, [-1], axis=sa), full, np.take(full, [0], axis=sa)), axis=sa)
        else:
            full = np.concatenate((-np.take(full, [0], axis=sa), full, -np.take(full, [-1], axis=sa)), axis=sa)
    return full


def wall_seed_perturbation(cells, lengths, axes, widths, centers, walls, periodic, seed, spectrum, wall_modes,
                           planar_axis=None):
    """!
    @brief Seeded divergence-free perturbation: the discrete curl of a random vector potential.
    @details The potential is spectrally shaped along the periodic axes and spanned by
             `wall_modes` sine modes times a sin(pi t) envelope along each wall axis, so it and
             its wall-normal derivative vanish at the walls and the curl satisfies no-slip.
    @param[in] cells Cell counts in storage (k, j, i) order.
    @param[in] lengths Physical box lengths in Cartesian order.
    @param[in] axes Node coordinates per Cartesian axis.
    @param[in] widths Cell widths per Cartesian axis.
    @param[in] centers Cell-centre coordinates per Cartesian axis.
    @param[in] walls Cartesian wall axes.
    @param[in] periodic Cartesian periodic axes, uniform.
    @param[in] seed Random seed.
    @param[in] spectrum Validated spectrum mapping.
    @param[in] wall_modes Sine modes across each wall axis.
    @param[in] planar_axis Optional periodic axis the perturbation must not vary along or
               point along: only the potential's component on it is kept, at zero wavenumber
               on it, so the curl lies in the other two axes' plane.
    @return Cell-centred velocity in k/j/i/component order, free of discrete_divergence().
    """
    shape = list(cells)
    for a in walls:
        # sin(pi t) raises the highest sine index of sin(n pi t) by one.
        if wall_modes + 1 > cells[2-a] // 2:
            raise ValueError("wall_modes plus the wall envelope are unresolved on this grid.")
        shape[2-a] = wall_modes
    if planar_axis is not None:
        shape[2-planar_axis] = 1
    potential = np.random.default_rng(seed).standard_normal((*shape, 3))
    if planar_axis is not None:
        potential[..., [a for a in range(3) if a != planar_axis]] = 0.0
    fft_axes = tuple(2-a for a in periodic)
    coeff = np.fft.fftn(potential, axes=fft_axes)
    kmag2 = np.zeros(shape)
    active = np.ones(shape, dtype=bool)
    for a in periodic:
        n = shape[2-a]
        k = 2*np.pi*np.fft.fftfreq(n, d=widths[a][0])
        sh = [1, 1, 1]; sh[2-a] = n
        kmag2 += k.reshape(sh)**2
        active &= (np.abs(np.fft.fftfreq(n)*n) < n/3).reshape(sh) if n > 1 else np.ones(sh, dtype=bool)
    kmag = np.sqrt(kmag2)
    cutoff = spectrum.get("k_cut")
    limit = min(2*np.pi/(3*widths[a][0]) for a in periodic)
    if cutoff is not None and cutoff > limit*(1+1e-12):
        raise ValueError("spectrum.k_cut exceeds the periodic two-thirds-resolution limit.")
    coeff *= (spectral_envelope(kmag, spectrum, min(2*np.pi/lengths[a] for a in periodic))
              * active * (kmag > 0))[..., None]
    potential = np.fft.ifftn(coeff, axes=fft_axes).real
    if planar_axis is not None:
        potential = np.repeat(potential, cells[2-planar_axis], axis=2-planar_axis)
    for a in walls:
        t = (centers[a]-axes[a][0])/lengths[a]
        # One power of the envelope is the least that keeps the potential and its
        # wall-normal derivative zero at the wall, so the curl satisfies no-slip with
        # the physical asymptotics: wall-parallel u' ~ y, wall-normal v' ~ y^2. A
        # higher power would starve the buffer layer (sin^4 left u' ~ y^4, 1e-3 of a
        # developed flow's at y+ ~ 13 on the Re_tau = 180 channel).
        basis = np.sin(np.pi*t[:, None]*np.arange(1, wall_modes+1)) * np.sin(np.pi*t[:, None])
        potential = np.moveaxis(np.tensordot(basis, potential, axes=(1, 2-a)), 0, 2-a)
    return discrete_curl(potential, widths, periodic)


def generate_spectral_velocity(nodes, raw_params, context=None):
    """!
    @brief Generate `spectral_velocity`: a periodic box's spectral field, or a channel's or duct's seed.
    @param[in] nodes PICGRID node coordinates in k/j/i/component order.
    @param[in] raw_params Raw parameters; `wall_axes` chooses the geometry.
    @param[in] context Conductor-derived diagnostic context.
    @return Full Ucat array with dummies and diagnostic summary.
    """
    params = validate_spectral_velocity_params(raw_params)
    if params["wall_axes"]:
        return generate_wall_spectral_velocity(nodes, params)
    return generate_periodic_spectral_velocity(nodes, {k: v for k, v in params.items() if k != "wall_axes"}, context)


def generate_wall_spectral_velocity(nodes, params):
    """!
    @brief Generate a seeded discrete-curl perturbation, a velocity fluctuation with no added mean.
    @param[in] nodes PICGRID node coordinates in k/j/i/component order.
    @param[in] params Parameters normalized by validate_wall_spectral_params().
    @return Full Ucat array with dummies and diagnostic summary.

    Single-block Cartesian Ucat, stored k/j/i/component with one dummy layer.
    No MPI state is generated: runtime owns scatter, wall repair and reconstruction.
    Periodic axes are uniform; wall axes may stretch. The curl reads one neighbor.
    """
    walls = ["ijk".index(a) for a in params["wall_axes"]]
    periodic = [a for a in range(3) if a not in walls]
    cells, lengths = _shared("periodic_spectral").validate_spectral_grid(nodes, periodic, subject="spectral_velocity requires")
    axes = (nodes[0, 0, :, 0], nodes[0, :, 0, 1], nodes[:, 0, 0, 2])
    widths = [np.diff(a) for a in axes]
    centers = [0.5*(a[:-1]+a[1:]) for a in axes]
    velocity = wall_seed_perturbation(cells, lengths, axes, widths, centers, walls, periodic,
                                      params["seed"], params["spectrum"], params["wall_modes"])
    volume = cell_volumes(widths)
    rms = volume_weighted_rms(velocity, volume)
    if not np.isfinite(rms) or rms <= 0:
        raise ValueError("selected spectrum contains no active perturbation modes.")
    velocity *= params["normalization"]["target"]/rms
    divergence = discrete_divergence(velocity, widths, periodic)
    perturbation_means = np.sum(velocity*volume[..., None], axis=(0,1,2))/np.sum(volume)
    component_rms = [float(np.sqrt(np.sum(volume*velocity[..., a]**2)/np.sum(volume))) for a in range(3)]
    full = with_dummy_layers(velocity, periodic)
    return full, {"generator": "spectral_velocity", "field": "Ucat", "params": params,
        "vector_shape": list(full.shape), "scalar_count": int(full.size),
        "perturbation_component_rms": component_rms,
        "perturbation_rms": float(np.sqrt(np.mean(np.square(component_rms)))),
        "perturbation_component_means": perturbation_means.tolist(),
        "picurv_discrete_divergence_max": float(np.max(np.abs(divergence))),
        "spectrum_applies_to": "vector_potential_periodic_modes",
        "measurement_state": "generated_Ucat_before_runtime_reconstruction"}


#: Parameters `stability_mode_velocity` accepts, and those of its `modes` entries and `noise`.
STABILITY_MODE_PARAMS = frozenset({"field", "streamwise_axis", "cross_axis", "base_profile", "equation",
                                   "modes", "velocity_difference", "eigen_points", "noise", "initial_spectra"})
STABILITY_MODE_ENTRY_PARAMS = frozenset({"harmonic", "amplitude", "phase"})
STABILITY_NOISE_PARAMS = frozenset({"rms", "seed", "spectrum", "wall_modes", "planar"})
#: Cartesian coordinate name of each logical axis on an axis-aligned grid.
AXIS_COORDINATE = {"i": "x", "j": "y", "k": "z"}


def validate_stability_mode_params(raw):
    """!
    @brief Validate `stability_mode_velocity` parameters; velocities physical, amplitudes fractions of dU.
    @param[in] raw Raw parameter mapping.
    @return Normalized parameters.
    """
    if not isinstance(raw, dict) or set(raw) - STABILITY_MODE_PARAMS:
        raise ValueError(f"stability_mode_velocity accepts only: {', '.join(sorted(STABILITY_MODE_PARAMS))}.")
    if raw.get("field", "Ucat") != "Ucat":
        raise ValueError("stability_mode_velocity requires field: Ucat.")
    stream, cross = raw.get("streamwise_axis", "k"), raw.get("cross_axis", "j")
    if stream not in ("i", "j", "k") or cross not in ("i", "j", "k") or stream == cross:
        raise ValueError("streamwise_axis and cross_axis must be two different axes of i, j, k.")
    if raw.get("equation", "rayleigh") != "rayleigh":
        raise ValueError("stability_mode_velocity supports only equation: rayleigh.")
    profile = raw.get("base_profile")
    if not isinstance(profile, str) or not profile.strip():
        raise ValueError("base_profile must be an expression of the cross-stream coordinate.")
    _shared("source_expressions").validate_expression(profile, names=frozenset({AXIS_COORDINATE[cross]}))
    modes = raw.get("modes")
    if not isinstance(modes, list) or not modes:
        raise ValueError("modes must be a nonempty list of {harmonic, amplitude, phase}.")
    normalized_modes = []
    for index, mode in enumerate(modes):
        if not isinstance(mode, dict) or set(mode) - STABILITY_MODE_ENTRY_PARAMS or "harmonic" not in mode:
            raise ValueError(f"modes[{index}] needs harmonic, and optionally amplitude and phase.")
        harmonic = mode["harmonic"]
        if isinstance(harmonic, bool) or not isinstance(harmonic, int) or harmonic < 1:
            raise ValueError(f"modes[{index}].harmonic must be a positive integer.")
        normalized_modes.append({"harmonic": harmonic,
            "amplitude": _finite_number(mode.get("amplitude", 0.01), f"modes[{index}].amplitude", positive=True),
            "phase": _finite_number(mode.get("phase", 0.0), f"modes[{index}].phase")})
    if len({m["harmonic"] for m in normalized_modes}) != len(normalized_modes):
        raise ValueError("each harmonic may appear in modes only once.")
    points = raw.get("eigen_points", 401)
    if isinstance(points, bool) or not isinstance(points, int) or points < 51:
        raise ValueError("eigen_points must be an integer of at least 51.")
    params = {"field": "Ucat", "streamwise_axis": stream, "cross_axis": cross,
              "base_profile": profile.strip(), "equation": "rayleigh",
              "modes": normalized_modes, "eigen_points": points}
    if "velocity_difference" in raw:
        params["velocity_difference"] = _finite_number(raw["velocity_difference"], "velocity_difference", positive=True)
    noise = raw.get("noise")
    if noise is not None:
        if not isinstance(noise, dict) or set(noise) - STABILITY_NOISE_PARAMS or "rms" not in noise:
            raise ValueError(f"noise needs rms and accepts: {', '.join(sorted(STABILITY_NOISE_PARAMS))}.")
        seed, spectrum = _validate_seed_spectrum(noise.get("seed", 12345), noise.get("spectrum", {"type": "white"}),
                                                 "noise")
        modes_across = noise.get("wall_modes", 8)
        if isinstance(modes_across, bool) or not isinstance(modes_across, int) or modes_across < 1:
            raise ValueError("noise.wall_modes must be a positive integer.")
        if not isinstance(noise.get("planar", False), bool):
            raise ValueError("noise.planar must be true or false.")
        params["noise"] = {"rms": _finite_number(noise["rms"], "noise.rms", positive=True),
                           "seed": seed, "spectrum": spectrum,
                           "wall_modes": modes_across, "planar": noise.get("planar", False)}
    if "initial_spectra" in raw:
        params["initial_spectra"] = raw["initial_spectra"]
    return params


def rayleigh_unstable_mode(y, base, alpha):
    """!
    @brief Most unstable temporal mode of the inviscid Rayleigh equation on [y_0, y_N].
    @details Solves (U - c)(phi'' - alpha^2 phi) - U'' phi = 0 with phi = 0 at both ends, by
             second-order differences on the uniform grid `y`, as the generalized eigenproblem
             A phi = c B phi, B = D2 - alpha^2, A = U B - U''. B is negative definite, so the
             problem reduces to the eigenvalues of B^-1 A.
    @param[in] y Uniform grid including both ends.
    @param[in] base Base velocity U on `y`.
    @param[in] alpha Streamwise wavenumber.
    @return Complex phase speed c (None when no mode grows) and phi on `y` (zero at the ends).
    """
    h = y[1] - y[0]
    n = len(y) - 2
    upp = (base[2:] - 2.0*base[1:-1] + base[:-2]) / h**2
    d2 = (np.diag(-2.0*np.ones(n)) + np.diag(np.ones(n-1), 1) + np.diag(np.ones(n-1), -1)) / h**2
    b = d2 - alpha**2*np.eye(n)
    a = base[1:-1, None]*b - np.diag(upp)
    values, vectors = np.linalg.eig(np.linalg.solve(b, a))
    best = int(np.argmax(values.imag))
    scale = max(np.max(np.abs(base)), np.finfo(float).tiny)
    if not values[best].imag > 1.0e-8*scale:
        return None, None
    phi = np.zeros(len(y), dtype=complex)
    phi[1:-1] = vectors[:, best] / vectors[np.argmax(np.abs(vectors[:, best])), best]
    return values[best], phi


def generate_stability_mode_velocity(nodes, raw_params, context=None):
    """!
    @brief Parallel base flow plus most-unstable inviscid eigenmodes and optional broadband noise.
    @details u = U(y) e_s + sum_m Re[curl(psi_m e_n)] + noise, with psi_m the Rayleigh
             eigenfunction at alpha_m = 2 pi n_m / L_s, each scaled so its streamwise
             fluctuation peaks at amplitude_m * dU. The curl is PICurv's discrete one, so the
             field is discretely divergence-free; the noise is the wall-seed perturbation with
             the cross-stream ends as its walls.
    @param[in] nodes Nondimensional PICGRID coordinates in k/j/i/component order.
    @param[in] raw_params Raw provider parameters, dimensional values already in solver units
               except the base-profile expression.
    @param[in] context Conductor context with `length_ref` and `velocity_ref`.
    @return Full Ucat array with dummies and diagnostic summary.
    """
    params = validate_stability_mode_params(raw_params)
    context = context or {}
    length_ref = float(context.get("length_ref", 1.0))
    velocity_ref = float(context.get("velocity_ref", 1.0))
    stream, cross = "ijk".index(params["streamwise_axis"]), "ijk".index(params["cross_axis"])
    normal = 3 - stream - cross
    periodic = [stream, normal]
    cells, lengths = _shared("periodic_spectral").validate_spectral_grid(
        nodes, periodic, subject="stability_mode_velocity requires")
    axes = (nodes[0, 0, :, 0], nodes[0, :, 0, 1], nodes[:, 0, 0, 2])
    widths = [np.diff(a) for a in axes]
    centers = [0.5*(a[:-1]+a[1:]) for a in axes]
    name = AXIS_COORDINATE[params["cross_axis"]]

    def profile(y):
        """!
        @brief Evaluate the physical base-profile expression in solver units.
        @param[in] y Nondimensional cross-stream coordinates.
        @return Base velocity in solver units.
        """
        values = _shared("source_expressions").evaluate_values(params["base_profile"], {name: y*length_ref}) * np.ones_like(y)
        if not np.all(np.isfinite(values)):
            raise ValueError("base_profile is not finite on the cross-stream extent.")
        return values / velocity_ref

    y_ends = (axes[cross][0], axes[cross][-1])
    y_eig = np.linspace(*y_ends, params["eigen_points"])
    u_eig = profile(y_eig)
    delta_u = params.get("velocity_difference", abs(u_eig[-1] - u_eig[0]))
    if not delta_u > 0:
        raise ValueError("base_profile has no velocity difference across the cross-stream extent; "
                         "set velocity_difference.")
    shape = [1, 1, 1]; shape[2-cross] = cells[2-cross]
    velocity = np.zeros((*cells, 3))
    velocity[..., stream] += profile(centers[cross]).reshape(shape)

    s_shape = [1, 1, 1]; s_shape[2-stream] = cells[2-stream]
    s = (centers[stream] - axes[stream][0]).reshape(s_shape)
    mode_summaries = []
    for mode in params["modes"]:
        n = mode["harmonic"]
        if 3*n >= cells[2-stream]:
            raise ValueError(f"harmonic {n} is beyond the two-thirds limit of {cells[2-stream]} streamwise cells.")
        alpha = 2*np.pi*n/lengths[stream]
        c, phi = rayleigh_unstable_mode(y_eig, u_eig, alpha)
        if c is None:
            raise ValueError(f"base_profile has no unstable Rayleigh mode at harmonic {n} (alpha = {alpha:.6g}).")
        phi_cells = (np.interp(centers[cross], y_eig, phi.real)
                     + 1j*np.interp(centers[cross], y_eig, phi.imag)).reshape(shape)
        potential = np.zeros((*cells, 3))
        potential[..., normal] = np.real(phi_cells*np.exp(1j*(alpha*s + mode["phase"])))
        field = discrete_curl(potential, widths, periodic)
        # The streamwise fluctuation of one sinusoid peaks at sqrt(2) times its rms along s.
        peak = np.max(np.sqrt(2.0*np.mean(field[..., stream]**2, axis=(2-stream, 2-normal))))
        field *= mode["amplitude"]*delta_u/peak
        velocity += field
        end_amplitude = max(float(np.max(np.abs(np.take(field[..., stream], 0, axis=2-cross)))),
                            float(np.max(np.abs(np.take(field[..., stream], -1, axis=2-cross)))))
        mode_summaries.append({"harmonic": n, "alpha": float(alpha),
            "alpha_physical": float(alpha/length_ref), "phase_speed": [float(c.real), float(c.imag)],
            "growth_rate": float(alpha*c.imag), "growth_rate_physical": float(alpha*c.imag*velocity_ref/length_ref),
            "amplitude": mode["amplitude"], "cross_end_streamwise_amplitude_over_dU": end_amplitude/delta_u})

    noise_rms = None
    if "noise" in params:
        noise = params["noise"]
        perturbation = wall_seed_perturbation(
            cells, lengths, axes, widths, centers, [cross], periodic, noise["seed"], noise["spectrum"],
            noise["wall_modes"], planar_axis=normal if noise["planar"] else None)
        rms = volume_weighted_rms(perturbation, cell_volumes(widths))
        if not np.isfinite(rms) or rms <= 0:
            raise ValueError("noise spectrum contains no active perturbation modes.")
        velocity += perturbation*noise["rms"]*delta_u/rms
        noise_rms = float(noise["rms"]*delta_u)

    # The streamwise harmonics this grid resolves, and the fastest-growing of them: a guide
    # for sizing the box, on a coarser eigen grid than the modes themselves.
    scan = []
    y_scan = np.linspace(*y_ends, min(params["eigen_points"], 201))
    u_scan = profile(y_scan)
    for n in range(1, min(32, (cells[2-stream]-1)//3) + 1):
        c, _ = rayleigh_unstable_mode(y_scan, u_scan, 2*np.pi*n/lengths[stream])
        scan.append({"harmonic": n, "growth_rate": float(2*np.pi*n/lengths[stream]*c.imag) if c is not None else 0.0})
    fastest = max(scan, key=lambda entry: entry["growth_rate"]) if scan else None
    divergence = discrete_divergence(velocity, widths, periodic)
    full = with_dummy_layers(velocity, periodic)
    return full, {"generator": "stability_mode_velocity", "field": "Ucat", "params": params,
        "vector_shape": list(full.shape), "scalar_count": int(full.size),
        "velocity_difference": float(delta_u), "modes": mode_summaries, "noise_rms": noise_rms,
        "harmonic_growth_scan": scan, "harmonic_growth_scan_eigen_points": len(y_scan),
        "fastest_growing_harmonic": fastest,
        "picurv_discrete_divergence_max": float(np.max(np.abs(divergence))),
        "measurement_state": "generated_Ucat_before_runtime_reconstruction"}


def build_parser():
    """!
    @brief Build the command-line parser.
    @return Configured parser.
    """
    parser = argparse.ArgumentParser(description="Generate a PICurv initial-condition PETSc vector.")
    parser.add_argument("--generator", choices=("spectral_velocity", "resampled_velocity",
                                                "stability_mode_velocity"),
                        required=True, help="Maintained IC generator implementation.")
    parser.add_argument("--params-json", help="JSON parameters for a built-in generator.")
    parser.add_argument("--context-json", help="Conductor-derived diagnostic context.")
    parser.add_argument("--output", required=True, help="Output PETSc binary vector.")
    parser.add_argument("--grid", help="Canonical nondimensional PICGRID; defaults to grid.run beside output.")
    parser.add_argument("--summary-json", help="Optional summary JSON path.")
    parser.add_argument("--petsc-index-bytes", type=int, choices=(4, 8), default=4,
                        help="Bytes of a PetscInt in the PETSc that will read the output (4 or 8).")
    return parser


def main(argv=None) -> int:
    """!
    @brief Generate the requested initial-condition PETSc vector from its parameters and a PICGRID.
    @param[in] argv Optional argument override.
    @return Process exit code.
    """
    args = build_parser().parse_args(argv)
    global PETSC_INDEX_BYTES
    PETSC_INDEX_BYTES = args.petsc_index_bytes
    try:
        grid_path = args.grid or os.path.join(os.path.dirname(os.path.abspath(args.output)), "grid.run")
        dims, nodes = read_picgrid(grid_path)
        if args.generator == "spectral_velocity":
            if not args.params_json:
                raise ValueError("spectral_velocity generation requires --params-json.")
            field, summary = generate_spectral_velocity(
                nodes, json.loads(args.params_json), json.loads(args.context_json or "{}")
            )
        elif args.generator == "resampled_velocity":
            if not args.params_json:
                raise ValueError("resampled_velocity generation requires --params-json.")
            field, summary = generate_resampled_velocity(
                nodes, json.loads(args.params_json), json.loads(args.context_json or "{}")
            )
        elif args.generator == "stability_mode_velocity":
            field, summary = generate_stability_mode_velocity(
                nodes, json.loads(args.params_json or "{}"), json.loads(args.context_json or "{}"))
        write_petsc_vec_binary(args.output, field)
        summary.update({"grid": os.path.abspath(grid_path), "output": os.path.abspath(args.output),
                        "grid_dims": list(dims)})
        if args.summary_json:
            summary_dir = os.path.dirname(os.path.abspath(args.summary_json))
            os.makedirs(summary_dir, exist_ok=True)
            # The summary is asset payload built in a temporary directory; absolute
            # paths would make identical fields publish as different assets. Record
            # them relative to the summary so they resolve wherever it is materialized.
            stored = dict(summary)
            for key in ("grid", "output"):
                if isinstance(stored.get(key), str):
                    stored[key] = os.path.relpath(stored[key], summary_dir)
            with open(args.summary_json, "w", encoding="utf-8") as fout:
                json.dump(stored, fout, indent=2, sort_keys=True)
                fout.write("\n")
        print(json.dumps(summary, sort_keys=True))
        return 0
    except Exception as exc:
        print(f"[ERROR] ic.gen failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
