"""! @file grid.gen
    @brief A command-line utility for generating 3D all-hexahedral structured grids.
"""

"""
Curvilinear Grid Generation Tool

A command-line utility for generating high-quality, 3D, all-hexahedral structured
grids, with a logical indexing convention suitable for CFD applications.

Logical Coordinate System:
- i (xi): First cross-sectional direction.
- j (eta): Second cross-sectional direction.
- k (zeta): Streamwise direction along the primary path.

This script can be controlled via command-line arguments or a configuration file.
"""

import argparse
import configparser
import os
import sys
from typing import Any, Dict, List, Optional, Tuple

import numpy as np

# Type alias for grid coordinates for clarity
GridCoords = Tuple[np.ndarray, np.ndarray, np.ndarray]

# Canonical PICGRID coordinates use round-trip-safe binary64 text precision.
PICGRID_FLOAT_FORMAT = ".17e"

# --- NEW: Helper function for hyperbolic stretching ---
def create_stretched_linspace(
    num_points: int, stretch_factor: float,
    min_val: float, max_val: float,
    first_cell_start: float = None, first_cell_end: float = None
) -> np.ndarray:
    """!
    @brief Generates a 1D array of points with hyperbolic tangent stretching.
    @param num_points The number of points in the array.
    @param stretch_factor Controls the intensity of clustering. A value of 0 means
                          uniform spacing. Values > 1 create noticeable clustering
                          at the boundaries.
    @param min_val The minimum value of the output array.
    @param max_val The maximum value of the output array.
    @param first_cell_start Desired size of first cell at start (normalized). If specified,
                            overrides stretch_factor for one-sided stretching from start.
    @param first_cell_end Desired size of first cell at end (normalized). If specified,
                          overrides stretch_factor for one-sided stretching from end.
    @return A NumPy array with the stretched coordinates.
    """
    domain_length = max_val - min_val
    num_cells = num_points - 1

    if num_cells == 0:
        # Every other path returns (positions, factor); returning a bare array here made a
        # single-node axis raise on the caller's unpack instead of degenerating cleanly.
        return np.array([min_val]), 0.0

    # Determine stretching mode
    use_geometric = first_cell_start is not None or first_cell_end is not None
    use_hyperbolic = stretch_factor > 1e-6

    # Mode 1: Only first cell specified (no stretch factor) - use geometric progression
    if use_geometric and not use_hyperbolic:
        if first_cell_start is not None and first_cell_end is not None:
            # Two-sided stretching
            n_half = num_cells // 2
            # From start
            r1 = compute_geometric_ratio(n_half, domain_length/2, first_cell_start)
            dist1 = np.zeros(n_half + 1)
            for i in range(n_half):
                dist1[i+1] = dist1[i] + first_cell_start * r1**i
            # From end
            n_remain = num_cells - n_half
            r2 = compute_geometric_ratio(n_remain, domain_length/2, first_cell_end)
            dist2 = np.zeros(n_remain + 1)
            for i in range(n_remain):
                dist2[i+1] = dist2[i] + first_cell_end * r2**(n_remain-1-i)
            # Combine and normalize
            combined = np.concatenate([dist1[:-1], domain_length/2 + dist2])
            combined = combined / combined[-1] * domain_length
            return min_val + combined, 0.0  # No tanh stretch factor for geometric
        elif first_cell_start is not None:
            # One-sided from start
            r = compute_geometric_ratio(num_cells, domain_length, first_cell_start)
            dist = np.zeros(num_points)
            for i in range(num_cells):
                dist[i+1] = dist[i] + first_cell_start * r**i
            # Normalize to exact domain length
            dist = dist / dist[-1] * domain_length
            return min_val + dist, 0.0  # No tanh stretch factor for geometric
        else:
            # One-sided from end
            r = compute_geometric_ratio(num_cells, domain_length, first_cell_end)
            dist = np.zeros(num_points)
            for i in range(num_cells):
                dist[i+1] = dist[i] + first_cell_end * r**(num_cells-1-i)
            # Normalize to exact domain length
            dist = dist / dist[-1] * domain_length
            return min_val + dist, 0.0  # No tanh stretch factor for geometric

    # Mode 2: Hyperbolic tangent stretching (with or without first cell constraint)
    if not use_hyperbolic:
        return np.linspace(min_val, max_val, num_points), 0.0

    # Mode 2a: When first_cell is specified, find the stretch_factor that naturally produces it
    # This maintains smooth tanh clustering without rescaling
    if use_geometric:
        # We need to find stretch_factor such that the tanh distribution naturally produces
        # the desired first cell size. This is an inverse problem solved via bisection.

        def compute_first_cell_for_stretch(sf):
            """!
            @brief Helper: compute first cell size for a given stretch factor
            @param[in] sf Argument passed to `compute_first_cell_for_stretch()`.
            @return Value returned by `compute_first_cell_for_stretch()`.
            """
            if sf < 1e-10:
                # Uniform spacing
                return domain_length / num_cells
            uniform = np.linspace(-1.0, 1.0, num_points)
            stretched = np.tanh(sf * uniform) / np.tanh(sf)
            pos = min_val + domain_length * (stretched + 1.0) / 2.0
            return pos[1] - pos[0]  # First cell at start

        # For symmetric tanh, first_cell_start == first_cell_end
        # If they differ, we can't achieve it with symmetric tanh - fall back to geometric
        if first_cell_start is not None and first_cell_end is not None:
            if abs(first_cell_start - first_cell_end) / max(first_cell_start, first_cell_end) > 0.01:
                # Asymmetric - fall back to geometric progression
                print("WARNING: Asymmetric first cell sizes specified with tanh stretching.")
                print("         Tanh is symmetric. Using geometric progression instead.")
                return create_stretched_linspace(num_points, 0.0, min_val, max_val,
                                                first_cell_start, first_cell_end)
            target_first_cell = (first_cell_start + first_cell_end) / 2.0
        elif first_cell_start is not None:
            target_first_cell = first_cell_start
        else:
            target_first_cell = first_cell_end

        # Use bisection to find the right stretch_factor
        # For tanh, larger stretch_factor => smaller first cell
        # We need to find sf such that compute_first_cell_for_stretch(sf) == target_first_cell

        # Determine search bounds
        # Uniform case: first_cell = domain_length / num_cells
        uniform_first_cell = domain_length / num_cells

        if target_first_cell >= uniform_first_cell * 0.999:
            # Want uniform or nearly uniform spacing
            stretch_factor = 0.0
        else:
            # Binary search for the right stretch_factor
            sf_low, sf_high = 0.0, 20.0

            # Check if target is achievable
            max_first_cell = compute_first_cell_for_stretch(0.0)  # Uniform
            min_first_cell = compute_first_cell_for_stretch(20.0)  # Highly stretched

            if target_first_cell > max_first_cell * 1.01:
                print(f"WARNING: Requested first cell ({target_first_cell:.6f}) larger than uniform ({max_first_cell:.6f}).")
                print(f"         Using uniform spacing.")
                stretch_factor = 0.0
            elif target_first_cell < min_first_cell * 0.99:
                print(f"WARNING: Requested first cell ({target_first_cell:.6f}) too small (min achievable: {min_first_cell:.6f}).")
                print(f"         Using maximum stretching (sf=20.0).")
                stretch_factor = 20.0
            else:
                # Bisection search
                for _ in range(50):
                    sf_mid = (sf_low + sf_high) / 2.0
                    first_cell_mid = compute_first_cell_for_stretch(sf_mid)

                    if abs(first_cell_mid - target_first_cell) < 1e-10:
                        break

                    if first_cell_mid > target_first_cell:
                        # Need more stretching (larger sf)
                        sf_low = sf_mid
                    else:
                        # Need less stretching (smaller sf)
                        sf_high = sf_mid

                stretch_factor = (sf_low + sf_high) / 2.0

    # Now generate the tanh distribution with the (possibly adjusted) stretch_factor
    uniform_dist = np.linspace(-1.0, 1.0, num_points)
    stretched_dist = np.tanh(stretch_factor * uniform_dist) / np.tanh(stretch_factor)
    positions = min_val + (max_val - min_val) * (stretched_dist + 1.0) / 2.0

    return positions, stretch_factor

def compute_geometric_ratio(num_cells: int, total_length: float, first_cell: float) -> float:
    """!
    @brief Computes geometric growth ratio for given first cell size.
    @param num_cells Number of cells.
    @param total_length Total domain length.
    @param first_cell First cell dimension.
    @return Geometric ratio r.
    """
    if num_cells == 1:
        return 1.0

    # Geometric series: L = a * (r^n - 1) / (r - 1)
    # Solve for r using Newton-Raphson
    r = 1.05  # Initial guess
    for _ in range(100):
        sum_geo = first_cell * (r**num_cells - 1.0) / (r - 1.0) if abs(r - 1.0) > 1e-10 else first_cell * num_cells
        f = sum_geo - total_length
        if abs(f) < 1e-12:
            break
        # Derivative
        if abs(r - 1.0) > 1e-10:
            df = first_cell * (num_cells * r**(num_cells-1) * (r - 1.0) - (r**num_cells - 1.0)) / (r - 1.0)**2
        else:
            df = first_cell * num_cells * (num_cells - 1) / 2.0
        if abs(df) < 1e-12:
            break
        r_new = r - f / df
        r = max(r_new, 1.0001)  # Keep r > 1

    return r

# --- Shared Grid-Construction Stages ---
#
# Every geometry is the same four-stage pipeline: build three logical-axis
# distributions, map the logical cube into physical space, place the result, then
# analyse and export it. Only the map differs between geometries, so the other three
# stages live here once instead of being copied into each generator.

def check_multigrid_levels(dimensions: Dict[str, int], levels: int) -> None:
    """!
    @brief Refuse node counts the multigrid hierarchy cannot coarsen.
    @details Each level halves as IM -> (IM+1)/2, so L levels need IM = 2^(L-1)*k + 1. An
             illegal count still runs: the solver logs that it cannot coarsen further and
             proceeds on a slightly misaligned coarse grid, which is a quiet loss of
             convergence rate rather than a failure. Catching it here makes it loud, and
             at the moment it can still be fixed for free.
    @param[in] dimensions Node counts keyed by logical axis.
    @param[in] levels Requested multigrid levels.
    @throws ValueError when an axis cannot be coarsened that many times.
    """
    if levels < 1:
        raise ValueError("mg_levels must be at least 1")
    stride = 1 << (levels - 1)
    bad = {axis: count for axis, count in dimensions.items() if (count - 1) % stride}
    if bad:
        detail = "; ".join(
            f"{axis}={count} nodes" for axis, count in sorted(bad.items())
        )
        usable = ", ".join(str(stride*k + 1) for k in range(1, 9))
        raise ValueError(
            f"{levels} multigrid levels need node counts of the form 2^{levels - 1}*k + 1 "
            f"on every axis, but {detail}. Usable counts here: {usable}."
        )


def check_periodic_axes(periodic: List[str], axis_values: Dict[str, np.ndarray],
                        transforms: Optional[List[str]]) -> None:
    """!
    @brief Refuse grids whose periodic axes the runtime cannot treat correctly.
    @details Two independent constraints. A periodic seam must join cells of matching
             width, so one-sided stretching on such an axis puts a discontinuity exactly
             where the wrap happens. And the runtime's periodic reconstruction offsets
             only the matching Cartesian component and copies the other two, so it assumes
             the seam displacement is axis-aligned; rotating such a grid produces a wrong
             metric at the seam. Whether an arbitrarily oriented periodic grid could be
             handled is unverified, so this refuses rather than guesses.
    @param[in] periodic Logical axes declared periodic.
    @param[in] axis_values Axis node positions keyed by logical axis.
    @param[in] transforms Transform tokens that will be applied, if any.
    @throws ValueError when a declared periodic axis cannot be honoured.
    """
    for axis in periodic:
        if axis not in ('i', 'j', 'k'):
            raise ValueError(f"periodic axis must be one of i, j, k; got '{axis}'")
        values = axis_values.get(axis)
        if values is None or values.size < 3:
            continue
        widths = np.diff(values)
        if not np.isclose(widths[0], widths[-1], rtol=1e-9, atol=1e-12):
            raise ValueError(
                f"axis '{axis}' is declared periodic but its first and last cells differ "
                f"({widths[0]:.6g} vs {widths[-1]:.6g}). The seam would join cells of "
                f"different width. Use symmetric stretching on a periodic axis, or none."
            )
    if periodic and transforms:
        for token in transforms:
            kind, _ = parse_transform_token(token)
            if kind == 'rotate':
                raise ValueError(
                    "a periodic axis cannot be combined with 'rotate': the runtime's "
                    "periodic reconstruction offsets only the matching Cartesian "
                    "component and copies the other two, so it assumes an axis-aligned "
                    "seam. Rotating a periodic grid is not verified to be handled "
                    "correctly, so it is refused rather than silently produced."
                )


def _announce_axis(axis: str, stretch: float, first_start, first_end, note: str = "") -> None:
    """!
    @brief Report which stretching mode an axis resolved to.
    @param[in] axis Logical axis name ('i', 'j' or 'k').
    @param[in] stretch Requested hyperbolic stretch factor; 0 disables it.
    @param[in] first_start Requested first-cell size at the axis start, or None.
    @param[in] first_end Requested first-cell size at the axis end, or None.
    @param[in] note Optional physical descriptor, e.g. "radial".
    """
    where = f"{axis}-direction" + (f" ({note})" if note else "")
    if (first_start or first_end) and stretch > 0:
        print(f"Applying hyperbolic stretching in {where}: auto-computing stretch factor "
              f"to achieve first cell = {first_start or first_end} "
              f"(initial guess: {stretch:.2f}).")
    elif first_start or first_end:
        print(f"Applying geometric stretching in {where} "
              f"(first cell: start={first_start}, end={first_end}).")
    elif stretch > 0:
        print(f"Applying hyperbolic stretching in {where} (factor={stretch:.2f}).")


def build_stretched_axes(specs: Dict[str, Optional[dict]]) -> Tuple[Dict[str, np.ndarray],
                                                                   Dict[str, float]]:
    """!
    @brief Build the logical-axis distributions shared by every geometry.
    @details Announces the stretching mode, solves for the distribution, and reports the
             stretch factor actually realized. An axis mapped to None is left to the
             geometry, which is how a geometry owning its own parametrization (a
             circumferential wrap, say) opts out without opting out of the rest.
    @param[in] specs Per-axis mapping of 'i'/'j'/'k' to a dict carrying `num_points`,
                     `bounds`, `stretch`, `first_start`, `first_end`, and optional `note`.
    @return Axis values keyed by axis, and the realized stretch factors keyed by axis.
    """
    values: Dict[str, np.ndarray] = {}
    factors: Dict[str, float] = {'i': 0.0, 'j': 0.0, 'k': 0.0}
    for axis in ('i', 'j', 'k'):
        spec = specs.get(axis)
        if spec is None:
            continue
        stretch = spec['stretch']
        first_start, first_end = spec['first_start'], spec['first_end']
        _announce_axis(axis, stretch, first_start, first_end, spec.get('note', ''))
        low, high = spec['bounds']
        axis_values, factor = create_stretched_linspace(
            spec['num_points'], stretch, low, high, first_start, first_end
        )
        values[axis], factors[axis] = axis_values, factor
        if (first_start or first_end) and stretch > 0:
            print(f"  → Computed stretch factor for {axis}-direction: {factor:.4f}")
    return values, factors


def _reference_point(X: np.ndarray, Y: np.ndarray, Z: np.ndarray, mode: str) -> np.ndarray:
    """!
    @brief Resolve the point a placement or similarity transform is measured from.
    @param[in] X Nodal x coordinates.
    @param[in] Y Nodal y coordinates.
    @param[in] Z Nodal z coordinates.
    @param[in] mode One of `bbox_min`, `bbox_max`, `bbox_center`, `centroid`, `origin`.
    @return The reference point as a length-3 array.
    @throws ValueError when the mode is not a known reference.
    """
    if mode == 'origin':
        return np.zeros(3)
    if mode == 'bbox_min':
        return np.array([np.min(X), np.min(Y), np.min(Z)])
    if mode == 'bbox_max':
        return np.array([np.max(X), np.max(Y), np.max(Z)])
    if mode == 'bbox_center':
        return 0.5 * np.array([np.min(X) + np.max(X), np.min(Y) + np.max(Y),
                               np.min(Z) + np.max(Z)])
    if mode == 'centroid':
        return np.array([np.mean(X), np.mean(Y), np.mean(Z)])
    raise ValueError(
        f"unknown reference point '{mode}'; expected one of "
        "bbox_min, bbox_max, bbox_center, centroid, origin"
    )


#: Placement and similarity operations available to every geometry, in the order a
#: transform list may name them. Mirroring and an odd axis permutation invert handedness,
#: which `analyze_grid_quality` reports as `right_handed` -- `jacobian_consistent` cannot,
#: because a uniformly inverted grid is self-consistent.
GRID_TRANSFORM_KINDS = ("anchor", "translate", "scale", "rotate", "mirror", "permute")

#: Physical-axis orders `permute` accepts. Each names where x, y and z end up.
_PERMUTE_ORDERS = ("xyz", "xzy", "yxz", "yzx", "zxy", "zyx")

#: Planes `mirror` reflects across, and the coordinate each one negates.
_MIRROR_PLANES = {"yz": 0, "zx": 1, "xy": 2}


def parse_spec_token(token: str, allowed: Tuple[str, ...], what: str) -> Tuple[str, Dict[str, str]]:
    """!
    @brief Parse one `kind:key=value,key=value` specification token.
    @details One grammar serves every ordered list the generator accepts -- transforms,
             wall segments, path segments -- on the command line and in the config file
             alike, so none of them needs a parser of its own.
    @param[in] token Single whitespace-delimited token.
    @param[in] allowed Kinds this list accepts.
    @param[in] what Noun used in diagnostics, e.g. "transform" or "wall segment".
    @return The kind and its raw string parameters.
    @throws ValueError when the kind is unknown or a parameter is malformed.
    """
    kind, _, raw = token.partition(":")
    kind = kind.strip()
    if kind not in allowed:
        raise ValueError(
            f"unknown {what} '{kind}' in '{token}'; expected one of {', '.join(allowed)}"
        )
    params: Dict[str, str] = {}
    for field in (f for f in raw.split(",") if f.strip()):
        key, sep, value = field.partition("=")
        if not sep:
            raise ValueError(
                f"{what} '{kind}' parameter '{field}' is not 'key=value' in '{token}'"
            )
        params[key.strip()] = value.strip()
    return kind, params


def parse_transform_token(token: str) -> Tuple[str, Dict[str, str]]:
    """!
    @brief Parse one transform token.
    @param[in] token Single whitespace-delimited transform token.
    @return The operation name and its raw string parameters.
    @throws ValueError when the kind is unknown or a parameter is malformed.
    """
    return parse_spec_token(token, GRID_TRANSFORM_KINDS, "transform")


def _spec_float(params: Dict[str, str], key: str, default: Optional[float],
                kind: str, what: str) -> float:
    """!
    @brief Read one numeric parameter from a specification token.
    @param[in] params Raw string parameters.
    @param[in] key Parameter name.
    @param[in] default Value when the parameter is absent; None makes it required.
    @param[in] kind Operation name, for diagnostics.
    @param[in] what Noun used in diagnostics.
    @return The parsed value.
    @throws ValueError when a required parameter is missing or is not a number.
    """
    raw = params.get(key)
    if raw is None:
        if default is None:
            raise ValueError(f"{what} '{kind}' requires '{key}'")
        return default
    try:
        return float(raw)
    except ValueError:
        raise ValueError(f"{what} '{kind}' parameter '{key}' must be a number, got '{raw}'")


def _transform_vector(params: Dict[str, str], keys: Tuple[str, str, str],
                      default: float, kind: str) -> np.ndarray:
    """!
    @brief Read a three-component transform parameter.
    @param[in] params Raw string parameters for one transform.
    @param[in] keys Parameter names carrying the x, y and z components.
    @param[in] default Value used for a component the caller omitted.
    @param[in] kind Operation name, for diagnostics.
    @return The three components as an array.
    @throws ValueError when a named component is not a number.
    """
    out = []
    for key in keys:
        raw = params.get(key)
        if raw is None:
            out.append(default)
            continue
        try:
            out.append(float(raw))
        except ValueError:
            raise ValueError(f"transform '{kind}' parameter '{key}' must be a number, got '{raw}'")
    return np.array(out)


def apply_transforms(X: np.ndarray, Y: np.ndarray, Z: np.ndarray,
                     transforms: List[str]) -> GridCoords:
    """!
    @brief Apply an ordered placement and similarity transform list to a built grid.
    @details Transforms act on physical coordinates after the geometry map, so they are
             geometry-independent: the same list places a swept duct and a shaped box.
             Order is significant and is the order given.
    @param[in] X Nodal x coordinates.
    @param[in] Y Nodal y coordinates.
    @param[in] Z Nodal z coordinates.
    @param[in] transforms Transform tokens in application order.
    @return The transformed coordinates.
    @throws ValueError on an unknown operation or an invalid parameter.
    """
    for token in transforms:
        kind, params = parse_transform_token(token)
        if kind == 'anchor':
            mode = params.get('mode', 'bbox_min')
            target = _transform_vector(params, ('x', 'y', 'z'), 0.0, kind)
            reference = _reference_point(X, Y, Z, mode)
            shift = target - reference
            X, Y, Z = X + shift[0], Y + shift[1], Z + shift[2]
        elif kind == 'translate':
            shift = _transform_vector(params, ('dx', 'dy', 'dz'), 0.0, kind)
            X, Y, Z = X + shift[0], Y + shift[1], Z + shift[2]
        elif kind == 'scale':
            factors = _transform_vector(params, ('sx', 'sy', 'sz'), 1.0, kind)
            if np.any(factors == 0.0):
                raise ValueError("transform 'scale' factors must be non-zero")
            about = _reference_point(X, Y, Z, params.get('about', 'bbox_min'))
            X = about[0] + (X - about[0])*factors[0]
            Y = about[1] + (Y - about[1])*factors[1]
            Z = about[2] + (Z - about[2])*factors[2]
        elif kind == 'rotate':
            axis = params.get('axis', 'z')
            if axis not in ('x', 'y', 'z'):
                raise ValueError(f"transform 'rotate' axis must be x, y or z, got '{axis}'")
            try:
                angle = np.deg2rad(float(params['deg']))
            except KeyError:
                raise ValueError("transform 'rotate' requires 'deg'")
            except ValueError:
                raise ValueError(f"transform 'rotate' deg must be a number, got '{params['deg']}'")
            about = _reference_point(X, Y, Z, params.get('about', 'bbox_center'))
            cos_a, sin_a = np.cos(angle), np.sin(angle)
            dx, dy, dz = X - about[0], Y - about[1], Z - about[2]
            if axis == 'x':
                dy, dz = cos_a*dy - sin_a*dz, sin_a*dy + cos_a*dz
            elif axis == 'y':
                dz, dx = cos_a*dz - sin_a*dx, sin_a*dz + cos_a*dx
            else:
                dx, dy = cos_a*dx - sin_a*dy, sin_a*dx + cos_a*dy
            X, Y, Z = about[0] + dx, about[1] + dy, about[2] + dz
        elif kind == 'mirror':
            plane = params.get('plane', 'xy')
            if plane not in _MIRROR_PLANES:
                raise ValueError(
                    f"transform 'mirror' plane must be one of {', '.join(sorted(_MIRROR_PLANES))}, "
                    f"got '{plane}'"
                )
            about = _reference_point(X, Y, Z, params.get('about', 'bbox_center'))
            index = _MIRROR_PLANES[plane]
            coords = [X, Y, Z]
            coords[index] = 2.0*about[index] - coords[index]
            X, Y, Z = coords
        elif kind == 'permute':
            order = params.get('order', 'xyz')
            if order not in _PERMUTE_ORDERS:
                raise ValueError(
                    f"transform 'permute' order must be one of {', '.join(_PERMUTE_ORDERS)}, "
                    f"got '{order}'"
                )
            source = {'x': X, 'y': Y, 'z': Z}
            X, Y, Z = (source[name] for name in order)
    return X, Y, Z


def place_and_transform(X: np.ndarray, Y: np.ndarray, Z: np.ndarray,
                        origin: List[float],
                        transforms: Optional[List[str]] = None) -> GridCoords:
    """!
    @brief Place a freshly mapped grid, then apply any user transform list.
    @details Placement puts the bounding-box corner on `origin`, which is what every
             geometry did inline before transforms existed. Transforms then compose on
             top of that, so a transform list refines the placement rather than
             replacing it and `origin` keeps its meaning.
    @param[in] X Nodal x coordinates.
    @param[in] Y Nodal y coordinates.
    @param[in] Z Nodal z coordinates.
    @param[in] origin Target position of the bounding-box minimum corner.
    @param[in] transforms Optional transform tokens applied after placement.
    @return The placed and transformed coordinates.
    """
    reference = _reference_point(X, Y, Z, 'bbox_min')
    X = X + (origin[0] - reference[0])
    Y = Y + (origin[1] - reference[1])
    Z = Z + (origin[2] - reference[2])
    if transforms:
        X, Y, Z = apply_transforms(X, Y, Z, transforms)
    return X, Y, Z


#: Segment kinds a piecewise wall-height field accepts. A wall is a function of the
#: streamwise coordinate built from these end to end, each one continuing from the height
#: the previous reached, so a step is not a special geometry but one entry in a list.
GRID_WALL_SEGMENT_KINDS = ("flat", "step", "ramp", "arc", "sine", "gaussian", "hill")

#: Shapes a `step` or `arc` segment may take across its own length. Each is exactly 0 at
#: the segment start and exactly 1 at its end, so segments stay continuous.
_SEGMENT_SHAPES = {
    "smoothstep": lambda t: t*t*(3.0 - 2.0*t),
    "cosine": lambda t: 0.5*(1.0 - np.cos(np.pi*t)),
    "linear": lambda t: t,
}


def _segment_profile(kind: str, params: Dict[str, str], t: np.ndarray,
                     length: float, height: float) -> np.ndarray:
    """!
    @brief Evaluate one wall segment over its own normalized span.
    @details Every shape starts at `height`, which is where the previous segment ended, so
             a wall built from these is continuous by construction. Only the segment's own
             length controls how abruptly it turns: a shorter `step` is a sharper corner.
    @param[in] kind Segment kind.
    @param[in] params Raw string parameters.
    @param[in] t Normalized position within the segment, in [0, 1].
    @param[in] length Physical length of the segment.
    @param[in] height Wall height at the segment start.
    @return Wall height across the segment.
    @throws ValueError when a required parameter is missing or invalid.
    """
    what = "wall segment"
    if kind == 'flat':
        return np.full_like(t, height)
    if kind in ('step', 'arc'):
        rise = _spec_float(params, 'dy', None, kind, what)
        shape_name = params.get('shape', 'cosine' if kind == 'arc' else 'smoothstep')
        shape = _SEGMENT_SHAPES.get(shape_name)
        if shape is None:
            raise ValueError(
                f"{what} '{kind}' shape must be one of {', '.join(sorted(_SEGMENT_SHAPES))}, "
                f"got '{shape_name}'"
            )
        return height + rise*shape(t)
    if kind == 'ramp':
        return height + _spec_float(params, 'dy', None, kind, what)*t
    if kind == 'sine':
        amplitude = _spec_float(params, 'amp', None, kind, what)
        cycles = _spec_float(params, 'cycles', 1.0, kind, what)
        return height + amplitude*np.sin(2.0*np.pi*cycles*t)
    if kind == 'gaussian':
        amplitude = _spec_float(params, 'amp', None, kind, what)
        width = _spec_float(params, 'width', 0.25*length, kind, what)
        if width <= 0.0:
            raise ValueError(f"{what} 'gaussian' width must be positive")
        centre = _spec_float(params, 'center', 0.5*length, kind, what)
        return height + amplitude*np.exp(-(((t*length - centre)/width)**2))
    # hill: a symmetric cos^2 rise and fall. Value and slope both vanish at each end, so a
    # hill segment tiles periodically without a kink -- which is the point of using one.
    amplitude = _spec_float(params, 'height', None, kind, what)
    return height + amplitude*np.cos(np.pi*(t - 0.5))**2


#: Cells a shaping wall segment should span before its corner is worth trusting. Below
#: this the mesh is representing the turn with too few cells to be smooth; below one cell
#: it cannot represent it at all, and asking for a shorter one changes nothing.
WALL_SEGMENT_MIN_CELLS = 4.0


def check_wall_resolution(segments: List[str], axis: np.ndarray, label: str) -> None:
    """!
    @brief Refuse or flag wall segments the grid is too coarse to represent.
    @details A segment that turns the wall needs cells across it to do so. Below one cell
             the request is unrepresentable and silently becomes a single-cell jump: two
             different requested lengths then produce the identical grid, which is
             precisely the case where a caller believes they refined something and did
             not. Above that it is a quality question, not a correctness one, so it is
             reported and left to the caller.
    @param[in] segments Segment tokens in order.
    @param[in] axis Node positions along the axis the segments run over.
    @param[in] label Configuration key being checked, for diagnostics.
    @throws ValueError when a shaping segment spans less than one cell.
    """
    edge = float(axis[0])
    for token in segments:
        kind, params = parse_spec_token(token, GRID_WALL_SEGMENT_KINDS, "wall segment")
        length = _spec_float(params, 'len', None, kind, "wall segment")
        upper = edge + length
        shaping = kind != 'flat' and any(
            abs(_spec_float(params, key, 0.0, kind, "wall segment")) > 0.0
            for key in ('dy', 'amp', 'height')
        )
        if shaping:
            # Measure the span in cells the axis actually provides here, not in nodes: a
            # sub-cell segment still contains one node interval, so counting nodes would
            # report every too-short segment as exactly one cell and never fire.
            widths = np.diff(axis)
            nearby = widths[max(0, int(np.searchsorted(axis, edge)) - 1):
                            max(1, int(np.searchsorted(axis, upper)))]
            cell = float(np.min(nearby)) if nearby.size else float(np.min(widths))
            spanned = length/cell if cell > 0.0 else float('inf')
            if spanned < 1.0:
                raise ValueError(
                    f"{label}: segment '{token}' spans {spanned:.2f} of a cell "
                    f"(cell width {cell:.4g}). A wall cannot turn in less than one cell: "
                    f"any shorter length produces the identical single-cell jump, so the "
                    f"refinement asked for here would not exist. Lengthen the segment or "
                    f"refine the axis."
                )
            if spanned < WALL_SEGMENT_MIN_CELLS:
                print(
                    f"WARNING: {label} segment '{token}' spans only {spanned:.1f} cells. "
                    f"The corner is representable but coarse; check "
                    f"Max_Non_Orthogonality_deg in the quality report before trusting it.",
                    file=sys.stderr,
                )
        edge = upper


def evaluate_wall_profile(segments: List[str], coordinate: np.ndarray,
                          start: float, extent: float, datum: float,
                          label: str) -> np.ndarray:
    """!
    @brief Evaluate a piecewise wall-height field along a coordinate.
    @details The segment lengths must together span the axis, because a wall that stops
             short of the domain has no defined height over the remainder and silently
             rescaling it would move geometry the caller did not ask to move.
    @param[in] segments Segment tokens in streamwise order.
    @param[in] coordinate Physical coordinate to evaluate the wall at.
    @param[in] start Coordinate value where the first segment begins.
    @param[in] extent Total axis length the segments must cover.
    @param[in] datum Wall height before the first segment.
    @param[in] label Configuration key being evaluated, for diagnostics.
    @return Wall height at each coordinate value.
    @throws ValueError on an unknown segment, a bad parameter, or a length mismatch.
    """
    parsed = []
    total = 0.0
    for token in segments:
        kind, params = parse_spec_token(token, GRID_WALL_SEGMENT_KINDS, "wall segment")
        length = _spec_float(params, 'len', None, kind, "wall segment")
        if length <= 0.0:
            raise ValueError(f"{label}: wall segment '{kind}' len must be positive")
        parsed.append((kind, params, length))
        total += length
    if not parsed:
        return np.full_like(coordinate, datum)
    if not np.isclose(total, extent, rtol=1e-9, atol=1e-12):
        raise ValueError(
            f"{label}: segment lengths sum to {total:.12g} but the axis spans "
            f"{extent:.12g}; give the segments the axis they actually cover rather than "
            f"leaving the remainder undefined"
        )

    height = datum
    if parsed and 'y' in parsed[0][1]:
        height = _spec_float(parsed[0][1], 'y', None, parsed[0][0], "wall segment")

    wall = np.full_like(coordinate, height)
    edge = start
    for kind, params, length in parsed:
        upper = edge + length
        # The last segment owns its closing edge so no node falls outside every segment.
        inside = (coordinate >= edge) & (coordinate <= upper)
        t = np.clip((coordinate - edge)/length, 0.0, 1.0)
        wall = np.where(inside, _segment_profile(kind, params, t, length, height), wall)
        height = float(_segment_profile(kind, params, np.array([1.0]), length, height)[0])
        wall = np.where(coordinate > upper, height, wall)
        edge = upper
    return wall


# --- Core Grid Generation Functions ---

#: Cross-sections a swept duct may carry. `circle` uses the square-to-disc map rather
#: than an O-grid: an O-grid needs a circumferential seam whose coincident-node treatment
#: the solver only reaches through the `cgrid` branch, which no case.yml can select.
GRID_CROSS_SECTIONS = ("rectangle", "circle")

#: Centreline segment kinds. A path is these end to end, each continuing from the
#: position and frame the previous one reached.
GRID_PATH_SEGMENT_KINDS = ("straight", "arc")

#: World axes an `arc` may turn about. The arc bends in the plane perpendicular to it.
_ARC_AXES = {"x": np.array([1.0, 0.0, 0.0]),
             "y": np.array([0.0, 1.0, 0.0]),
             "z": np.array([0.0, 0.0, 1.0])}


def _axis_rotation(axis: np.ndarray, angle: float) -> np.ndarray:
    """!
    @brief Rodrigues rotation matrix about a unit axis.
    @param[in] axis Unit rotation axis.
    @param[in] angle Rotation angle in radians.
    @return The 3x3 rotation matrix.
    """
    K = np.array([[0.0, -axis[2], axis[1]],
                  [axis[2], 0.0, -axis[0]],
                  [-axis[1], axis[0], 0.0]])
    return np.eye(3) + np.sin(angle)*K + (1.0 - np.cos(angle))*(K @ K)


def build_centerline(segments: List[str], arc_lengths: np.ndarray,
                     label: str) -> Tuple[np.ndarray, np.ndarray, np.ndarray, float]:
    """!
    @brief Sample a piecewise centreline and a rotation-minimizing frame along it.
    @details The frame is carried by parallel transport: each arc rotates the whole frame
             about its own turning axis, which is perpendicular to the tangent, so no
             twist accumulates about the tangent itself. A frame built instead from a
             fixed "up" vector twists as soon as a path turns out of one plane, which is
             why a multi-segment path needs this rather than an orientation flag.
    @param[in] segments Path segment tokens in order.
    @param[in] arc_lengths Arc-length stations to sample, ascending, within the path.
    @param[in] label Configuration key being built, for diagnostics.
    @return Centre positions, cross-section axis vectors, their partners, and total length.
    @throws ValueError on an unknown segment or an invalid parameter.
    """
    what = "path segment"
    parsed = []
    total = 0.0
    for token in segments:
        kind, params = parse_spec_token(token, GRID_PATH_SEGMENT_KINDS, what)
        if kind == 'straight':
            length = _spec_float(params, 'len', None, kind, what)
            if length <= 0.0:
                raise ValueError(f"{label}: path segment 'straight' len must be positive")
        else:
            radius = _spec_float(params, 'radius', None, kind, what)
            degrees = _spec_float(params, 'deg', None, kind, what)
            if radius <= 0.0:
                raise ValueError(f"{label}: path segment 'arc' radius must be positive")
            length = abs(radius*np.deg2rad(degrees))
            if length <= 0.0:
                raise ValueError(f"{label}: path segment 'arc' deg must be non-zero")
        parsed.append((kind, params, length))
        total += length
    if not parsed:
        raise ValueError(f"{label}: a swept grid needs at least one path segment")

    position = np.zeros(3)
    frame = np.eye(3)          # columns: tangent, first cross axis, second cross axis
    tangent, normal, binormal = frame[:, 0].copy(), frame[:, 1].copy(), frame[:, 2].copy()

    centres = np.zeros((arc_lengths.size, 3))
    axis_u = np.zeros((arc_lengths.size, 3))
    axis_v = np.zeros((arc_lengths.size, 3))

    edge = 0.0
    for index, (kind, params, length) in enumerate(parsed):
        upper = edge + length
        last = index == len(parsed) - 1
        selected = (arc_lengths >= edge) & (arc_lengths <= upper if last
                                            else arc_lengths < upper)
        local = arc_lengths[selected] - edge
        if kind == 'straight':
            centres[selected] = position + np.outer(local, tangent)
            axis_u[selected] = normal
            axis_v[selected] = binormal
            end_position = position + length*tangent
            end_tangent, end_normal, end_binormal = tangent, normal, binormal
        else:
            radius = _spec_float(params, 'radius', None, kind, what)
            degrees = _spec_float(params, 'deg', None, kind, what)
            axis_name = params.get('axis', 'z')
            if axis_name not in _ARC_AXES:
                raise ValueError(
                    f"{label}: path segment 'arc' axis must be one of "
                    f"{', '.join(sorted(_ARC_AXES))}, got '{axis_name}'"
                )
            axis = _ARC_AXES[axis_name]
            if abs(float(np.dot(axis, tangent))) > 1.0 - 1e-9:
                raise ValueError(
                    f"{label}: path segment '{parsed[index][0]}' turns about '{axis_name}', "
                    f"which is parallel to the current tangent; an arc has no defined "
                    f"plane there. Turn about a different axis."
                )
            sign = 1.0 if degrees >= 0 else -1.0
            # Centre of curvature: perpendicular to the tangent, in the turning plane.
            inward = np.cross(axis, tangent)
            inward = inward/np.linalg.norm(inward)
            centre = position + sign*radius*inward
            for offset, s_local in zip(np.flatnonzero(selected), local):
                rotation = _axis_rotation(axis, sign*s_local/radius)
                centres[offset] = centre + rotation @ (position - centre)
                axis_u[offset] = rotation @ normal
                axis_v[offset] = rotation @ binormal
            rotation = _axis_rotation(axis, sign*length/radius)
            end_position = centre + rotation @ (position - centre)
            end_tangent = rotation @ tangent
            end_normal = rotation @ normal
            end_binormal = rotation @ binormal
        position, tangent = end_position, end_tangent
        normal, binormal = end_normal, end_binormal
        edge = upper
    return centres, axis_u, axis_v, total


def cross_section_offsets(cross_section: str, u: np.ndarray, v: np.ndarray,
                          side_i: float, side_j: float) -> Tuple[np.ndarray, np.ndarray]:
    """!
    @brief Map the logical cross-section square onto the requested shape.
    @details `rectangle` is the square itself. `circle` uses the square-to-disc map
             x = u*sqrt(1 - v^2/2), y = v*sqrt(1 - u^2/2), whose edges land exactly on the
             circle and whose corners land on its 45-degree points. It covers the whole
             disc in one block with no hole and no axis singularity, at the cost of cell
             size varying with angle -- worst in the four diagonal regions.
    @param[in] cross_section Shape name.
    @param[in] u First logical cross-section coordinate.
    @param[in] v Second logical cross-section coordinate.
    @param[in] side_i Full width along the first cross-section direction.
    @param[in] side_j Full width along the second cross-section direction.
    @return Physical offsets along the two cross-section axes.
    """
    if cross_section == 'rectangle':
        return side_i*u, side_j*v
    return (0.5*side_i*u*np.sqrt(1.0 - 0.5*v*v),
            0.5*side_j*v*np.sqrt(1.0 - 0.5*u*u))


def sweep_grid(
    ncells_i: int, ncells_j: int, ncells_k: int,
    cross_section: str, side_lengths: List[float], path: List[str],
    cross_section_scale: Optional[List[str]], origin: List[float],
    stretch_i: float, stretch_j: float, stretch_k: float,
    first_cell_i_start: float = None, first_cell_i_end: float = None,
    first_cell_j_start: float = None, first_cell_j_end: float = None,
    first_cell_k_start: float = None, first_cell_k_end: float = None,
    transforms: Optional[List[str]] = None,
    mg_levels: Optional[int] = None,
    periodic: Optional[List[str]] = None
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, Dict[str, float]]:
    """!
    @brief Generates a duct by sweeping a cross-section along a piecewise centreline.
    @details Cross-section and path are independent: any shape travels any path. The frame
             is parallel-transported, so a path may leave one plane without the section
             twisting, and an optional scale field along the arc length turns the same
             sweep into a nozzle, a diffuser, or a sudden expansion.

             Logical axes follow the cross-section's two directions and then the path, in
             that order, which makes the result right-handed.
    @param[in] ncells_i Cells along the first cross-section direction.
    @param[in] ncells_j Cells along the second cross-section direction.
    @param[in] ncells_k Cells along the path.
    @param[in] cross_section Cross-section shape name.
    @param[in] side_lengths Full width along each cross-section direction.
    @param[in] path Centreline segment tokens in order.
    @param[in] cross_section_scale Optional scale field along the path, as segments.
    @param[in] origin Target position of the bounding-box minimum corner.
    @param[in] stretch_i Hyperbolic stretch factor for the first cross-section axis.
    @param[in] stretch_j Hyperbolic stretch factor for the second cross-section axis.
    @param[in] stretch_k Hyperbolic stretch factor along the path.
    @param[in] first_cell_i_start First-cell size at the first axis start.
    @param[in] first_cell_i_end First-cell size at the first axis end.
    @param[in] first_cell_j_start First-cell size at the second axis start.
    @param[in] first_cell_j_end First-cell size at the second axis end.
    @param[in] first_cell_k_start First-cell size at the path start.
    @param[in] first_cell_k_end First-cell size at the path end.
    @param[in] transforms Optional placement/similarity transform tokens.
    @param[in] mg_levels Multigrid levels the node counts must support.
    @param[in] periodic Logical axes that will be periodic.
    @return Nodal x, y and z coordinates, and the realized stretch factors.
    @throws ValueError on an unknown cross-section or a malformed path.
    """
    if cross_section not in GRID_CROSS_SECTIONS:
        raise ValueError(
            f"cross_section must be one of {', '.join(GRID_CROSS_SECTIONS)}, "
            f"got '{cross_section}'"
        )
    print(f"Generating Swept Grid (Cross-section: {cross_section}) ---")
    IM, JM, KM = ncells_i + 1, ncells_j + 1, ncells_k + 1
    # The disc map is defined on [-1, 1]^2; a rectangle is described by its half-widths.
    span = 1.0 if cross_section == 'circle' else 0.5

    axes, stretch_factors = build_stretched_axes({
        'i': {'num_points': IM, 'bounds': (-span, span), 'stretch': stretch_i,
              'first_start': first_cell_i_start, 'first_end': first_cell_i_end},
        'j': {'num_points': JM, 'bounds': (-span, span), 'stretch': stretch_j,
              'first_start': first_cell_j_start, 'first_end': first_cell_j_end},
        'k': {'num_points': KM, 'bounds': (0, 1), 'stretch': stretch_k,
              'first_start': first_cell_k_start, 'first_end': first_cell_k_end},
    })
    u_vals, v_vals, zeta_vals = axes['i'], axes['j'], axes['k']
    if mg_levels:
        check_multigrid_levels({'i': IM, 'j': JM, 'k': KM}, mg_levels)
    check_periodic_axes(periodic or [], axes, transforms)

    # One pass to learn the path length, a second to sample it where zeta asks.
    _, _, _, total_length = build_centerline(path, np.array([0.0]), 'path')
    stations = zeta_vals*total_length
    centres, axis_u, axis_v, _ = build_centerline(path, stations, 'path')

    scale = np.ones_like(stations)
    if cross_section_scale:
        scale = evaluate_wall_profile(cross_section_scale, stations, 0.0, total_length,
                                      1.0, 'cross_section_scale')
        if np.any(scale <= 0.0):
            raise ValueError(
                "cross_section_scale: the cross-section cannot reach zero or negative "
                "width; a duct that closes has no interior to mesh"
            )

    side_i, side_j = side_lengths
    U, V = np.meshgrid(u_vals, v_vals, indexing='ij')
    offset_u, offset_v = cross_section_offsets(cross_section, U, V, side_i, side_j)

    X, Y, Z = (np.zeros((IM, JM, KM)) for _ in range(3))
    for k in range(KM):
        du, dv = scale[k]*offset_u, scale[k]*offset_v
        X[:, :, k] = centres[k, 0] + du*axis_u[k, 0] + dv*axis_v[k, 0]
        Y[:, :, k] = centres[k, 1] + du*axis_u[k, 1] + dv*axis_v[k, 1]
        Z[:, :, k] = centres[k, 2] + du*axis_u[k, 2] + dv*axis_v[k, 2]

    return place_and_transform(X, Y, Z, origin, transforms) + (stretch_factors,)


def box_grid(
    ncells_i: int, ncells_j: int, ncells_k: int,
    bounds_x: List[float], bounds_y: List[float], bounds_z: List[float],
    wall_j_lo: Optional[List[str]], wall_j_hi: Optional[List[str]],
    wall_j_lo_span: Optional[List[str]], wall_j_hi_span: Optional[List[str]],
    amp_A: float, amp_B: float, amp_C: float, origin: List[float],
    stretch_i: float, stretch_j: float, stretch_k: float,
    first_cell_i_start: float = None, first_cell_i_end: float = None,
    first_cell_j_start: float = None, first_cell_j_end: float = None,
    first_cell_k_start: float = None, first_cell_k_end: float = None,
    transforms: Optional[List[str]] = None,
    mg_levels: Optional[int] = None,
    periodic: Optional[List[str]] = None
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, Dict[str, float]]:
    """!
    @brief Generates a Cartesian block whose bounding walls may be shaped.
    @details The wall-normal coordinate blends between a lower and an upper wall, each a
             piecewise height field along the streamwise axis:

                 y = y_lo(x, z) + eta * (y_hi(x, z) - y_lo(x, z))

             so wall clustering stays a fraction of the *local* height. A separate
             spanwise list modulates each wall's departure from its datum, which is what
             makes a wall-attached obstacle of finite width expressible. With both walls
             flat this reduces to a plain Cartesian box, and with the warp amplitudes set
             it reduces to the sinusoidal warped block.

             The wall is a single-valued function of position by construction, so it
             cannot express an overhang, a detached body, or anything the flow passes
             underneath. Those need an immersed boundary or multiple blocks.
    @param[in] ncells_i Cells along the streamwise axis.
    @param[in] ncells_j Cells along the wall-normal axis.
    @param[in] ncells_k Cells along the spanwise axis.
    @param[in] bounds_x Streamwise extent as [min, max].
    @param[in] bounds_y Wall-normal extent as [min, max]; also the two wall datums.
    @param[in] bounds_z Spanwise extent as [min, max].
    @param[in] wall_j_lo Lower-wall segment tokens, streamwise order.
    @param[in] wall_j_hi Upper-wall segment tokens, streamwise order.
    @param[in] wall_j_lo_span Spanwise envelope for the lower wall's departure from datum.
    @param[in] wall_j_hi_span Spanwise envelope for the upper wall's departure from datum.
    @param[in] amp_A Amplitude of the interior sinusoidal warp.
    @param[in] amp_B Amplitude of the first boundary warp term.
    @param[in] amp_C Amplitude of the second boundary warp term.
    @param[in] origin Target position of the bounding-box minimum corner.
    @param[in] stretch_i Hyperbolic stretch factor for the streamwise axis.
    @param[in] stretch_j Hyperbolic stretch factor for the wall-normal axis.
    @param[in] stretch_k Hyperbolic stretch factor for the spanwise axis.
    @param[in] first_cell_i_start First-cell size at the streamwise start.
    @param[in] first_cell_i_end First-cell size at the streamwise end.
    @param[in] first_cell_j_start First-cell size at the lower wall.
    @param[in] first_cell_j_end First-cell size at the upper wall.
    @param[in] first_cell_k_start First-cell size at the spanwise start.
    @param[in] first_cell_k_end First-cell size at the spanwise end.
    @param[in] transforms Optional placement/similarity transform tokens.
    @param[in] mg_levels Multigrid levels the node counts must support.
    @param[in] periodic Logical axes that will be periodic.
    @return Nodal x, y and z coordinates, and the realized stretch factors.
    @throws ValueError when a wall specification does not span its axis.
    """
    print("Generating Shaped Box Grid ---")
    IM, JM, KM = ncells_i + 1, ncells_j + 1, ncells_k + 1
    x_min, x_max = bounds_x
    y_min, y_max = bounds_y
    z_min, z_max = bounds_z

    axes, stretch_factors = build_stretched_axes({
        'i': {'num_points': IM, 'bounds': (0, 1), 'stretch': stretch_i,
              'first_start': first_cell_i_start, 'first_end': first_cell_i_end},
        'j': {'num_points': JM, 'bounds': (0, 1), 'stretch': stretch_j,
              'first_start': first_cell_j_start, 'first_end': first_cell_j_end},
        'k': {'num_points': KM, 'bounds': (0, 1), 'stretch': stretch_k,
              'first_start': first_cell_k_start, 'first_end': first_cell_k_end},
    })
    xi, eta, zeta = axes['i'], axes['j'], axes['k']
    if mg_levels:
        check_multigrid_levels({'i': IM, 'j': JM, 'k': KM}, mg_levels)
    check_periodic_axes(periodic or [], axes, transforms)

    XI, ETA, ZETA = np.meshgrid(xi, eta, zeta, indexing='ij')
    A, B, C = amp_A, amp_B, amp_C
    X_norm = (XI+A*np.sin(np.pi*XI)*np.sin(np.pi*ETA)*np.sin(np.pi*ZETA)+B*np.sin(2*np.pi*ETA)+C*np.sin(2*np.pi*ZETA))
    Y_norm = (ETA+A*np.sin(np.pi*XI)*np.sin(np.pi*ETA)*np.sin(np.pi*ZETA)+B*np.sin(2*np.pi*XI)+C*np.sin(2*np.pi*ZETA))
    Z_norm = (ZETA+A*np.sin(np.pi*XI)*np.sin(np.pi*ETA)*np.sin(np.pi*ZETA)+B*np.sin(2*np.pi*XI)+C*np.sin(2*np.pi*ETA))

    X = x_min + (x_max - x_min)*X_norm
    Z = z_min + (z_max - z_min)*Z_norm

    # Walls are read at the unwarped station, so the sinusoidal warp displaces the mesh
    # without also sliding the geometry the wall lists describe.
    x_station = x_min + (x_max - x_min)*XI
    z_station = z_min + (z_max - z_min)*ZETA

    def wall(segments, span, datum, label):
        """!
        @brief Build one wall surface from its streamwise and spanwise lists.
        @param[in] segments Streamwise segment tokens.
        @param[in] span Spanwise envelope tokens.
        @param[in] datum Wall height where no segment displaces it.
        @param[in] label Configuration key, for diagnostics.
        @return Wall height over the whole block.
        """
        if not segments:
            return np.full_like(x_station, datum)
        check_wall_resolution(segments, x_min + (x_max - x_min)*xi, label)
        surface = evaluate_wall_profile(segments, x_station, x_min, x_max - x_min,
                                        datum, label)
        if span:
            envelope = evaluate_wall_profile(span, z_station, z_min, z_max - z_min,
                                             1.0, f"{label}_span")
            surface = datum + (surface - datum)*envelope
        return surface

    y_lo = wall(wall_j_lo, wall_j_lo_span, y_min, 'wall_j_lo')
    y_hi = wall(wall_j_hi, wall_j_hi_span, y_max, 'wall_j_hi')
    Y = y_lo + Y_norm*(y_hi - y_lo)

    return place_and_transform(X, Y, Z, origin, transforms) + (stretch_factors,)


def cartesian_pipe_grid(
    ncells_i: int, ncells_j: int, ncells_k: int,
    side_lengths: List[float], Rc_factor: float,
    straight_factor: float, bend_angle_deg: float,
    orientation: str, origin: List[float],
    stretch_i: float, stretch_j: float, stretch_k: float,  # --- MODIFIED ---
    first_cell_i_start: float = None, first_cell_i_end: float = None,
    first_cell_j_start: float = None, first_cell_j_end: float = None,
    first_cell_k_start: float = None, first_cell_k_end: float = None,
    transforms: Optional[List[str]] = None
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, Dict[str, float]]: 
    """!
    @brief Generates a bent pipe grid by warping a Cartesian block.
    @param[in] ncells_i Argument passed to `cartesian_pipe_grid()`.
    @param[in] ncells_j Argument passed to `cartesian_pipe_grid()`.
    @param[in] ncells_k Argument passed to `cartesian_pipe_grid()`.
    @param[in] side_lengths Argument passed to `cartesian_pipe_grid()`.
    @param[in] Rc_factor Argument passed to `cartesian_pipe_grid()`.
    @param[in] straight_factor Argument passed to `cartesian_pipe_grid()`.
    @param[in] bend_angle_deg Argument passed to `cartesian_pipe_grid()`.
    @param[in] orientation Argument passed to `cartesian_pipe_grid()`.
    @param[in] origin Argument passed to `cartesian_pipe_grid()`.
    @param[in] stretch_i Argument passed to `cartesian_pipe_grid()`.
    @param[in] stretch_j Argument passed to `cartesian_pipe_grid()`.
    @param[in] stretch_k Argument passed to `cartesian_pipe_grid()`.
    @param[in] first_cell_i_start Argument passed to `cartesian_pipe_grid()`.
    @param[in] first_cell_i_end Argument passed to `cartesian_pipe_grid()`.
    @param[in] first_cell_j_start Argument passed to `cartesian_pipe_grid()`.
    @param[in] first_cell_j_end Argument passed to `cartesian_pipe_grid()`.
    @param[in] first_cell_k_start Argument passed to `cartesian_pipe_grid()`.
    @param[in] first_cell_k_end Argument passed to `cartesian_pipe_grid()`.
    @param[in] transforms Optional placement/similarity transform tokens applied
                          after the geometry map.
    @return Nodal x, y and z coordinates, and the realized stretch factors.
    """
    print(f"Generating Cartesian Pipe Grid (Orientation: {orientation.upper()}) ---")
    side_i, side_j = side_lengths
    bend_angle_rad = np.deg2rad(bend_angle_deg)
    ref_dim = side_i
    Rc = Rc_factor * ref_dim
    L_in = straight_factor * ref_dim
    L_bend = Rc * bend_angle_rad
    L_out = straight_factor * ref_dim
    total_len = L_in + L_bend + L_out

    IM, JM, KM = ncells_i + 1, ncells_j + 1, ncells_k + 1

    axes, stretch_factors = build_stretched_axes({
        'i': {'num_points': IM, 'bounds': (-0.5, 0.5), 'stretch': stretch_i,
              'first_start': first_cell_i_start, 'first_end': first_cell_i_end},
        'j': {'num_points': JM, 'bounds': (-0.5, 0.5), 'stretch': stretch_j,
              'first_start': first_cell_j_start, 'first_end': first_cell_j_end},
        'k': {'num_points': KM, 'bounds': (0, 1), 'stretch': stretch_k,
              'first_start': first_cell_k_start, 'first_end': first_cell_k_end},
    })
    xi_vals, eta_vals, zeta_vals = axes['i'], axes['j'], axes['k']

    XI, ETA = np.meshgrid(xi_vals, eta_vals, indexing='ij')
    d_xi = side_i * XI
    d_eta = side_j * ETA

    X, Y, Z = (np.zeros((IM, JM, KM)) for _ in range(3))

    for k, zeta in enumerate(zeta_vals):
        s = zeta * total_len
        if s <= L_in:
            xc = -L_in + s; yc, zc = 0.0, 0.0
            tangent = np.array([1.0, 0.0, 0.0])
        elif s <= L_in + L_bend:
            s_bend = s - L_in; theta = s_bend / Rc
            cos_t, sin_t = np.cos(theta), np.sin(theta)
            xc = Rc * sin_t
            if orientation == 'xy': yc = Rc - Rc*cos_t; zc = 0.0; tangent = np.array([cos_t, sin_t, 0.0])
            else: yc = 0.0; zc = Rc - Rc*cos_t; tangent = np.array([cos_t, 0.0, sin_t])
        else:
            s_out = s - L_in - L_bend
            cos_a, sin_a = np.cos(bend_angle_rad), np.sin(bend_angle_rad)
            xc_bend_end = Rc * sin_a
            if orientation == 'xy':
                yc_bend_end = Rc - Rc*cos_a; zc_bend_end = 0.0
                tangent = np.array([cos_a, sin_a, 0.0])
            else:
                yc_bend_end = 0.0; zc_bend_end = Rc - Rc*cos_a
                tangent = np.array([cos_a, 0.0, sin_a])
            xc = xc_bend_end + s_out * tangent[0]
            yc = yc_bend_end + s_out * tangent[1]
            zc = zc_bend_end + s_out * tangent[2]
        if orientation == 'xy': v_up = np.array([0.0,0.0,1.0]); v_eta=v_up; v_xi=np.cross(v_eta, tangent)
        else: v_up = np.array([0.0,1.0,0.0]); v_eta=v_up; v_xi=np.cross(v_eta, tangent)
        X[:,:,k] = xc + d_xi*v_xi[0] + d_eta*v_eta[0]
        Y[:,:,k] = yc + d_xi*v_xi[1] + d_eta*v_eta[1]
        Z[:,:,k] = zc + d_xi*v_xi[2] + d_eta*v_eta[2]
    
    return place_and_transform(X, Y, Z, origin, transforms) + (stretch_factors,)

def bent_pipe_grid(
    ncells_phi: int, ncells_r: int, ncells_path: int,
    D: float, Rc_factor: float, straight_factor: float,
    bend_angle_deg: float, pinhole_factor: float,
    orientation: str, origin: List[float],
    stretch_i: float, stretch_j: float, stretch_k: float,  # --- MODIFIED ---
    first_cell_i_start: float = None, first_cell_i_end: float = None,
    first_cell_j_start: float = None, first_cell_j_end: float = None,
    first_cell_k_start: float = None, first_cell_k_end: float = None,
    transforms: Optional[List[str]] = None
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, Dict[str, float]]:
    """!
    @brief Generates a structured O-grid for a bent pipe.
    @param[in] ncells_phi Argument passed to `bent_pipe_grid()`.
    @param[in] ncells_r Argument passed to `bent_pipe_grid()`.
    @param[in] ncells_path Argument passed to `bent_pipe_grid()`.
    @param[in] D Argument passed to `bent_pipe_grid()`.
    @param[in] Rc_factor Argument passed to `bent_pipe_grid()`.
    @param[in] straight_factor Argument passed to `bent_pipe_grid()`.
    @param[in] bend_angle_deg Argument passed to `bent_pipe_grid()`.
    @param[in] pinhole_factor Argument passed to `bent_pipe_grid()`.
    @param[in] orientation Argument passed to `bent_pipe_grid()`.
    @param[in] origin Argument passed to `bent_pipe_grid()`.
    @param[in] stretch_i Argument passed to `bent_pipe_grid()`.
    @param[in] stretch_j Argument passed to `bent_pipe_grid()`.
    @param[in] stretch_k Argument passed to `bent_pipe_grid()`.
    @param[in] first_cell_i_start Argument passed to `bent_pipe_grid()`.
    @param[in] first_cell_i_end Argument passed to `bent_pipe_grid()`.
    @param[in] first_cell_j_start Argument passed to `bent_pipe_grid()`.
    @param[in] first_cell_j_end Argument passed to `bent_pipe_grid()`.
    @param[in] first_cell_k_start Argument passed to `bent_pipe_grid()`.
    @param[in] first_cell_k_end Argument passed to `bent_pipe_grid()`.
    @param[in] transforms Optional placement/similarity transform tokens applied
                          after the geometry map.
    @return Nodal x, y and z coordinates, and the realized stretch factors.
    """
    print(f"Generating O-Grid Pipe (Orientation: {orientation.upper()}) ---")
    Rp = 0.5 * D; bend_angle_rad = np.deg2rad(bend_angle_deg); Rc = Rc_factor * D
    L_in = straight_factor*D; L_bend = Rc*bend_angle_rad; L_out = straight_factor*D
    total_len = L_in + L_bend + L_out
    IM, JM, KM = ncells_phi + 1, ncells_r + 1, ncells_path + 1

    if first_cell_i_start or first_cell_i_end:
        print("Note: first-cell-i (circumferential) is ignored for O-grid pipes.")
    elif stretch_i > 0:
        print("Note: stretch-i (circumferential) is ignored for O-grid pipes.")

    # The circumferential axis is the geometry's own wrap, not a stretchable axis, so
    # it opts out of the shared axis stage while the radial and path axes opt in.
    axes, stretch_factors = build_stretched_axes({
        'i': None,
        'j': {'num_points': JM, 'bounds': (0, 1), 'stretch': stretch_j,
              'first_start': first_cell_j_start, 'first_end': first_cell_j_end,
              'note': 'radial'},
        'k': {'num_points': KM, 'bounds': (0, 1), 'stretch': stretch_k,
              'first_start': first_cell_k_start, 'first_end': first_cell_k_end},
    })
    phi_vals = np.linspace(0, 2 * np.pi, IM)
    r_vals_norm, zeta_vals = axes['j'], axes['k']

    if 0 < pinhole_factor < 1: print(f"Applying pinhole with radius factor: {pinhole_factor}")
    pinhole_radius = pinhole_factor * Rp
    physical_r = pinhole_radius + r_vals_norm * (Rp - pinhole_radius)
    PHI, R = np.meshgrid(phi_vals, physical_r, indexing='ij')
    disp_xi, disp_eta = R * np.cos(PHI), R * np.sin(PHI)
    X, Y, Z = (np.zeros((IM, JM, KM)) for _ in range(3))

    for k, zeta in enumerate(zeta_vals):
        s = zeta * total_len
        if s <= L_in:
            xc = -L_in + s; yc, zc = 0.0, 0.0
            tangent = np.array([1.0, 0.0, 0.0])
        elif s <= L_in + L_bend:
            s_bend = s - L_in; theta = s_bend / Rc
            cos_t, sin_t = np.cos(theta), np.sin(theta)
            xc = Rc * sin_t
            if orientation == 'xy': yc=Rc-Rc*cos_t; zc=0.0; tangent=np.array([cos_t, sin_t, 0.0])
            else: yc=0.0; zc=Rc-Rc*cos_t; tangent=np.array([cos_t, 0.0, sin_t])
        else:
            s_out = s - L_in - L_bend
            cos_a, sin_a = np.cos(bend_angle_rad), np.sin(bend_angle_rad)
            xc_bend_end = Rc * sin_a
            if orientation == 'xy':
                yc_bend_end=Rc-Rc*cos_a; zc_bend_end=0.0; tangent=np.array([cos_a, sin_a, 0.0])
            else:
                yc_bend_end=0.0; zc_bend_end=Rc-Rc*cos_a; tangent=np.array([cos_a, 0.0, sin_a])
            xc = xc_bend_end + s_out*tangent[0]
            yc = yc_bend_end + s_out*tangent[1]
            zc = zc_bend_end + s_out*tangent[2]
        if orientation == 'xy': v_up=np.array([0.0,0.0,1.0]); v_xi=np.cross(v_up,tangent); v_eta=v_up
        else: v_up = np.array([0.0,1.0,0.0]); v_xi=v_up; v_eta=np.cross(tangent,v_xi)
        X[:,:,k] = xc + disp_xi*v_xi[0] + disp_eta*v_eta[0]
        Y[:,:,k] = yc + disp_xi*v_xi[1] + disp_eta*v_eta[1]
        Z[:,:,k] = zc + disp_xi*v_xi[2] + disp_eta*v_eta[2]
        
    return place_and_transform(X, Y, Z, origin, transforms) + (stretch_factors,)

def generate_curvilinear_grid(
    ncells_i: int, ncells_j: int, ncells_k: int,
    x_min: float, x_max: float, y_min: float, y_max: float, z_min: float, z_max: float,
    A: float, B: float, C: float, origin: List[float],
    stretch_i: float, stretch_j: float, stretch_k: float,  # --- MODIFIED ---
    first_cell_i_start: float = None, first_cell_i_end: float = None,
    first_cell_j_start: float = None, first_cell_j_end: float = None,
    first_cell_k_start: float = None, first_cell_k_end: float = None,
    transforms: Optional[List[str]] = None
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, Dict[str, float]]:
    """!
    @brief Generates a 3D all-hexahedral grid by warping a Cartesian block.
    @param[in] ncells_i Argument passed to `generate_curvilinear_grid()`.
    @param[in] ncells_j Argument passed to `generate_curvilinear_grid()`.
    @param[in] ncells_k Argument passed to `generate_curvilinear_grid()`.
    @param[in] x_min Argument passed to `generate_curvilinear_grid()`.
    @param[in] x_max Argument passed to `generate_curvilinear_grid()`.
    @param[in] y_min Argument passed to `generate_curvilinear_grid()`.
    @param[in] y_max Argument passed to `generate_curvilinear_grid()`.
    @param[in] z_min Argument passed to `generate_curvilinear_grid()`.
    @param[in] z_max Argument passed to `generate_curvilinear_grid()`.
    @param[in] A Argument passed to `generate_curvilinear_grid()`.
    @param[in] B Argument passed to `generate_curvilinear_grid()`.
    @param[in] C Argument passed to `generate_curvilinear_grid()`.
    @param[in] origin Argument passed to `generate_curvilinear_grid()`.
    @param[in] stretch_i Argument passed to `generate_curvilinear_grid()`.
    @param[in] stretch_j Argument passed to `generate_curvilinear_grid()`.
    @param[in] stretch_k Argument passed to `generate_curvilinear_grid()`.
    @param[in] first_cell_i_start Argument passed to `generate_curvilinear_grid()`.
    @param[in] first_cell_i_end Argument passed to `generate_curvilinear_grid()`.
    @param[in] first_cell_j_start Argument passed to `generate_curvilinear_grid()`.
    @param[in] first_cell_j_end Argument passed to `generate_curvilinear_grid()`.
    @param[in] first_cell_k_start Argument passed to `generate_curvilinear_grid()`.
    @param[in] first_cell_k_end Argument passed to `generate_curvilinear_grid()`.
    @param[in] transforms Optional placement/similarity transform tokens applied
                          after the geometry map.
    @return Nodal x, y and z coordinates, and the realized stretch factors.
    """
    print("Generating Warped Box Grid ---")
    IM, JM, KM = ncells_i + 1, ncells_j + 1, ncells_k + 1

    axes, stretch_factors = build_stretched_axes({
        'i': {'num_points': IM, 'bounds': (0, 1), 'stretch': stretch_i,
              'first_start': first_cell_i_start, 'first_end': first_cell_i_end},
        'j': {'num_points': JM, 'bounds': (0, 1), 'stretch': stretch_j,
              'first_start': first_cell_j_start, 'first_end': first_cell_j_end},
        'k': {'num_points': KM, 'bounds': (0, 1), 'stretch': stretch_k,
              'first_start': first_cell_k_start, 'first_end': first_cell_k_end},
    })
    xi, eta, zeta = axes['i'], axes['j'], axes['k']

    XI, ETA, ZETA = np.meshgrid(xi, eta, zeta, indexing='ij')
    X_norm = (XI+A*np.sin(np.pi*XI)*np.sin(np.pi*ETA)*np.sin(np.pi*ZETA)+B*np.sin(2*np.pi*ETA)+C*np.sin(2*np.pi*ZETA))
    Y_norm = (ETA+A*np.sin(np.pi*XI)*np.sin(np.pi*ETA)*np.sin(np.pi*ZETA)+B*np.sin(2*np.pi*XI)+C*np.sin(2*np.pi*ZETA))
    Z_norm = (ZETA+A*np.sin(np.pi*XI)*np.sin(np.pi*ETA)*np.sin(np.pi*ZETA)+B*np.sin(2*np.pi*XI)+C*np.sin(2*np.pi*ETA))
    
    X_local = x_min + (x_max-x_min)*X_norm
    Y_local = y_min + (y_max-y_min)*Y_norm
    Z_local = z_min + (z_max-z_min)*Z_norm
    

    return place_and_transform(X_local, Y_local, Z_local, origin, transforms) + (stretch_factors,)

def resolve_reference_quantities(length_ref: Optional[float], nu: Optional[float],
                                 velocity_ref: Optional[float], re_tau: Optional[float],
                                 u_tau: Optional[float]) -> Optional[Dict[str, float]]:
    """!
    @brief Resolve the reference scales the quality report needs to add units.
    @details These describe the grid, they never move it. Non-dimensionalization stays
             where it already is, in the launcher, which divides coordinates by
             `length_ref` once for every grid regardless of origin; scaling here as well
             would divide twice.

             `Re_tau` cannot be derived from a case: it is a flow outcome, not an input,
             so it is a target the caller supplies and everything computed from it is
             nominal. `length_ref`, `nu` and `velocity_ref` do come from the case.
    @param[in] length_ref Reference length used to non-dimensionalize the grid.
    @param[in] nu Kinematic viscosity.
    @param[in] velocity_ref Reference velocity.
    @param[in] re_tau Target friction Reynolds number.
    @param[in] u_tau Friction velocity, as an alternative to `re_tau`.
    @return Resolved reference scales, or None when nothing was supplied.
    @throws ValueError when a supplied combination cannot be interpreted.
    """
    if all(value is None for value in (length_ref, nu, velocity_ref, re_tau, u_tau)):
        return None
    reference: Dict[str, float] = {}
    if length_ref is not None:
        if length_ref <= 0.0:
            raise ValueError("length_ref must be positive")
        reference['length_ref'] = length_ref
    if nu is not None and nu <= 0.0:
        raise ValueError("nu must be positive")

    # y+ = y * u_tau / nu. Either form supplies that one ratio.
    if u_tau is not None:
        if nu is None:
            raise ValueError("u_tau needs nu to express a wall unit; supply both")
        reference['inverse_viscous_length'] = u_tau/nu
        reference['u_tau'] = u_tau
    elif re_tau is not None:
        if length_ref is None:
            raise ValueError(
                "re_tau is a ratio against the reference length, so it needs length_ref; "
                "supply it, or give u_tau and nu instead"
            )
        reference['inverse_viscous_length'] = re_tau/length_ref
        reference['re_tau'] = re_tau
    if nu is not None:
        reference['nu'] = nu
    if velocity_ref is not None and nu is not None and length_ref is not None:
        reference['reynolds'] = velocity_ref*length_ref/nu
    return reference


def _axis_spacings(X: np.ndarray, Y: np.ndarray, Z: np.ndarray, axis: int) -> np.ndarray:
    """!
    @brief Node-to-node distances along one logical axis.
    @param[in] X Nodal x coordinates.
    @param[in] Y Nodal y coordinates.
    @param[in] Z Nodal z coordinates.
    @param[in] axis Logical axis index.
    @return Cell widths along that axis.
    """
    return np.sqrt(np.diff(X, axis=axis)**2 + np.diff(Y, axis=axis)**2
                   + np.diff(Z, axis=axis)**2)


# --- Grid Analysis and Export Functions ---
def analyze_grid_quality(X: np.ndarray, Y: np.ndarray, Z: np.ndarray,
                         stretch_factors: Optional[Dict[str, float]] = None,
                         reference: Optional[Dict[str, float]] = None) -> dict:
    """!
    @brief Performs a comprehensive quality analysis on the grid and returns a dictionary of metrics.
    @param[in] X Argument passed to `analyze_grid_quality()`.
    @param[in] Y Argument passed to `analyze_grid_quality()`.
    @param[in] Z Argument passed to `analyze_grid_quality()`.
    @param[in] stretch_factors Realized per-axis stretch factors from the geometry that
                               built this grid, reported verbatim. Absent factors read as
                               zero, which is what an unstretched axis realizes anyway.
    @param[in] reference Optional reference scales from resolve_reference_quantities().
                         With `length_ref` the report also carries solver units, and with
                         a friction scale it carries nominal wall units.
    @return Value returned by `analyze_grid_quality()`.
    """
    stats = {}
    IM, JM, KM = X.shape
    eps = 1e-12

    # --- Basic Dimensions ---
    stats['dims_nodes'] = (IM, JM, KM)
    stats['dims_cells'] = (IM - 1, JM - 1, KM - 1)
    stats['total_nodes'] = IM * JM * KM
    stats['total_cells'] = (IM - 1) * (JM - 1) * (KM - 1)
    stats['bounds_x'] = (np.min(X), np.max(X))
    stats['bounds_y'] = (np.min(Y), np.max(Y))
    stats['bounds_z'] = (np.min(Z), np.max(Z))

    # --- First Cell Dimensions ---
    # Calculate first cell size at both ends of each direction
    P = np.stack((X, Y, Z), axis=-1)

    # i-direction: first cell at i=0 and i=IM-2 (averaged over j,k)
    first_cells_i_start = np.linalg.norm(P[1,:,:,:] - P[0,:,:,:], axis=-1)
    first_cells_i_end = np.linalg.norm(P[-1,:,:,:] - P[-2,:,:,:], axis=-1)
    stats['first_cell_i_start'] = np.mean(first_cells_i_start)
    stats['first_cell_i_end'] = np.mean(first_cells_i_end)

    # j-direction: first cell at j=0 and j=JM-2 (averaged over i,k)
    first_cells_j_start = np.linalg.norm(P[:,1,:,:] - P[:,0,:,:], axis=-1)
    first_cells_j_end = np.linalg.norm(P[:,-1,:,:] - P[:,-2,:,:], axis=-1)
    stats['first_cell_j_start'] = np.mean(first_cells_j_start)
    stats['first_cell_j_end'] = np.mean(first_cells_j_end)

    # k-direction: first cell at k=0 and k=KM-2 (averaged over i,j)
    first_cells_k_start = np.linalg.norm(P[:,:,1,:] - P[:,:,0,:], axis=-1)
    first_cells_k_end = np.linalg.norm(P[:,:,-1,:] - P[:,:,-2,:], axis=-1)
    stats['first_cell_k_start'] = np.mean(first_cells_k_start)
    stats['first_cell_k_end'] = np.mean(first_cells_k_end)

    # --- Computed Stretch Factors ---
    # Store the computed tanh stretch factors (if auto-computed)
    factors = stretch_factors or {'i': 0.0, 'j': 0.0, 'k': 0.0}
    stats['computed_stretch_i'] = factors['i']
    stats['computed_stretch_j'] = factors['j']
    stats['computed_stretch_k'] = factors['k']

    # --- Volume / Jacobian Checks ---
    ax=np.diff(X,axis=0)[:,:-1,:-1]; ay=np.diff(Y,axis=0)[:,:-1,:-1]; az=np.diff(Z,axis=0)[:,:-1,:-1]
    bx=np.diff(X,axis=1)[:-1,:,:-1]; by=np.diff(Y,axis=1)[:-1,:,:-1]; bz=np.diff(Z,axis=1)[:-1,:,:-1]
    cx=np.diff(X,axis=2)[:-1,:-1,:]; cy=np.diff(Y,axis=2)[:-1,:-1,:]; cz=np.diff(Z,axis=2)[:-1,:-1,:]
    signed_volumes = ax*(by*cz-bz*cy) + ay*(bz*cx-bx*cz) + az*(bx*cy-by*cx)
    
    volume_signs = np.sign(signed_volumes)
    stats['jacobian_consistent'] = np.all(volume_signs == volume_signs.flatten()[0])
    # Consistency only says every cell agrees; it says nothing about which way. A
    # uniformly inverted grid is self-consistent, and mirroring or permuting axes is
    # exactly how one gets made, so handedness is reported separately.
    stats['right_handed'] = bool(np.all(signed_volumes > 0))
    volumes = np.abs(signed_volumes)
    non_zero_volumes = volumes[volumes > eps]
    
    stats['total_volume'] = np.sum(non_zero_volumes)
    stats['min_volume'] = np.min(non_zero_volumes) if non_zero_volumes.size > 0 else 0.0
    stats['max_volume'] = np.max(non_zero_volumes) if non_zero_volumes.size > 0 else 0.0

    # --- Advanced Metrics ---
    P = np.stack((X, Y, Z), axis=-1)
    C = 0.125 * (P[:-1,:-1,:-1] + P[1:,:-1,:-1] + P[:-1,1:,:-1] + P[1:,1:,:-1] + P[:-1,:-1,1:] + P[1:,:-1,1:] + P[:-1,1:,1:] + P[1:,1:,1:])

    with np.errstate(divide='ignore', invalid='ignore'):
        ratio_i = np.maximum(volumes[1:,:,:]/volumes[:-1,:,:], volumes[:-1,:,:]/volumes[1:,:,:])
        ratio_j = np.maximum(volumes[:,1:,:]/volumes[:,:-1,:], volumes[:,:-1,:]/volumes[:,1:,:])
        ratio_k = np.maximum(volumes[:,:,1:]/volumes[:,:,:-1], volumes[:,:,:-1]/volumes[:,:,1:])
    
    # Store individual directional maxes
    stats['max_expansion_i'] = np.nanmax(ratio_i) if ratio_i.size > 0 else 0.0
    stats['max_expansion_j'] = np.nanmax(ratio_j) if ratio_j.size > 0 else 0.0
    stats['max_expansion_k'] = np.nanmax(ratio_k) if ratio_k.size > 0 else 0.0
    
    # Global max is just the max of the three
    stats['max_expansion_ratio'] = max(stats['max_expansion_i'], stats['max_expansion_j'], stats['max_expansion_k'])

    edge_i = np.linalg.norm(np.diff(P, axis=0), axis=-1)
    edge_j = np.linalg.norm(np.diff(P, axis=1), axis=-1)
    edge_k = np.linalg.norm(np.diff(P, axis=2), axis=-1)
    L_i = 0.25*(edge_i[:,:-1,:-1]+edge_i[:,1:,:-1]+edge_i[:,:-1,1:]+edge_i[:,1:,1:])
    L_j = 0.25*(edge_j[:-1,:,:-1]+edge_j[1:,:,:-1]+edge_j[:-1,:,1:]+edge_j[1:,:,1:])
    L_k = 0.25*(edge_k[:-1,:-1,:]+edge_k[1:,:-1,:]+edge_k[:-1,1:,:]+edge_k[1:,1:,:])
    max_dims = np.maximum.reduce([L_i, L_j, L_k]); min_dims = np.minimum.reduce([L_i, L_j, L_k])
    aspect_ratios = max_dims / (min_dims + eps)
    stats['max_aspect_ratio'] = np.max(aspect_ratios)
    stats['avg_aspect_ratio'] = np.mean(aspect_ratios)
    stats['std_aspect_ratio'] = np.std(aspect_ratios)

    # --- Particle Search Diagnostics ---
    p0=P[1:-1,:-1,:-1]; p1=P[1:-1,1:,:-1]; p2=P[1:-1,1:,1:]; p3=P[1:-1,:-1,1:]
    face_center = 0.25*(p0+p1+p2+p3)
    face_normal = np.cross(p2-p0, p3-p1, axis=-1)
    face_normal /= (np.linalg.norm(face_normal, axis=-1, keepdims=True) + eps)
    dist0 = np.abs(np.einsum('...k,...k->...', p0-face_center, face_normal))
    dist1 = np.abs(np.einsum('...k,...k->...', p1-face_center, face_normal))
    L_char = np.mean((np.mean(edge_i), np.mean(edge_j), np.mean(edge_k)))
    stats['max_warpage'] = np.max([dist0, dist1])
    stats['max_warpage_norm'] = stats['max_warpage'] / L_char

    # Units the grid is read in downstream. The launcher divides coordinates by
    # length_ref once, so the grid the solver receives is not the one written here; and
    # wall units are what a target Re_tau implies, not a measured friction velocity.
    stats['reference'] = dict(reference) if reference else {}
    if reference:
        spacings = {axis: _axis_spacings(X, Y, Z, index)
                    for index, axis in enumerate(('i', 'j', 'k'))}
        length_ref = reference.get('length_ref')
        if length_ref:
            stats['solver_bounds'] = {
                'x': (stats['bounds_x'][0]/length_ref, stats['bounds_x'][1]/length_ref),
                'y': (stats['bounds_y'][0]/length_ref, stats['bounds_y'][1]/length_ref),
                'z': (stats['bounds_z'][0]/length_ref, stats['bounds_z'][1]/length_ref),
            }
        inverse = reference.get('inverse_viscous_length')
        if inverse:
            stats['wall_units'] = {
                axis: {
                    'first_start': float(np.mean(np.take(width, 0, axis=index)))*inverse,
                    'first_end': float(np.mean(np.take(width, -1, axis=index)))*inverse,
                    'max': float(np.max(width))*inverse,
                    'extent': float(np.max(np.sum(width, axis=index)))*inverse,
                }
                for index, (axis, width) in enumerate(spacings.items())
            }

    # --- Non-Orthogonality ---
    dC_i=C[1:,:,:]-C[:-1,:,:]; S_i=0.5*np.cross(P[1:-1,1:,1:]-P[1:-1,:-1,:-1], P[1:-1,:-1,1:]-P[1:-1,1:,:-1], axis=-1)
    dC_j=C[:,1:,:]-C[:,:-1,:]; S_j=0.5*np.cross(P[1:,1:-1,1:]-P[:-1,1:-1,:-1], P[:-1,1:-1,1:]-P[1:,1:-1,:-1], axis=-1)
    dC_k=C[:,:,1:]-C[:,:,:-1]; S_k=0.5*np.cross(P[1:,1:,1:-1]-P[:-1,:-1,1:-1], P[:-1,1:,1:-1]-P[1:,:-1,1:-1], axis=-1)
    angle_i = np.rad2deg(np.arccos(np.clip(np.abs(np.einsum('...k,...k->...', dC_i, S_i)) / (np.linalg.norm(dC_i,axis=-1)*np.linalg.norm(S_i,axis=-1)+eps), -1, 1)))
    angle_j = np.rad2deg(np.arccos(np.clip(np.abs(np.einsum('...k,...k->...', dC_j, S_j)) / (np.linalg.norm(dC_j,axis=-1)*np.linalg.norm(S_j,axis=-1)+eps), -1, 1)))
    angle_k = np.rad2deg(np.arccos(np.clip(np.abs(np.einsum('...k,...k->...', dC_k, S_k)) / (np.linalg.norm(dC_k,axis=-1)*np.linalg.norm(S_k,axis=-1)+eps), -1, 1)))
    all_ortho_angles = np.concatenate([a.flatten() for a in [angle_i, angle_j, angle_k] if a.size > 0])
    stats['max_non_ortho'] = np.max(all_ortho_angles)
    stats['avg_non_ortho'] = np.mean(all_ortho_angles)
    stats['std_non_ortho'] = np.std(all_ortho_angles)

    return stats
# ... (print_stats_to_console, export_stats_to_file, etc. are unchanged)
def print_stats_to_console(stats: dict) -> None:
    """!
    @brief Prints a formatted summary of the grid quality analysis to the console.
    @param[in] stats Argument passed to `print_stats_to_console()`.
    """
    print("\nGrid Quality Analysis ---")
    print("\n[Dimensions & Domain]")
    print(f"Node Dimensions (IM, JM, KM): {stats.get('dims_nodes', 'N/A')}")
    print(f"Cell Dimensions (i, j, k):   {stats.get('dims_cells', 'N/A')}")
    print(f"Total Nodes: {stats.get('total_nodes', 0):,}")
    print(f"Total Cells: {stats.get('total_cells', 0):,}")
    print("\nPhysical Domain Bounds:")
    print(f"X range: [{stats.get('bounds_x', [0,0])[0]:.4f}, {stats.get('bounds_x', [0,0])[1]:.4f}]")
    print(f"Y range: [{stats.get('bounds_y', [0,0])[0]:.4f}, {stats.get('bounds_y', [0,0])[1]:.4f}]")
    print(f"Z range: [{stats.get('bounds_z', [0,0])[0]:.4f}, {stats.get('bounds_z', [0,0])[1]:.4f}]")
    print(f"Total Domain Volume: {stats.get('total_volume', 0.0):.6e}")
    print("\nFirst Cell Dimensions:")
    print(f"i-direction: start={stats.get('first_cell_i_start', 0.0):.6e}, end={stats.get('first_cell_i_end', 0.0):.6e}")
    print(f"j-direction: start={stats.get('first_cell_j_start', 0.0):.6e}, end={stats.get('first_cell_j_end', 0.0):.6e}")
    print(f"k-direction: start={stats.get('first_cell_k_start', 0.0):.6e}, end={stats.get('first_cell_k_end', 0.0):.6e}")

    # Print computed stretch factors if any are non-zero
    stretch_i = stats.get('computed_stretch_i', 0.0)
    stretch_j = stats.get('computed_stretch_j', 0.0)
    stretch_k = stats.get('computed_stretch_k', 0.0)
    if stretch_i > 0 or stretch_j > 0 or stretch_k > 0:
        print("\nComputed Stretch Factors (tanh):")
        if stretch_i > 0:
            print(f"i-direction: {stretch_i:.4f}")
        if stretch_j > 0:
            print(f"j-direction: {stretch_j:.4f}")
        if stretch_k > 0:
            print(f"k-direction: {stretch_k:.4f}")

    print("\n[Primary CFD Quality Checks]")
    if stats.get('jacobian_consistent', False):
        print(f"Jacobian Sign Consistency: PASS")
    else:
        print(f"Jacobian Sign Consistency: FAIL")
        print("** CRITICAL ERROR: Grid contains inverted cells. Solver will abort. **")
    if stats.get('right_handed', True):
        print("Handedness: RIGHT-HANDED")
    else:
        print("Handedness: LEFT-HANDED")
        print("   Not fatal: the solver detects a uniformly negative Jacobian and flips the")
        print("   metric vectors (CheckAndFixGridOrientation). Reported because a mirror or")
        print("   an odd axis permutation is usually how one gets made unintentionally.")
    print(f"Min/Max Cell Volume: [{stats.get('min_volume', 0.0):.6e}, {stats.get('max_volume', 0.0):.6e}]")
    
    exp_ratio = stats.get('max_expansion_ratio', 0.0)
    exp_i = stats.get('max_expansion_i', 0.0)
    exp_j = stats.get('max_expansion_j', 0.0)
    exp_k = stats.get('max_expansion_k', 0.0)

    print(f"Max Volume Expansion Ratio (Global): {exp_ratio:.4f}")
    print(f"  > i-direction (Transverse): {exp_i:.4f}")
    print(f"  > j-direction (Transverse): {exp_j:.4f}")
    print(f"  > k-direction (Streamwise): {exp_k:.4f}")

    if exp_ratio < 1.01:
        print(f"  Verdict: Nearly uniform")
    elif exp_ratio < 1.1:        
        print(f"  Verdict: Smooth clustering - good")
    elif exp_ratio < 1.2:
        print(f"  Verdict: Moderate clustering")
    else:
        print(f"  Verdict: Aggressive clustering - verify quality")

    print(f"Non-Orthogonality [deg]: Max={stats.get('max_non_ortho', 0.0):.4f}, Avg={stats.get('avg_non_ortho', 0.0):.4f}, StdDev={stats.get('std_non_ortho', 0.0):.4f}")
    if stats.get('max_non_ortho', 0.0) > 70:
        print("** WARNING: High non-orthogonality detected. Solver accuracy may be affected. **")
    
    print("\n[Particle Search Algorithm Diagnostics]")
    print(f"Aspect Ratio (Stretching): Max={stats.get('max_aspect_ratio', 0.0):.4f}, Avg={stats.get('avg_aspect_ratio', 0.0):.4f}, StdDev={stats.get('std_aspect_ratio', 0.0):.4f}")
    print(f"Max Face Warpage (Normalized): {stats.get('max_warpage_norm', 0.0):.4f} (Ideal: 0.0, Concern: >0.01)")
    if stats.get('max_warpage_norm', 0.0) > 0.01:
        print("** WARNING: High face warpage. Particle search may be unreliable. **")
        
    print("-" * 30 + "\n")

def export_stats_to_file(filename: str, stats: dict) -> None:
    """!
    @brief Writes the grid quality analysis metrics to a text file.
    @param[in] filename Argument passed to `export_stats_to_file()`.
    @param[in] stats Argument passed to `export_stats_to_file()`.
    """
    try:
        with open(filename, 'w') as f:
            f.write("# Grid Quality Analysis Report\n")
            f.write("# --------------------------------\n\n")
            
            f.write("[Dimensions & Domain]\n")
            f.write(f"Node_Dimensions = {stats.get('dims_nodes', 'N/A')}\n")
            f.write(f"Cell_Dimensions = {stats.get('dims_cells', 'N/A')}\n")
            f.write(f"Total_Nodes = {stats.get('total_nodes', 0):,}\n")
            f.write(f"Total_Cells = {stats.get('total_cells', 0):,}\n")
            f.write(f"X_Range = {stats.get('bounds_x', [0,0])[0]:.6e}, {stats.get('bounds_x', [0,0])[1]:.6e}\n")
            f.write(f"Y_Range = {stats.get('bounds_y', [0,0])[0]:.6e}, {stats.get('bounds_y', [0,0])[1]:.6e}\n")
            f.write(f"Z_Range = {stats.get('bounds_z', [0,0])[0]:.6e}, {stats.get('bounds_z', [0,0])[1]:.6e}\n")
            f.write(f"Total_Domain_Volume = {stats.get('total_volume', 0.0):.6e}\n\n")

            f.write("[First Cell Dimensions]\n")
            f.write(f"First_Cell_i_Start = {stats.get('first_cell_i_start', 0.0):.6e}\n")
            f.write(f"First_Cell_i_End = {stats.get('first_cell_i_end', 0.0):.6e}\n")
            f.write(f"First_Cell_j_Start = {stats.get('first_cell_j_start', 0.0):.6e}\n")
            f.write(f"First_Cell_j_End = {stats.get('first_cell_j_end', 0.0):.6e}\n")
            f.write(f"First_Cell_k_Start = {stats.get('first_cell_k_start', 0.0):.6e}\n")
            f.write(f"First_Cell_k_End = {stats.get('first_cell_k_end', 0.0):.6e}\n\n")

            f.write("[Computed Stretch Factors]\n")
            f.write(f"Computed_Stretch_i = {stats.get('computed_stretch_i', 0.0):.6f}\n")
            f.write(f"Computed_Stretch_j = {stats.get('computed_stretch_j', 0.0):.6f}\n")
            f.write(f"Computed_Stretch_k = {stats.get('computed_stretch_k', 0.0):.6f}\n\n")

            f.write("[Primary CFD Quality Checks]\n")
            f.write(f"Jacobian_Sign_Consistent = {stats.get('jacobian_consistent', False)}\n")
            f.write(f"Right_Handed = {stats.get('right_handed', True)}\n")
            f.write(f"Min_Volume = {stats.get('min_volume', 0.0):.6e}\n")
            f.write(f"Max_Volume = {stats.get('max_volume', 0.0):.6e}\n")
            f.write(f"Max_Volume_Expansion_Ratio_Global = {stats.get('max_expansion_ratio', 0.0):.4f}\n")
            
            f.write(f"Max_Non_Orthogonality_deg = {stats.get('max_non_ortho', 0.0):.4f}\n")
            f.write(f"Avg_Non_Orthogonality_deg = {stats.get('avg_non_ortho', 0.0):.4f}\n")
            f.write(f"Std_Non_Orthogonality_deg = {stats.get('std_non_ortho', 0.0):.4f}\n\n")
            f.write(f"Max_Volume_Expansion_Ratio_i = {stats.get('max_expansion_i', 0.0):.4f}\n")
            f.write(f"Max_Volume_Expansion_Ratio_j = {stats.get('max_expansion_j', 0.0):.4f}\n")
            f.write(f"Max_Volume_Expansion_Ratio_k = {stats.get('max_expansion_k', 0.0):.4f}\n")
            f.write("[Particle Search Diagnostics]\n")
            f.write(f"Max_Aspect_Ratio = {stats.get('max_aspect_ratio', 0.0):.4f}\n")
            f.write(f"Avg_Aspect_Ratio = {stats.get('avg_aspect_ratio', 0.0):.4f}\n")
            f.write(f"Std_Aspect_Ratio = {stats.get('std_aspect_ratio', 0.0):.4f}\n")
            f.write(f"Max_Face_Warpage_Normalized = {stats.get('max_warpage_norm', 0.0):.4f}\n")

            reference = stats.get('reference') or {}
            if reference:
                f.write("\n[Reference Scales]\n")
                for key in ('length_ref', 'velocity_ref', 'nu', 'reynolds', 're_tau', 'u_tau'):
                    if key in reference:
                        f.write(f"{key} = {reference[key]:.6e}\n")

            solver = stats.get('solver_bounds')
            if solver:
                f.write("\n[Solver Units]\n")
                f.write("# The launcher divides coordinates by length_ref; this is the grid\n")
                f.write("# the solver actually receives.\n")
                for axis in ('x', 'y', 'z'):
                    low, high = solver[axis]
                    f.write(f"{axis.upper()}_Range_Solver = {low:.6e}, {high:.6e}\n")

            wall = stats.get('wall_units')
            if wall:
                f.write("\n[Wall Units - nominal]\n")
                f.write("# Computed from the supplied friction scale, which is a target,\n")
                f.write("# not a measurement: the real u_tau comes from the solved flow.\n")
                for axis in ('i', 'j', 'k'):
                    entry = wall[axis]
                    f.write(f"First_Cell_{axis}_Start_Plus = {entry['first_start']:.4f}\n")
                    f.write(f"First_Cell_{axis}_End_Plus = {entry['first_end']:.4f}\n")
                    f.write(f"Max_Spacing_{axis}_Plus = {entry['max']:.4f}\n")
                    f.write(f"Extent_{axis}_Plus = {entry['extent']:.4f}\n")

        print(f"Grid quality statistics successfully exported to: '{filename}'")
    except IOError as e:
        print(f"Error: Could not write stats to file '{filename}'.\n{e}", file=sys.stderr)

def export_grid_to_picgrid(filename: str, X: np.ndarray, Y: np.ndarray, Z: np.ndarray) -> None:
    """!
    @brief Perform export grid to picgrid.
    @param[in] filename Argument passed to `export_grid_to_picgrid()`.
    @param[in] X Argument passed to `export_grid_to_picgrid()`.
    @param[in] Y Argument passed to `export_grid_to_picgrid()`.
    @param[in] Z Argument passed to `export_grid_to_picgrid()`.
    """
    IM, JM, KM = X.shape
    try:
        with open(filename, 'w') as f:
            f.write("PICGRID\n"); f.write("1\n"); f.write(f"{IM} {JM} {KM}\n")
            coords = np.stack((X, Y, Z), axis=-1)
            flat_coords = coords.reshape((-1, 3), order='F')
            np.savetxt(f, flat_coords, fmt=f"%{PICGRID_FLOAT_FORMAT}")
        print(f"Grid successfully exported to PICGRID file: '{filename}'")
    except IOError as e: print(f"Error: Could not write to file '{filename}'.\n{e}", file=sys.stderr)


def _iter_legacy_payload_lines(path: str):
    """!
    @brief Yield (lineno, stripped_line) for non-empty, non-comment legacy input lines.
    @param[in] path Filesystem path argument passed to `_iter_legacy_payload_lines()`.
    """
    with open(path, "r", encoding="utf-8") as f:
        for lineno, raw in enumerate(f, start=1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            yield lineno, line


def _parse_axis_value(tokens: List[str], preferred_col: int, axis_name: str, path: str, lineno: int) -> float:
    """!
    @brief Parse one axis value from a legacy axis line with column-preference fallback.
    @param[in] tokens Argument passed to `_parse_axis_value()`.
    @param[in] preferred_col Argument passed to `_parse_axis_value()`.
    @param[in] axis_name Argument passed to `_parse_axis_value()`.
    @param[in] path Filesystem path argument passed to `_parse_axis_value()`.
    @param[in] lineno Argument passed to `_parse_axis_value()`.
    @return Value returned by `_parse_axis_value()`.
    """
    if preferred_col < 0:
        raise ValueError(f"{axis_name}: preferred column index must be >= 0 (got {preferred_col}).")

    if preferred_col < len(tokens):
        try:
            return float(tokens[preferred_col])
        except ValueError:
            pass

    for token in tokens:
        try:
            return float(token)
        except ValueError:
            continue

    raise ValueError(
        f"Could not parse a numeric {axis_name}-axis value at {path}:{lineno} from line: '{' '.join(tokens)}'."
    )


def _read_legacy_1d_axes(
    filename: str,
    axis_columns: Tuple[int, int, int] = (0, 1, 2),
    strict_trailing: bool = True,
) -> Dict[str, Any]:
    """!
    @brief Read a legacy 1D-axis grid file and return structured axis blocks.
    @details Supported legacy contract:
             1) first payload line: integer block count (`nblk`)
             2) per block: one `IM JM KM` line
             3) then `IM` x-axis rows, `JM` y-axis rows, `KM` z-axis rows
             4) axis rows may contain one or more numeric columns; `axis_columns`
                controls the preferred column per axis with fallback to first numeric token.
    @param[in] filename Path to legacy grid input.
    @param[in] axis_columns Preferred (x_col, y_col, z_col) indices.
    @param[in] strict_trailing If true, reject trailing payload rows.
    @return Dict with keys `nblk` and `blocks`, where blocks contain dims and axis arrays.
    @throws ValueError if payload is malformed.
    """
    payload = list(_iter_legacy_payload_lines(filename))
    if not payload:
        raise ValueError(f"Legacy grid file '{filename}' is empty.")

    first_line = payload[0][1]
    if first_line == "PICGRID":
        raise ValueError(
            f"Legacy converter received canonical PICGRID file '{filename}'. "
            "Use this file directly with grid.mode=file."
        )

    try:
        nblk = int(first_line)
    except ValueError as exc:
        raise ValueError(
            f"Legacy grid file '{filename}' must start with block count integer; got '{first_line}'."
        ) from exc
    if nblk <= 0:
        raise ValueError(f"Legacy grid file '{filename}' has non-positive block count: {nblk}.")

    cursor = 1
    blocks: List[Dict[str, Any]] = []
    x_col, y_col, z_col = axis_columns

    for bi in range(nblk):
        if cursor >= len(payload):
            raise ValueError(
                f"Legacy grid file '{filename}' missing dimension line for block {bi}."
            )
        dim_lineno, dim_line = payload[cursor]
        cursor += 1
        dim_parts = dim_line.split()
        if len(dim_parts) != 3:
            raise ValueError(
                f"Invalid dimensions line at {filename}:{dim_lineno}. "
                f"Expected 'IM JM KM', got '{dim_line}'."
            )
        try:
            im, jm, km = (int(dim_parts[0]), int(dim_parts[1]), int(dim_parts[2]))
        except ValueError as exc:
            raise ValueError(
                f"Invalid non-integer dimensions at {filename}:{dim_lineno}: '{dim_line}'."
            ) from exc
        if im <= 0 or jm <= 0 or km <= 0:
            raise ValueError(
                f"Invalid non-positive block dimensions at {filename}:{dim_lineno}: ({im}, {jm}, {km})."
            )

        if cursor + im + jm + km > len(payload):
            raise ValueError(
                f"Legacy grid file '{filename}' ended early while reading axis rows for block {bi}."
            )

        x_axis = np.zeros(im, dtype=float)
        y_axis = np.zeros(jm, dtype=float)
        z_axis = np.zeros(km, dtype=float)

        for i in range(im):
            lineno, row = payload[cursor]
            cursor += 1
            x_axis[i] = _parse_axis_value(row.split(), x_col, "x", filename, lineno)
        for j in range(jm):
            lineno, row = payload[cursor]
            cursor += 1
            y_axis[j] = _parse_axis_value(row.split(), y_col, "y", filename, lineno)
        for k in range(km):
            lineno, row = payload[cursor]
            cursor += 1
            z_axis[k] = _parse_axis_value(row.split(), z_col, "z", filename, lineno)

        blocks.append({"dims": (im, jm, km), "x_axis": x_axis, "y_axis": y_axis, "z_axis": z_axis})

    if strict_trailing and cursor < len(payload):
        trailing_lineno, trailing_line = payload[cursor]
        raise ValueError(
            f"Legacy grid file '{filename}' has trailing payload at {trailing_lineno}: '{trailing_line}'. "
            "Pass --allow-trailing to ignore extra rows."
        )

    return {"nblk": nblk, "blocks": blocks}


def _axes_to_structured_grid(x_axis: np.ndarray, y_axis: np.ndarray, z_axis: np.ndarray) -> GridCoords:
    """!
    @brief Build structured node-coordinate arrays from 1D axes (ij-indexed).
    @param[in] x_axis Argument passed to `_axes_to_structured_grid()`.
    @param[in] y_axis Argument passed to `_axes_to_structured_grid()`.
    @param[in] z_axis Argument passed to `_axes_to_structured_grid()`.
    @return Value returned by `_axes_to_structured_grid()`.
    """
    X = np.broadcast_to(x_axis[:, np.newaxis, np.newaxis], (len(x_axis), len(y_axis), len(z_axis))).copy()
    Y = np.broadcast_to(y_axis[np.newaxis, :, np.newaxis], (len(x_axis), len(y_axis), len(z_axis))).copy()
    Z = np.broadcast_to(z_axis[np.newaxis, np.newaxis, :], (len(x_axis), len(y_axis), len(z_axis))).copy()
    return X, Y, Z


def convert_legacy_1d_to_picgrid(
    input_file: str,
    output_file: str,
    axis_columns: Tuple[int, int, int] = (0, 1, 2),
    strict_trailing: bool = True,
) -> Dict[str, Any]:
    """!
    @brief Convert legacy 1D-axis grid payload into canonical PICGRID format.
    @param[in] input_file Path to legacy grid payload.
    @param[in] output_file Destination path for canonical PICGRID.
    @param[in] axis_columns Preferred source columns for x/y/z axis rows.
    @param[in] strict_trailing If true, reject trailing payload after expected rows.
    @return Summary dict containing `nblk`, `dims`, `total_nodes`, and optional first-block arrays.
    """
    parsed = _read_legacy_1d_axes(
        input_file,
        axis_columns=axis_columns,
        strict_trailing=strict_trailing,
    )
    nblk = parsed["nblk"]
    blocks = parsed["blocks"]
    dims = [block["dims"] for block in blocks]
    total_nodes = sum(im * jm * km for (im, jm, km) in dims)

    os.makedirs(os.path.dirname(os.path.abspath(output_file)) or ".", exist_ok=True)
    with open(output_file, "w", encoding="utf-8") as f:
        f.write("PICGRID\n")
        f.write(f"{nblk}\n")
        for (im, jm, km) in dims:
            f.write(f"{im} {jm} {km}\n")

        for block in blocks:
            x_axis = block["x_axis"]
            y_axis = block["y_axis"]
            z_axis = block["z_axis"]
            for k in range(len(z_axis)):
                for j in range(len(y_axis)):
                    for i in range(len(x_axis)):
                        f.write(
                            f"{x_axis[i]:{PICGRID_FLOAT_FORMAT}} "
                            f"{y_axis[j]:{PICGRID_FLOAT_FORMAT}} "
                            f"{z_axis[k]:{PICGRID_FLOAT_FORMAT}}\n"
                        )

    summary: Dict[str, Any] = {"nblk": nblk, "dims": dims, "total_nodes": total_nodes}
    if blocks:
        x_axis = blocks[0]["x_axis"]
        y_axis = blocks[0]["y_axis"]
        z_axis = blocks[0]["z_axis"]
        X, Y, Z = _axes_to_structured_grid(x_axis, y_axis, z_axis)
        summary["first_block_arrays"] = (X, Y, Z)
    return summary

def export_grid_to_vts_manual(filename: str, X: np.ndarray, Y: np.ndarray, Z: np.ndarray) -> None:
    """!
    @brief Perform export grid to vts manual.
    @param[in] filename Argument passed to `export_grid_to_vts_manual()`.
    @param[in] X Argument passed to `export_grid_to_vts_manual()`.
    @param[in] Y Argument passed to `export_grid_to_vts_manual()`.
    @param[in] Z Argument passed to `export_grid_to_vts_manual()`.
    """
    IM, JM, KM = X.shape
    x_flat, y_flat, z_flat = X.flatten(order='F'), Y.flatten(order='F'), Z.flatten(order='F')
    try:
        with open(filename, 'w') as f:
            f.write('<?xml version="1.0"?>\n'); f.write('<VTKFile type="StructuredGrid" version="1.0" byte_order="LittleEndian">\n')
            f.write(f'  <StructuredGrid WholeExtent="0 {IM-1} 0 {JM-1} 0 {KM-1}">\n'); f.write(f'    <Piece Extent="0 {IM-1} 0 {JM-1} 0 {KM-1}">\n')
            f.write('      <Points>\n'); f.write('        <DataArray type="Float64" Name="Points" NumberOfComponents="3" format="ascii">\n')
            for i in range(len(x_flat)): f.write(f"  {x_flat[i]:.8e} {y_flat[i]:.8e} {z_flat[i]:.8e}\n")
            f.write('        </DataArray>\n'); f.write('      </Points>\n'); f.write('      <PointData></PointData>\n'); f.write('      <CellData></CellData>\n')
            f.write('    </Piece>\n'); f.write('  </StructuredGrid>\n'); f.write('</VTKFile>\n')
        print(f"Grid successfully exported to VTK file: '{filename}'")
    except IOError as e: print(f"Error: Could not write to file '{filename}'.\n{e}", file=sys.stderr)

# --- Main Command-Line Interface ---
def main() -> None:
    """!
    @brief Parses arguments and config file, then runs the grid generator.
    """
    prog_description = """
A command-line utility for generating high-quality, 3D, all-hexahedral structured
grids. It can be controlled via command-line arguments or a configuration file.

Order of Precedence:
1. Command-line arguments (highest priority)
2. Configuration file settings
3. Built-in script defaults (lowest priority)
"""
    # --- MODIFIED: Added stretching and first cell examples to epilog ---
    prog_epilog = """
Usage Examples:
-----------------
# Run using settings from a shared configuration profile
python3 generators/grid.gen --config config/grids/coarse_square_tube_curved.cfg

# Run using a config file, but override the command and a parameter
python3 generators/grid.gen --config config/grids/coarse_square_tube_curved.cfg pipe --ncells-path 200

# Run without a config file, using command-line args and built-in defaults
python3 generators/grid.gen cpipe --orientation xz --vts cpipe_xz.vts

# Generate a cpipe grid with hyperbolic clustering near the walls
python3 generators/grid.gen cpipe --ncells-i 32 --ncells-j 32 --stretch-i 2.5 --stretch-j 2.5

# Generate a cpipe grid with specific first cell dimensions
python3 generators/grid.gen cpipe --ncells-i 32 --ncells-j 32 --first-cell-i-start 0.01 --first-cell-j-start 0.01

# Convert legacy 1D-axis grid payload to canonical PICGRID
python3 generators/grid.gen legacy1d --input legacy.grid --output legacy.picgrid --no-write-vtk
"""
    
    parser = argparse.ArgumentParser(description=prog_description, formatter_class=argparse.RawDescriptionHelpFormatter, epilog=prog_epilog)
    parser.add_argument("-c", "--config", help="Path to configuration file.", metavar="FILE")
    subparsers = parser.add_subparsers(dest='grid_type', title='Available Commands', metavar='COMMAND', help='Run "COMMAND -h" for more information.')
    
    # --- MODIFIED: Added stretch factors and first cell parameters to defaults ---
    default_map = {
        'cpipe': {
            'ncells_i': 16, 'ncells_j': 16, 'ncells_k': 100, 'side_lengths': [1.0, 1.0],
            'rc_factor': 4.0, 'straight_factor': 5.0, 'bend_angle': 90.0, 'orientation': 'xy',
            'origin': [0.0, 0.0, 0.0], 'show_stats': True, 'write_vtk': True,
            'stretch_i': 0.0, 'stretch_j': 0.0, 'stretch_k': 0.0,
            'first_cell_i_start': None, 'first_cell_i_end': None,
            'first_cell_j_start': None, 'first_cell_j_end': None,
            'first_cell_k_start': None, 'first_cell_k_end': None,
            'transforms': None,
            'length_ref': None, 'nu': None, 'velocity_ref': None,
            're_tau': None, 'u_tau': None,
            'mg_levels': None, 'periodic': None,
        },
        'pipe': {
            'ncells_phi': 24, 'ncells_r': 12, 'ncells_path': 100, 'diameter': 1.0,
            'rc_factor': 2.0, 'straight_factor': 5.0, 'bend_angle': 90.0,
            'pinhole_factor': 0.05, 'orientation': 'xy', 'origin': [0.0, 0.0, 0.0],
            'show_stats': True, 'write_vtk': True,
            'stretch_i': 0.0, 'stretch_j': 0.0, 'stretch_k': 0.0,
            'first_cell_i_start': None, 'first_cell_i_end': None,
            'first_cell_j_start': None, 'first_cell_j_end': None,
            'first_cell_k_start': None, 'first_cell_k_end': None,
            'transforms': None,
            'length_ref': None, 'nu': None, 'velocity_ref': None,
            're_tau': None, 'u_tau': None,
            'mg_levels': None, 'periodic': None,
        },
        'warp': {
            'ncells_i': 20, 'ncells_j': 20, 'ncells_k': 20, 'bounds_x': [0.0, 1.0],
            'bounds_y': [0.0, 1.0], 'bounds_z': [0.0, 1.0], 'amp_A': 0.1,
            'amp_B': 0.05, 'amp_C': 0.05, 'origin': [0.0, 0.0, 0.0],
            'show_stats': True, 'write_vtk': True,
            'stretch_i': 0.0, 'stretch_j': 0.0, 'stretch_k': 0.0,
            'first_cell_i_start': None, 'first_cell_i_end': None,
            'first_cell_j_start': None, 'first_cell_j_end': None,
            'first_cell_k_start': None, 'first_cell_k_end': None,
            'transforms': None,
            'length_ref': None, 'nu': None, 'velocity_ref': None,
            're_tau': None, 'u_tau': None,
            'mg_levels': None, 'periodic': None,
        },
        'box': {
            'ncells_i': 20, 'ncells_j': 20, 'ncells_k': 20, 'bounds_x': [0.0, 1.0],
            'bounds_y': [0.0, 1.0], 'bounds_z': [0.0, 1.0],
            'wall_j_lo': None, 'wall_j_hi': None,
            'wall_j_lo_span': None, 'wall_j_hi_span': None,
            'amp_A': 0.0, 'amp_B': 0.0, 'amp_C': 0.0,
            'origin': [0.0, 0.0, 0.0], 'show_stats': True, 'write_vtk': True,
            'stretch_i': 0.0, 'stretch_j': 0.0, 'stretch_k': 0.0,
            'first_cell_i_start': None, 'first_cell_i_end': None,
            'first_cell_j_start': None, 'first_cell_j_end': None,
            'first_cell_k_start': None, 'first_cell_k_end': None,
            'transforms': None,
            'length_ref': None, 'nu': None, 'velocity_ref': None,
            're_tau': None, 'u_tau': None,
            'mg_levels': None, 'periodic': None,
        },
        'sweep': {
            'ncells_i': 16, 'ncells_j': 16, 'ncells_k': 100,
            'cross_section': 'rectangle', 'side_lengths': [1.0, 1.0],
            'path': ['straight:len=10'], 'cross_section_scale': None,
            'origin': [0.0, 0.0, 0.0], 'show_stats': True, 'write_vtk': True,
            'stretch_i': 0.0, 'stretch_j': 0.0, 'stretch_k': 0.0,
            'first_cell_i_start': None, 'first_cell_i_end': None,
            'first_cell_j_start': None, 'first_cell_j_end': None,
            'first_cell_k_start': None, 'first_cell_k_end': None,
            'transforms': None,
            'length_ref': None, 'nu': None, 'velocity_ref': None,
            're_tau': None, 'u_tau': None,
            'mg_levels': None, 'periodic': None,
        },
        'legacy1d': {
            'show_stats': False,
            'write_vtk': False,
            'axis_columns': [0, 1, 2],
            'strict_trailing': True,
        }
    }

    def add_arg(p, *args, **kwargs):
        """!
        @brief Perform add arg.
        @param[in] p Argument passed to `add_arg()`.
        @param[in] args Command-line style argument list supplied to the function.
        @param[in] kwargs Argument passed to `add_arg()`.
        """
        p.add_argument(*args, default=argparse.SUPPRESS, **kwargs)

    parent = argparse.ArgumentParser(add_help=False)
    add_arg(parent, '--vts', type=str, help="Output filename for VTK (.vts) format.")
    add_arg(parent, '--output', type=str, help="Output filename for PICGRID format.")
    add_arg(parent, '--origin', type=float, nargs=3, metavar=('X','Y','Z'), help="Set the [x,y,z] minimum corner of the grid's bounding box.")
    add_arg(parent, '--stats-file', type=str, help="Output filename for grid quality statistics report.")
    add_arg(parent, '--mg-levels', type=int,
            help="Multigrid levels the grid must support. Each level coarsens as\n"
                 "IM -> (IM+1)/2, so L levels need node counts of 2^(L-1)*k + 1.")
    add_arg(parent, '--periodic', type=str, nargs='+', metavar='AXIS',
            choices=['i', 'j', 'k'],
            help="Logical axes that will be periodic. Their seams must join cells of\n"
                 "equal width, and they may not be combined with a rotation.")
    add_arg(parent, '--length-ref', type=float,
            help="Reference length the launcher will divide coordinates by. Reporting\n"
                 "only: grid.gen never scales coordinates itself.")
    add_arg(parent, '--nu', type=float, help="Kinematic viscosity, for wall units.")
    add_arg(parent, '--velocity-ref', type=float, help="Reference velocity, for Re.")
    add_arg(parent, '--re-tau', type=float,
            help="Target friction Reynolds number. A design target, not a measurement:\n"
                 "wall units derived from it are reported as nominal.")
    add_arg(parent, '--u-tau', type=float,
            help="Friction velocity, as an alternative to --re-tau. Needs --nu.")
    add_arg(parent, '--transforms', type=str, nargs='+', metavar='OP',
            help="Placement/similarity transforms applied after the geometry map, in\n"
                 "order. Each is 'kind:key=value,key=value' with kind one of "
                 f"{', '.join(GRID_TRANSFORM_KINDS)}. Example: "
                 "--transforms translate:dx=5 rotate:axis=z,deg=90")

    # --- NEW: Added stretch factor arguments to the parent parser ---
    add_arg(parent, '--stretch-i', type=float, help="Hyperbolic stretching factor in i-dir. 0=uniform, >1=clustered. (Default: 0.0)")
    add_arg(parent, '--stretch-j', type=float, help="Hyperbolic stretching factor in j-dir. 0=uniform, >1=clustered. (Default: 0.0)")
    add_arg(parent, '--stretch-k', type=float, help="Hyperbolic stretching factor in k-dir. 0=uniform, >1=clustered. (Default: 0.0)")

    # --- NEW: Added first cell dimension arguments to the parent parser ---
    add_arg(parent, '--first-cell-i-start', type=float, help="First cell dimension at i=0 (start).")
    add_arg(parent, '--first-cell-i-end', type=float, help="First cell dimension at i=IM-1 (end).")
    add_arg(parent, '--first-cell-j-start', type=float, help="First cell dimension at j=0 (start).")
    add_arg(parent, '--first-cell-j-end', type=float, help="First cell dimension at j=JM-1 (end).")
    add_arg(parent, '--first-cell-k-start', type=float, help="First cell dimension at k=0 (start).")
    add_arg(parent, '--first-cell-k-end', type=float, help="First cell dimension at k=KM-1 (end).")

    stats_group = parent.add_mutually_exclusive_group()
    stats_group.add_argument('--show-stats', action='store_true', dest='show_stats', default=argparse.SUPPRESS, help="Print quality stats to console.")
    stats_group.add_argument('--no-show-stats', action='store_false', dest='show_stats', default=argparse.SUPPRESS, help="Suppress printing quality stats.")
    vtk_group = parent.add_mutually_exclusive_group()
    vtk_group.add_argument('--write-vtk', action='store_true', dest='write_vtk', default=argparse.SUPPRESS, help="Write the default VTK output file.")
    vtk_group.add_argument('--no-write-vtk', action='store_false', dest='write_vtk', default=argparse.SUPPRESS, help="Disable writing the VTK output file.")

    p_cpipe = subparsers.add_parser('cpipe', help='Bent pipe with a rectangular cross-section.', parents=[parent])
    add_arg(p_cpipe, '--ncells-i', type=int, help="Cells in 1st cross-section dir.")
    add_arg(p_cpipe, '--ncells-j', type=int, help="Cells in 2nd cross-section dir.")
    add_arg(p_cpipe, '--ncells-k', type=int, help="Cells along the pipe path (streamwise).")
    add_arg(p_cpipe, '--side-lengths', type=float, nargs=2, metavar=('I', 'J'))
    add_arg(p_cpipe, '--rc-factor', type=float)
    add_arg(p_cpipe, '--straight-factor', type=float)
    add_arg(p_cpipe, '--bend-angle', type=float, help="Bend angle in degrees.")
    add_arg(p_cpipe, '--orientation', choices=['xy', 'xz'])

    p_pipe = subparsers.add_parser('pipe', help='Bent pipe with a circular cross-section (O-grid).', parents=[parent])
    add_arg(p_pipe, '--ncells-phi', type=int, help="Cells circumferentially (i-dir).")
    add_arg(p_pipe, '--ncells-r', type=int, help="Cells radially (j-dir).")
    add_arg(p_pipe, '--ncells-path', type=int, help="Cells along the pipe path (k-dir).")
    add_arg(p_pipe, '--diameter', type=float)
    add_arg(p_pipe, '--rc-factor', type=float)
    add_arg(p_pipe, '--straight-factor', type=float)
    add_arg(p_pipe, '--bend-angle', type=float, help="Bend angle in degrees.")
    add_arg(p_pipe, '--pinhole-factor', type=float)
    add_arg(p_pipe, '--orientation', choices=['xy', 'xz'])
    
    p_warp = subparsers.add_parser('warp', help='A generic warped Cartesian block.', parents=[parent])
    add_arg(p_warp, '--ncells-i',type=int)
    add_arg(p_warp, '--ncells-j',type=int)
    add_arg(p_warp, '--ncells-k',type=int)
    add_arg(p_warp, '--bounds-x',type=float,nargs=2,metavar=('MIN','MAX'))
    add_arg(p_warp, '--bounds-y',type=float,nargs=2,metavar=('MIN','MAX'))
    add_arg(p_warp, '--bounds-z',type=float,nargs=2,metavar=('MIN','MAX'))
    add_arg(p_warp, '--amp-A',type=float)
    add_arg(p_warp, '--amp-B',type=float)
    add_arg(p_warp, '--amp-C',type=float)

    p_box = subparsers.add_parser(
        'box',
        help='A Cartesian block whose bounding walls may be shaped.',
        parents=[parent],
    )
    add_arg(p_box, '--ncells-i', type=int, help="Cells along the streamwise axis.")
    add_arg(p_box, '--ncells-j', type=int, help="Cells along the wall-normal axis.")
    add_arg(p_box, '--ncells-k', type=int, help="Cells along the spanwise axis.")
    add_arg(p_box, '--bounds-x', type=float, nargs=2, metavar=('MIN', 'MAX'))
    add_arg(p_box, '--bounds-y', type=float, nargs=2, metavar=('MIN', 'MAX'))
    add_arg(p_box, '--bounds-z', type=float, nargs=2, metavar=('MIN', 'MAX'))
    add_arg(p_box, '--wall-j-lo', type=str, nargs='+', metavar='SEG',
            help="Lower-wall height field, streamwise order. Each segment is\n"
                 "'kind:key=value,...' with kind one of "
                 f"{', '.join(GRID_WALL_SEGMENT_KINDS)}, and every segment needs 'len'.\n"
                 "Lengths must sum to the x extent. Example: a backward-facing step is\n"
                 "--wall-j-lo flat:len=4,y=1 step:len=0.2,dy=-1 flat:len=15.8")
    add_arg(p_box, '--wall-j-hi', type=str, nargs='+', metavar='SEG',
            help="Upper-wall height field, same grammar as --wall-j-lo.")
    add_arg(p_box, '--wall-j-lo-span', type=str, nargs='+', metavar='SEG',
            help="Spanwise envelope scaling the lower wall's departure from its datum,\n"
                 "so a wall-attached obstacle can have finite width.")
    add_arg(p_box, '--wall-j-hi-span', type=str, nargs='+', metavar='SEG',
            help="Spanwise envelope for the upper wall.")
    add_arg(p_box, '--amp-A', type=float, help="Interior sinusoidal warp amplitude.")
    add_arg(p_box, '--amp-B', type=float, help="First boundary warp amplitude.")
    add_arg(p_box, '--amp-C', type=float, help="Second boundary warp amplitude.")

    p_sweep = subparsers.add_parser(
        'sweep',
        help='A cross-section swept along a piecewise centreline.',
        parents=[parent],
    )
    add_arg(p_sweep, '--ncells-i', type=int, help="Cells across the 1st section direction.")
    add_arg(p_sweep, '--ncells-j', type=int, help="Cells across the 2nd section direction.")
    add_arg(p_sweep, '--ncells-k', type=int, help="Cells along the path.")
    add_arg(p_sweep, '--cross-section', choices=list(GRID_CROSS_SECTIONS),
            help="Cross-section shape swept along the path.")
    add_arg(p_sweep, '--side-lengths', type=float, nargs=2, metavar=('I', 'J'),
            help="Full width across each section direction; for `circle`, the two "
                 "diameters.")
    add_arg(p_sweep, '--path', type=str, nargs='+', metavar='SEG',
            help="Centreline segments in order, each 'kind:key=value,...' with kind one\n"
                 f"of {', '.join(GRID_PATH_SEGMENT_KINDS)}. 'straight' takes len; 'arc'\n"
                 "takes radius, deg and an optional axis (default z). Example, a U-bend:\n"
                 "--path straight:len=5 arc:radius=4,deg=180 straight:len=5")
    add_arg(p_sweep, '--cross-section-scale', type=str, nargs='+', metavar='SEG',
            help="Scale field along the path, same segment grammar, datum 1.0. Turns the\n"
                 "sweep into a nozzle, diffuser or sudden expansion.")

    p_legacy = subparsers.add_parser(
        'legacy1d',
        help='Convert legacy 1D-axis grid payload to canonical PICGRID.',
    )
    add_arg(p_legacy, '--vts', type=str, help="Output filename for VTK (.vts) format.")
    add_arg(p_legacy, '--output', type=str, help="Output filename for PICGRID format.")
    add_arg(p_legacy, '--stats-file', type=str, help="Output filename for grid quality statistics report.")
    legacy_stats_group = p_legacy.add_mutually_exclusive_group()
    legacy_stats_group.add_argument(
        '--show-stats',
        action='store_true',
        dest='show_stats',
        default=argparse.SUPPRESS,
        help="Print quality stats for the first block (if available).",
    )
    legacy_stats_group.add_argument(
        '--no-show-stats',
        action='store_false',
        dest='show_stats',
        default=argparse.SUPPRESS,
        help="Suppress printing quality stats.",
    )
    legacy_vtk_group = p_legacy.add_mutually_exclusive_group()
    legacy_vtk_group.add_argument(
        '--write-vtk',
        action='store_true',
        dest='write_vtk',
        default=argparse.SUPPRESS,
        help="Write VTK output for the first block.",
    )
    legacy_vtk_group.add_argument(
        '--no-write-vtk',
        action='store_false',
        dest='write_vtk',
        default=argparse.SUPPRESS,
        help="Disable VTK output.",
    )
    add_arg(p_legacy, '--input', type=str, help='Input legacy grid path.')
    add_arg(p_legacy, '--axis-columns', type=int, nargs=3, metavar=('XCOL', 'YCOL', 'ZCOL'),
            help='Preferred source column index for X/Y/Z axis rows.')
    trailing_group = p_legacy.add_mutually_exclusive_group()
    trailing_group.add_argument(
        '--strict-trailing',
        action='store_true',
        dest='strict_trailing',
        default=argparse.SUPPRESS,
        help='Fail when extra payload rows are present after expected legacy content.',
    )
    trailing_group.add_argument(
        '--allow-trailing',
        action='store_false',
        dest='strict_trailing',
        default=argparse.SUPPRESS,
        help='Ignore trailing payload rows after expected legacy content.',
    )

    # --- Parameter precedence logic (UNCHANGED) ---
    cli_args = parser.parse_args()
    grid_type = cli_args.grid_type
    config_params = {}
    if cli_args.config:
        print(f"Reading settings from '{cli_args.config}' ---")
        config = configparser.ConfigParser(inline_comment_prefixes=('#', ';'))
        if os.path.exists(cli_args.config):
            config.read(cli_args.config)
            if not grid_type and config.sections():
                grid_type = config.sections()[0]
            if grid_type and config.has_section(grid_type):
                config_params = dict(config.items(grid_type))
        else:
            print(f"Warning: Config file '{cli_args.config}' not found.", file=sys.stderr)
    if not grid_type:
        parser.error("A grid type must be specified on the command line or as the first section in a config file.")
    params = default_map[grid_type].copy()
    active_subparser = subparsers.choices[grid_type]
    unknown: List[str] = []
    for key, value in config_params.items():
        matched = False
        for action in active_subparser._actions:
            # configparser lower-cases option names, so match case-insensitively
            # and store under the action's own dest. Without this, mixed-case
            # settings such as amp_A are read from the file and then silently
            # dropped, leaving the built-in default quietly in force.
            if action.dest.lower() != key.lower():
                continue
            matched = True
            try:
                if isinstance(action, (argparse._StoreTrueAction, argparse._StoreFalseAction)):
                    params[action.dest] = value.lower() in ['true', 'yes', '1']
                elif action.nargs in [2, 3, '+', '*']:
                    # Whitespace-separated in the file exactly as on the command line, so a
                    # variable-length list such as a transform chain reads the same in both.
                    # configparser keeps indented continuation lines, which is what lets a
                    # long list stay readable.
                    params[action.dest] = [action.type(v) for v in value.split()]
                elif action.type:
                    params[action.dest] = action.type(value)
                else:
                    params[action.dest] = value
            except Exception:
                 parser.error(f"Invalid value for '{key}' from config file: '{value}'")
            break
        if not matched:
            # A key that reaches nothing leaves the built-in default quietly in force, so
            # the file says one thing and the grid is another. As the option surface grows
            # that is the likeliest way to be misled, and it is cheap to refuse instead.
            options = sorted({
                action.dest for action in active_subparser._actions
                if action.dest not in ('help', 'grid_type')
            })
            unknown.append(
                f"config setting '{key}' is not a '{grid_type}' option, so its value "
                f"'{value}' would be ignored and the built-in default kept. "
                f"Valid '{grid_type}' settings: {', '.join(options)}."
            )
    if unknown:
        parser.error("\n  ".join([""] + unknown))
    cli_only_args = {k: v for k, v in vars(cli_args).items() if v is not None}
    params.update(cli_only_args)
    params['grid_type'] = grid_type
    args = argparse.Namespace(**params)
    
    # --- MODIFIED: Pass new stretch arguments and first cell arguments to generator functions ---
    try:
        reference = resolve_reference_quantities(
            getattr(args, 'length_ref', None), getattr(args, 'nu', None),
            getattr(args, 'velocity_ref', None), getattr(args, 're_tau', None),
            getattr(args, 'u_tau', None))
    except ValueError as exc:
        parser.error(str(exc))

    X, Y, Z = None, None, None
    stretch_factors = None
    handled_output = False
    # A malformed geometry specification is a user error, not an internal fault, so it
    # gets the same one-line report as a bad command-line argument.
    try:
        if args.grid_type == 'cpipe':
            X, Y, Z, stretch_factors = cartesian_pipe_grid(
                ncells_i=args.ncells_i, ncells_j=args.ncells_j, ncells_k=args.ncells_k,
                side_lengths=args.side_lengths, Rc_factor=args.rc_factor,
                straight_factor=args.straight_factor, bend_angle_deg=args.bend_angle,
                orientation=args.orientation, origin=args.origin,
                stretch_i=args.stretch_i, stretch_j=args.stretch_j, stretch_k=args.stretch_k,
                first_cell_i_start=args.first_cell_i_start, first_cell_i_end=args.first_cell_i_end,
                first_cell_j_start=args.first_cell_j_start, first_cell_j_end=args.first_cell_j_end,
                first_cell_k_start=args.first_cell_k_start, first_cell_k_end=args.first_cell_k_end,
                transforms=getattr(args, 'transforms', None)
            )
        elif args.grid_type == 'pipe':
            X, Y, Z, stretch_factors = bent_pipe_grid(
                ncells_phi=args.ncells_phi, ncells_r=args.ncells_r, ncells_path=args.ncells_path,
                D=args.diameter, Rc_factor=args.rc_factor, straight_factor=args.straight_factor,
                bend_angle_deg=args.bend_angle, pinhole_factor=args.pinhole_factor,
                orientation=args.orientation, origin=args.origin,
                stretch_i=args.stretch_i, stretch_j=args.stretch_j, stretch_k=args.stretch_k,
                first_cell_i_start=args.first_cell_i_start, first_cell_i_end=args.first_cell_i_end,
                first_cell_j_start=args.first_cell_j_start, first_cell_j_end=args.first_cell_j_end,
                first_cell_k_start=args.first_cell_k_start, first_cell_k_end=args.first_cell_k_end,
                transforms=getattr(args, 'transforms', None)
            )
        elif args.grid_type == 'sweep':
            X, Y, Z, stretch_factors = sweep_grid(
                ncells_i=args.ncells_i, ncells_j=args.ncells_j, ncells_k=args.ncells_k,
                cross_section=args.cross_section, side_lengths=args.side_lengths,
                path=args.path, cross_section_scale=args.cross_section_scale,
                origin=args.origin,
                stretch_i=args.stretch_i, stretch_j=args.stretch_j, stretch_k=args.stretch_k,
                first_cell_i_start=args.first_cell_i_start, first_cell_i_end=args.first_cell_i_end,
                first_cell_j_start=args.first_cell_j_start, first_cell_j_end=args.first_cell_j_end,
                first_cell_k_start=args.first_cell_k_start, first_cell_k_end=args.first_cell_k_end,
                transforms=getattr(args, 'transforms', None),
            mg_levels=args.mg_levels, periodic=args.periodic
            )
        elif args.grid_type == 'box':
            X, Y, Z, stretch_factors = box_grid(
                ncells_i=args.ncells_i, ncells_j=args.ncells_j, ncells_k=args.ncells_k,
                bounds_x=args.bounds_x, bounds_y=args.bounds_y, bounds_z=args.bounds_z,
                wall_j_lo=args.wall_j_lo, wall_j_hi=args.wall_j_hi,
                wall_j_lo_span=args.wall_j_lo_span, wall_j_hi_span=args.wall_j_hi_span,
                amp_A=args.amp_A, amp_B=args.amp_B, amp_C=args.amp_C, origin=args.origin,
                stretch_i=args.stretch_i, stretch_j=args.stretch_j, stretch_k=args.stretch_k,
                first_cell_i_start=args.first_cell_i_start, first_cell_i_end=args.first_cell_i_end,
                first_cell_j_start=args.first_cell_j_start, first_cell_j_end=args.first_cell_j_end,
                first_cell_k_start=args.first_cell_k_start, first_cell_k_end=args.first_cell_k_end,
                transforms=getattr(args, 'transforms', None),
            mg_levels=args.mg_levels, periodic=args.periodic
            )
        elif args.grid_type == 'warp':
            X, Y, Z, stretch_factors = generate_curvilinear_grid(
                ncells_i=args.ncells_i, ncells_j=args.ncells_j, ncells_k=args.ncells_k,
                x_min=args.bounds_x[0], x_max=args.bounds_x[1],
                y_min=args.bounds_y[0], y_max=args.bounds_y[1],
                z_min=args.bounds_z[0], z_max=args.bounds_z[1],
                A=args.amp_A, B=args.amp_B, C=args.amp_C, origin=args.origin,
                stretch_i=args.stretch_i, stretch_j=args.stretch_j, stretch_k=args.stretch_k,
                first_cell_i_start=args.first_cell_i_start, first_cell_i_end=args.first_cell_i_end,
                first_cell_j_start=args.first_cell_j_start, first_cell_j_end=args.first_cell_j_end,
                first_cell_k_start=args.first_cell_k_start, first_cell_k_end=args.first_cell_k_end,
                transforms=getattr(args, 'transforms', None)
            )
        elif args.grid_type == 'legacy1d':
            input_file = getattr(args, 'input', None)
            if not input_file:
                parser.error("'legacy1d' requires --input <legacy-grid-file>.")
            if not os.path.isfile(input_file):
                parser.error(f"Legacy grid input file not found: {input_file}")

            output_file = getattr(args, 'output', None)
            if not output_file:
                base, _ = os.path.splitext(input_file)
                output_file = base + ".picgrid"
                args.output = output_file

            axis_columns = tuple(int(v) for v in args.axis_columns)
            summary = convert_legacy_1d_to_picgrid(
                input_file=input_file,
                output_file=output_file,
                axis_columns=axis_columns,
                strict_trailing=bool(args.strict_trailing),
            )
            handled_output = True
            print(
                "Legacy conversion complete: "
                f"nblk={summary['nblk']}, total_nodes={summary['total_nodes']}, output='{output_file}'"
            )
            if summary.get("first_block_arrays") is not None:
                X, Y, Z = summary["first_block_arrays"]
    except ValueError as exc:
        parser.error(str(exc))

    if X is None and args.grid_type != 'legacy1d':
        print(f"Error: Grid generation failed for type '{args.grid_type}'.", file=sys.stderr)
        sys.exit(1)

    # `hasattr` is true whenever the option exists, so a cfg carrying an empty
    # `stats_file =` reached export_stats_to_file('') and reported a write failure on
    # every otherwise successful generation. Only an actual destination is a request.
    if args.show_stats or getattr(args, 'stats_file', None):
        if X is None:
            print(
                "Warning: stats output requires a structured grid array in memory; skipping stats export.",
                file=sys.stderr,
            )
        else:
            stats_data = analyze_grid_quality(X, Y, Z, stretch_factors, reference)
            if args.show_stats:
                print_stats_to_console(stats_data)
            if getattr(args, 'stats_file', None):
                export_stats_to_file(args.stats_file, stats_data)

    if hasattr(args, 'output') and not handled_output:
        export_grid_to_picgrid(args.output, X, Y, Z)    
    if args.write_vtk:
        if X is None:
            print(
                "Warning: VTK output requires a structured grid array in memory; skipping VTK export.",
                file=sys.stderr,
            )
            sys.exit(0)
        vts_filename = getattr(args, 'vts', None)
        if not vts_filename:
            if hasattr(args, 'output'):
                base, _ = os.path.splitext(args.output)
                vts_filename = base + ".vts"
            else:
                vts_filename = f"{args.grid_type}_grid_default.vts"
        export_grid_to_vts_manual(vts_filename, X, Y, Z)

if __name__ == "__main__":
    main()
