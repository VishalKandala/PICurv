#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""!
@file plot.gen
@brief Standalone renderer for normalized PICurv report plot requests.

The conductor owns run discovery and log parsing. This helper only validates
normalized series data and renders it with matplotlib.
"""

import argparse
import json
import math
import os
import sys


# Okabe-Ito-derived colors remain distinguishable for common color-vision
# deficiencies and reproduce cleanly in print. Line styles provide a second cue.
_REPORT_COLORS = (
    "#0072B2", "#D55E00", "#009E73", "#CC79A7",
    "#E69F00", "#56B4E9", "#332288", "#999999",
)
_REPORT_LINE_STYLES = ("-", "--", "-.", ":")


class MissingPlotDependencyError(RuntimeError):
    """!
    @brief Raised when an optional plotting dependency is unavailable.
    """


def _missing_module_name(*errors) -> "str | None":
    """!
    @brief Return the first missing module named by an exception chain.
    @param[in] errors Candidate import exceptions.
    @return Missing top-level module name when available.
    """
    for error in errors:
        current = error
        seen = set()
        while current is not None and id(current) not in seen:
            seen.add(id(current))
            if isinstance(current, ModuleNotFoundError) and current.name:
                return current.name.split(".", 1)[0]
            current = current.__cause__ or current.__context__
    return None


def _drop_imported_package(package_name: str):
    """!
    @brief Remove a failed or partial import package tree from sys.modules.
    @param[in] package_name Top-level package name.
    """
    prefix = package_name + "."
    for module_name in list(sys.modules):
        if module_name == package_name or module_name.startswith(prefix):
            sys.modules.pop(module_name, None)


def _prune_incompatible_python_site_paths(paths: list) -> list:
    """!
    @brief Remove site-package paths for a different Python major/minor version.
    @param[in] paths Candidate sys.path entries.
    @return Filtered path list.
    """
    current = f"python{sys.version_info[0]}.{sys.version_info[1]}"
    return [
        path
        for path in paths
        if current in str(path).lower() or ("site-packages" not in str(path) and "dist-packages" not in str(path))
    ]


def require_matplotlib_pyplot():
    """!
    @brief Import matplotlib.pyplot with compatibility-path retry.
    @return Imported matplotlib.pyplot module.
    """
    original_path = list(sys.path)
    try:
        import matplotlib.pyplot as pyplot
        return pyplot
    except Exception as exc:
        first_error = exc
        try:
            _drop_imported_package("matplotlib")
            sys.path = _prune_incompatible_python_site_paths(original_path)
            import matplotlib.pyplot as pyplot
            return pyplot
        except Exception as retry_exc:
            dependency = _missing_module_name(first_error, retry_exc) or "matplotlib"
            raise MissingPlotDependencyError(
                f"Python dependency '{dependency}' required for plotting is unavailable. Repair the active "
                f"PICurv environment with 'env -u PYTHONPATH PYTHONNOUSERSITE=1 {sys.executable} "
                f"-m pip install --no-cache-dir --force-reinstall {dependency}'. "
                f"Import errors: {first_error}; {retry_exc}"
            ) from retry_exc
        finally:
            sys.path = original_path


def read_plot_request(input_path: str) -> dict:
    """!
    @brief Read one normalized plot request from a file or stdin.
    @param[in] input_path JSON file path or `-` for stdin.
    @return Parsed request mapping.
    """
    if input_path == "-":
        return json.load(sys.stdin)
    with open(input_path, "r", encoding="utf-8") as f:
        return json.load(f)


def validate_plot_request(request: dict) -> dict:
    """!
    @brief Validate and normalize a report plot request.
    @param[in] request Candidate request mapping.
    @return Validated request mapping.
    """
    if not isinstance(request, dict):
        raise ValueError("plot request must be a JSON object")
    if request.get("schema_version") != 1:
        raise ValueError("plot request schema_version must be 1")
    plot_types = {"time_history", "iteration_history", "spectrum"}
    if request.get("plot_type") not in plot_types:
        raise ValueError(f"plot_type must be one of {sorted(plot_types)}")
    for axis in ("x", "y"):
        scale = request.get(f"{axis}_scale", "linear")
        if scale not in {"linear", "log"}:
            raise ValueError(f"{axis}_scale must be 'linear' or 'log'")
    lines = request.get("lines")
    if not isinstance(lines, list) or not lines:
        raise ValueError("plot request requires at least one line")
    for index, line in enumerate(lines):
        if not isinstance(line, dict) or not str(line.get("label", "")).strip():
            raise ValueError(f"lines[{index}] requires a non-empty label")
        points = line.get("points")
        if not isinstance(points, list) or not points:
            raise ValueError(f"lines[{index}] requires at least one point")
        for point_index, point in enumerate(points):
            if not isinstance(point, list) or len(point) != 2:
                raise ValueError(f"lines[{index}].points[{point_index}] must be [x, y]")
            if not all(
                isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
                for value in point
            ):
                raise ValueError(f"lines[{index}].points[{point_index}] must contain numeric values")
        if request.get("x_scale") == "log" and any(point[0] <= 0.0 for point in points):
            raise ValueError(f"lines[{index}] contains a non-positive x value on a log scale")
        if request.get("y_scale") == "log" and any(point[1] <= 0.0 for point in points):
            raise ValueError(f"lines[{index}] contains a non-positive y value on a log scale")
    return request


def _is_headless(plt) -> bool:
    """!
    @brief Return whether interactive plotting is unavailable.
    @param[in] plt Imported matplotlib.pyplot module.
    @return True when the current environment/backend is headless.
    """
    backend = str(plt.get_backend()).lower()
    return not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) or "agg" in backend


def _expanded_linear_limits(values: list, include_zero: bool = False) -> "tuple[float, float] | None":
    """!
    @brief Return honest, padded limits for a finite linear data range.
    @param[in] values Axis data values.
    @param[in] include_zero Include zero to avoid exaggerating positive magnitudes.
    @return Two limits, or None when no adjustment is needed.
    """
    if not values:
        return None
    lower, upper = min(values), max(values)
    if include_zero:
        lower = min(0.0, lower)
        upper = max(0.0, upper)
    span = upper - lower
    if span == 0.0:
        padding = max(abs(lower) * 0.08, 0.5 if float(lower).is_integer() else 1.0e-12)
    else:
        padding = 0.06 * span
    padded_lower = lower if include_zero and lower == 0.0 else lower - padding
    padded_upper = upper + padding
    return padded_lower, padded_upper


def _line_style(request: dict, line: dict, index: int) -> dict:
    """!
    @brief Resolve accessible report styling for one request line.
    @param[in] request Validated plot request.
    @param[in] line Current line mapping.
    @param[in] index Zero-based line index.
    @return Matplotlib line keyword mapping.
    """
    role = line.get("role")
    show_markers = bool(request.get("show_markers", True))
    point_count = len(line["points"])
    marker = "o" if show_markers and point_count <= 40 else None
    markevery = None if point_count <= 18 else max(1, point_count // 12)
    style = {
        "color": line.get("color", _REPORT_COLORS[index % len(_REPORT_COLORS)]),
        "linestyle": line.get("line_style", _REPORT_LINE_STYLES[(index // len(_REPORT_COLORS)) % len(_REPORT_LINE_STYLES)]),
        "linewidth": float(line.get("line_width", 1.8)),
        "marker": marker,
        "markersize": 4.2,
        "markeredgewidth": 0.6,
        "markevery": markevery,
        "label": line["label"],
        "alpha": 0.82 if role == "snapshot" else 1.0,
    }
    if role == "reference":
        style.update({"linewidth": 2.0, "marker": None, "alpha": 0.9})
    elif role == "latest":
        style.update({"linewidth": max(style["linewidth"], 2.35), "alpha": 1.0})
    return style


def render_plot_request(request: dict, output_override: "str | None" = None) -> str:
    """!
    @brief Render a validated report plot request.
    @param[in] request Validated normalized plot request.
    @param[in] output_override Optional explicit output path.
    @return Human-readable rendering status.
    """
    plt = require_matplotlib_pyplot()
    output_path = output_override or request.get("output_path")
    headless = _is_headless(plt)
    if not output_path and headless:
        output_path = request.get("fallback_output_path")
        if not output_path:
            raise ValueError("headless plotting requires fallback_output_path")

    plt.figure(figsize=(9.4, 5.6), facecolor="white")
    for index, line in enumerate(request["lines"]):
        x_values = [point[0] for point in line["points"]]
        y_values = [point[1] for point in line["points"]]
        plt.plot(x_values, y_values, **_line_style(request, line, index))
    plt.xlabel(request.get("x_label", "Physical time"), fontsize=11)
    plt.ylabel(request.get("y_label", request.get("series", "Value")), fontsize=11)
    title = request.get("title", request.get("series", "Simulation history"))
    subtitle = request.get("subtitle")
    plt.title(f"{title}\n{subtitle}" if subtitle else title, fontsize=13, loc="left", pad=12)
    # A spectrum is read on log-log axes, so the abscissa scale is honoured too. It
    # defaults to linear, which is what every time history wants.
    if request.get("x_scale") == "log" and hasattr(plt, "xscale"):
        plt.xscale("log")
    if request.get("y_scale") == "log":
        plt.yscale("log")
    all_y = [point[1] for line in request["lines"] for point in line["points"]]
    if request.get("y_scale", "linear") == "linear" and hasattr(plt, "ylim"):
        limits = _expanded_linear_limits(all_y, bool(request.get("include_zero_y", False)))
        if limits:
            plt.ylim(*limits)
    if request.get("x_kind") == "integer" and hasattr(plt, "locator_params"):
        all_x = [point[0] for line in request["lines"] for point in line["points"]]
        if all_x and max(all_x) - min(all_x) <= 20:
            plt.locator_params(axis="x", integer=True, nbins=10)
    if hasattr(plt, "tick_params"):
        plt.tick_params(axis="both", which="major", labelsize=9.5)
    plt.grid(True, alpha=0.24, which="major", linewidth=0.7)
    if request.get("x_scale") == "log" or request.get("y_scale") == "log":
        plt.grid(True, alpha=0.08, which="minor", linewidth=0.5)
    show_legend = request.get("show_legend")
    if show_legend is None:
        show_legend = len(request["lines"]) > 1 or request["lines"][0].get("label") != request.get("series")
    if show_legend:
        plt.legend(
            loc="upper left", bbox_to_anchor=(1.01, 1.0), borderaxespad=0.0,
            frameon=False, title=request.get("legend_title"), fontsize=9,
            title_fontsize=9.5,
        )
        plt.tight_layout(rect=(0.0, 0.0, 0.78, 1.0))
    else:
        plt.tight_layout()

    if output_path:
        output_path = os.path.abspath(output_path)
        os.makedirs(os.path.dirname(output_path), exist_ok=True)
        plt.savefig(output_path, dpi=240, bbox_inches="tight", facecolor="white")
        plt.close()
        kind = request.get("plot_type", "report").replace("_", "-")
        return f"[SUCCESS] Saved {kind} plot: {output_path}"

    plt.show()
    plt.close()
    kind = request.get("plot_type", "report").replace("_", "-")
    return f"[SUCCESS] Displayed {kind} plot: {request.get('series')}"


def build_parser() -> argparse.ArgumentParser:
    """!
    @brief Build the standalone plot.gen argument parser.
    @return Configured argument parser.
    """
    parser = argparse.ArgumentParser(description="Render a normalized PICurv report plot request.")
    parser.add_argument("--input", required=True, help="Plot-request JSON path, or '-' to read JSON from stdin.")
    parser.add_argument("--output", help="Optional output image path; suppresses interactive display.")
    return parser


def main(argv=None) -> int:
    """!
    @brief Validate a plot request and render it to the requested output or display target.
    @param[in] argv Optional argv override for tests.
    @return Process exit code.
    """
    args = build_parser().parse_args(argv)
    try:
        request = validate_plot_request(read_plot_request(args.input))
        print(render_plot_request(request, output_override=args.output))
        return 0
    except MissingPlotDependencyError as exc:
        print(f"[ERROR] plot.gen missing dependency: {exc}", file=sys.stderr)
        return 3
    except Exception as exc:
        print(f"[ERROR] plot.gen failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
