{
  "description": "Generalized invariant-contract registry. PICurv has two kinds of documented truth: CAPABILITIES (choices a user makes, governed by capability_families.json) and INVARIANTS (guarantees the system maintains). This registry covers the second kind. It exists because the storage stress test showed that a run-layout change touches no selector and would therefore pass every capability gate.",
  "schema": {
    "id": "stable contract identifier",
    "title": "human-readable name",
    "kind": "ingress | reporting | artifact_topology | file_schema | identity | units | output_grammar | lifecycle",
    "status": "enforced | tracked | planned | retired",
    "authoritative_sources": "files or symbols that define the contract",
    "extractor": "registered implementation id, or null when checked by a legacy checker",
    "checker": "command that verifies it",
    "canonical_documentation": "pages that own the narrative",
    "dependent_pages": "pages that would need review if the contract changes",
    "enforcement": "blocking | advisory | report-only"
  },
