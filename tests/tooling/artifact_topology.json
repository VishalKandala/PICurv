{
  "description": "Operational artifact topology contract for the fixed workspace-owned run tree. Physical paths are extracted from the CLI planner so documentation and storage can refer to semantic roles instead of guessing from directory names.",
  "isolation_note": "Every run is a self-contained namespaced tree. Immutable workspace assets may be materialized into run.inputs, but the run records their identities in assets.lock.json and never writes into the shared object store.",
  "isolation_models": {
    "isolated_run_tree": "Each run owns its mutable configuration, inputs, output, logs, scheduler state, and manifest.",
    "shared_content_addressed": "Immutable objects are shared by digest and only read or materialized by runs."
  },
  "artifacts": [
    {
      "id": "run.root",
      "path_rule": "<workspace>/runs/<run_id>",
      "configurable": false,
      "owner": "picurv run staging",
      "writers": ["picurv"],
      "readers": ["picurv", "simulator", "postprocessor", "storage"],
      "mutability": "append",
      "retention": "until offloaded",
      "restart_role": "identity anchor",
      "isolation_model": "isolated_run_tree",
      "namespace_key": "run_id",
      "containment": "fixed below the initialized workspace runs root",
      "destructive_operations": ["storage policy pruning", "verified storage offload"],
      "destructive_scope": "one run"
    },
    {
      "id": "run.config",
      "path_rule": "<run.root>/config",
      "configurable": false,
      "owner": "picurv",
      "writers": ["picurv"],
      "readers": ["picurv", "simulator", "postprocessor", "humans"],
      "mutability": "append revisions; active.json is atomically replaced",
      "retention": "essential",
      "restart_role": "configuration provenance",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.root",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.config.history",
      "path_rule": "<run.config>/history",
      "configurable": false,
      "owner": "picurv continuation staging",
      "writers": ["picurv"],
      "readers": ["picurv", "humans"],
      "mutability": "append one immutable revision directory per continuation",
      "retention": "essential",
      "restart_role": "records configuration evolution",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.config",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.config.active",
      "path_rule": "<run.config>/active.json",
      "configurable": false,
      "owner": "picurv",
      "writers": ["picurv"],
      "readers": ["picurv", "humans"],
      "mutability": "atomically replaced when the active revision changes",
      "retention": "essential",
      "restart_role": "selects the active configuration revision",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.config",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.post_recipes",
      "path_rule": "<run.config>/post-recipes",
      "configurable": false,
      "owner": "picurv post staging",
      "writers": ["picurv", "postprocessor"],
      "readers": ["picurv", "postprocessor", "humans"],
      "mutability": "append by stable recipe identity",
      "retention": "essential",
      "restart_role": "post-processing provenance and resume state",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.config",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.post_recipe.files",
      "path_rule": "<run.post_recipes>/<recipe>/<name>",
      "configurable": false,
      "owner": "picurv and postprocessor",
      "writers": ["picurv", "postprocessor"],
      "readers": ["picurv", "postprocessor", "humans"],
      "mutability": "recipe and state scoped",
      "retention": "essential",
      "restart_role": "recipe-specific post resume state",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.post_recipes",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.control",
      "path_rule": "<run.config>/<run_id>.control",
      "configurable": false,
      "owner": "picurv generation",
      "writers": ["picurv"],
      "readers": ["simulator"],
      "mutability": "active revision is replaced; earlier revisions are retained",
      "retention": "essential",
      "restart_role": "records the emitted PETSc options",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.config",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.config.inputs",
      "path_rule": "<run.config>/<role>.yml",
      "configurable": false,
      "owner": "picurv staging",
      "writers": ["picurv"],
      "readers": ["picurv", "humans"],
      "mutability": "initial snapshot is immutable; continuations append under history",
      "retention": "essential",
      "restart_role": "records exact structured inputs",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.config",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.inputs",
      "path_rule": "<run.root>/inputs",
      "configurable": false,
      "owner": "picurv asset materialization",
      "writers": ["picurv"],
      "readers": ["simulator", "postprocessor", "picurv"],
      "mutability": "fixed for a staged run revision",
      "retention": "essential or recoverable by asset digest",
      "restart_role": "runtime-ready inputs",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.root",
      "destructive_operations": ["storage metadata-only pruning after remote asset verification"],
      "destructive_scope": "materialized copies for one run"
    },
    {
      "id": "run.input.roles",
      "path_rule": "<run.inputs>/<role>",
      "configurable": false,
      "owner": "picurv",
      "writers": ["picurv"],
      "readers": ["simulator", "postprocessor", "picurv"],
      "mutability": "fixed for a staged run revision",
      "retention": "policy driven",
      "restart_role": "grid, initial condition, inlet profile, or restart input",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.inputs",
      "destructive_operations": ["storage policy pruning"],
      "destructive_scope": "one input role in one run"
    },
    {
      "id": "run.asset_lock",
      "path_rule": "<run.inputs>/assets.lock.yml",
      "configurable": false,
      "owner": "picurv",
      "writers": ["picurv"],
      "readers": ["picurv", "storage", "humans"],
      "mutability": "atomically replaced for the active run revision",
      "retention": "essential",
      "restart_role": "records exact immutable asset digests and runtime providers",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.inputs",
      "destructive_operations": [],
      "destructive_scope": "none"
    },
    {
      "id": "run.input.files",
      "path_rule": "<run.inputs>/<role>/<name>",
      "configurable": false,
      "owner": "picurv asset materialization",
      "writers": ["picurv"],
      "readers": ["simulator", "postprocessor", "picurv"],
      "mutability": "immutable materialization",
      "retention": "policy driven and recoverable by asset digest when archived",
      "restart_role": "runtime input payload",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.inputs",
      "destructive_operations": ["storage policy pruning"],
      "destructive_scope": "one run materialization"
    },
    {
      "id": "run.runtime_logs",
      "path_rule": "<run.root>/logs",
      "configurable": false,
      "owner": "C runtime and launch wrappers",
      "writers": ["simulator", "postprocessor", "picurv"],
      "readers": ["humans", "picurv"],
      "mutability": "append",
      "retention": "essential",
      "restart_role": "none",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.root and independently guarded before a fresh-run cleanup",
      "destructive_operations": ["fresh simulator invocation clears only this directory"],
      "destructive_scope": "logs of one run"
    },
    {
      "id": "run.runtime_logs.files",
      "path_rule": "<run.runtime_logs>/<name>",
      "configurable": false,
      "owner": "C runtime and PETSc",
      "writers": ["simulator", "postprocessor", "PETSc"],
      "readers": ["humans", "picurv"],
      "mutability": "append or replace by named diagnostic",
      "retention": "essential",
      "restart_role": "none",
      "isolation_model": "isolated_run_tree",
      "containment": "inherits run.runtime_logs",
      "destructive_operations": ["fresh-run log cleanup"],
      "destructive_scope": "logs of one run"
    },
    {
      "id": "run.scheduler",
      "path_rule": "<run.root>/scheduler",
      "configurable": false,
      "owner": "picurv and scheduler",
      "writers": ["picurv", "scheduler"],
      "readers": ["picurv", "humans"],
      "mutability": "stage scoped",
      "retention": "essential",
      "restart_role": "submission and process state",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.root",
      "destructive_operations": ["lock removal after stage completion"],
      "destructive_scope": "one stage lock"
    },
    {
      "id": "run.scheduler.files",
      "path_rule": "<run.scheduler>/<name>",
      "configurable": false,
      "owner": "picurv and scheduler",
      "writers": ["picurv", "scheduler"],
      "readers": ["picurv", "humans"],
      "mutability": "stage scoped",
      "retention": "essential",
      "restart_role": "submission metadata, wrappers, locks, and stream logs",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.scheduler",
      "destructive_operations": ["lock removal after stage completion"],
      "destructive_scope": "one stage lock"
    },
    {
      "id": "run.solver_output",
      "path_rule": "<run.root>/output",
      "configurable": false,
      "owner": "C runtime",
      "writers": ["simulator", "postprocessor"],
      "readers": ["simulator", "postprocessor", "picurv", "humans"],
      "mutability": "append",
      "retention": "policy driven",
      "restart_role": "parent of checkpoints and derived output",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.root",
      "destructive_operations": ["storage policy pruning"],
      "destructive_scope": "selected semantic components of one run"
    },
