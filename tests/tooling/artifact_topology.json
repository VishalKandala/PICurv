      "writers": ["simulator"],
      "readers": ["simulator", "postprocessor", "picurv"],
      "mutability": "append transactional step bundles",
      "retention": "policy driven; latest may be retained locally",
      "restart_role": "restart source",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.solver_output",
