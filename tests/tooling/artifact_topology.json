      "readers": ["picurv", "humans"],
      "mutability": "append by semantic family and recipe",
      "retention": "derived; policy driven",
      "restart_role": "statistics may be carried explicitly",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.solver_output",
