      "readers": ["picurv", "humans"],
      "mutability": "append by window and recipe",
      "retention": "analysis-ready policy",
      "restart_role": "may be reset or carried explicitly",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.analysis",
      "destructive_operations": ["storage policy pruning"],
      "destructive_scope": "statistics of one run"
    },
    {
      "id": "run.analysis.spectra",
      "path_rule": "<run.analysis>/spectra",
      "configurable": false,
