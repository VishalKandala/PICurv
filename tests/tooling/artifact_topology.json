      "writers": ["postprocessor", "picurv"],
      "readers": ["picurv", "humans"],
      "mutability": "append by recipe",
      "retention": "analysis-ready policy",
      "restart_role": "none",
      "isolation_model": "isolated_run_tree",
      "containment": "fixed relative to run.analysis",
